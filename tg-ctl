function log(msg: string): void {
  console.error(`[${new Date().toISOString()}] ${msg}`)
}

function readFileOrNull(path: string): string | null {
  try {
    return readFileSync(path, "utf8")
  } catch {
    return null
  }
}

// Append history records to the JSONL log, trimmed to the bound. BEST-EFFORT:
// the recall log is purely informational (like routes), so a read/write error
// must never break the inbound inject path. Shared by the poll loop's inbound
// writer; the `tg` entrypoint has the mirror for outbound.
function appendHistory(path: string, records: HistoryRecord[]): void {
  if (records.length === 0) return
  try {
    // 0o600: the log is a conversation transcript — owner-only, like the socket.
    writeFileSync(path, appendRecordsToBlob(readFileOrNull(path), records), { mode: 0o600 })
    chmodSync(path, 0o600) // enforce on a pre-existing, looser-perm file too
  } catch {
    // best-effort: never let history bookkeeping break an inject
  }
}

function fileMtimeMs(path: string): number | null {
  try {
    return statSync(path).mtimeMs
  } catch {
    return null
  }
}

function kill0(pid: number): boolean {
  try {
    process.kill(pid, 0)
    return true
  } catch {
    return false
  }
}

function api(ctx: Ctx): string {
  return `${ctx.apiBase}/bot${ctx.token}`
}

// Daemon-side Bot API call. Never throws and never exits — a failed notice
// must not take the poll loop down with it.
async function botPost(ctx: Ctx, method: string, body: unknown): Promise<Record<string, unknown> | null> {
  try {
    const resp = await fetch(`${api(ctx)}/${method}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
      signal: AbortSignal.timeout(15_000),
    })
    if (!resp.ok) {
      log(`${method} failed: ${resp.status} ${(await resp.text()).slice(0, 200)}`)
      return null
    }
    const json = (await resp.json()) as Record<string, unknown>
    return json && typeof json === "object" ? json : null
  } catch (err) {
    log(`${method} failed: ${err}`)
    return null
  }
}

async function sendMessage(ctx: Ctx, text: string, extra: Record<string, unknown> = {}): Promise<number | null> {
  const json = await botPost(ctx, "sendMessage", { chat_id: ctx.chatId, text, ...extra })
  const result = json?.result
  if (!result || typeof result !== "object") return null
  const messageId = (result as { message_id?: unknown }).message_id
  return typeof messageId === "number" ? messageId : null
}

async function answerCallbackQuery(ctx: Ctx, callbackQueryId: string, text: string): Promise<void> {
  await botPost(ctx, "answerCallbackQuery", { callback_query_id: callbackQueryId, text })
}

async function editMessageText(ctx: Ctx, messageId: number, text: string): Promise<void> {
  await botPost(ctx, "editMessageText", { chat_id: ctx.chatId, message_id: messageId, text })
}

// Publish the bot's own slash-commands to Telegram's "/" autocomplete + menu
// button (setMyCommands), so `/agent` and the rest are discoverable instead of
// blind-typed. Best-effort and idempotent: a network/API failure is logged and
// ignored — the daemon's job is routing, not the menu. The ENTIRE body is
// wrapped: botPost already swallows transport errors, but the whole publish path
// is belt-and-suspenders try/catch'd so no future regression on this side path
// can ever throw into runDaemon and abort startup. validateBotCommands guards
// the list against Telegram's constraints (the test suite enforces it too).
//
// Scope: the default (global) scope — the menu shows in every chat with the bot.
// tg-ctl is a single-user personal control bot (one TG_CHAT_ID), so global is the
// intended choice; a multi-tenant bot would scope per chat to avoid leaking the
// menu to other chats.
async function publishBotCommands(ctx: Ctx): Promise<void> {
  try {
    validateBotCommands()
    const json = await botPost(ctx, "setMyCommands", { commands: BOT_COMMANDS })
    if (json?.ok === true) log(`setMyCommands ok — published ${BOT_COMMANDS.length} commands`)
    else log("setMyCommands did not confirm ok — menu may be stale (continuing)")
  } catch (err) {
    // Unreachable on today's code (botPost is try/catch'd, validate only throws
    // on a bad list we control) — but startup must survive it regardless.
    log(`setMyCommands failed — menu not published (continuing): ${err}`)
  }
}

// Tab separator — pane_current_path may contain spaces (see discover.ts).
// #{window_name} is carried in the CORE snapshot (a fixed field BEFORE the greedy
// path) so the /agent picker can label by the user-set window name reliably
// (tg-cli#75 fix C); the previous separate window-name tmux call did NOT pass the
// UTF-8 locale env, so under launchd the tab-mangle blanked every name and the
// picker fell back to the cwd basename.
const PANE_FORMAT =
  "#{session_name}\t#{window_index}\t#{pane_id}\t#{pane_pid}\t#{pane_current_command}\t#{window_name}\t#{pane_current_path}"

// Subprocess env with a GUARANTEED UTF-8 locale. THE root cause of the "Claude Code not in tmux"
// saga: under launchd the daemon inherits NO locale (LANG/LC_* unset), and tmux then classifies the
// TAB separator in PANE_FORMAT as non-printable and ESCAPES it to `_` in its `-F` output. Every line
// then collapses to a single field, parsePaneList drops it (<7 fields), snapshot() returns ZERO
// panes, and the daemon reports "not in tmux" for every message despite live agent panes. A UTF-8
// locale makes tmux emit real tabs. It MUST be passed explicitly on the spawn — Bun.spawnSync does
// NOT pick up a runtime `process.env` mutation — so this env is handed to every discovery subprocess.
// (#44/#46 retried a symptom; the output was non-empty but mis-separated, which is why a retry could
// never fix it.)
//
// Set LC_ALL UNCONDITIONALLY. LC_ALL is the top-priority locale var, so this overrides ANY inherited
// state — including the trap where LC_ALL=C coexists with LANG=*.UTF-8 (common in cron/CI profiles):
// a "does any var look UTF-8?" check would see LANG and wrongly leave the effective C locale in place.
// Discovery output is parsed as raw bytes, so the SPECIFIC UTF-8 locale is irrelevant — only that it
// IS UTF-8. Pick one guaranteed to exist on the platform: macOS ships en_US.UTF-8 but not C.UTF-8;
// minimal Linux images often ship C.UTF-8 but not en_US.UTF-8.
const SUBPROC_ENV: Record<string, string> = (() => {
  const env = { ...process.env } as Record<string, string>
  env.LC_ALL = process.platform === "darwin" ? "en_US.UTF-8" : "C.UTF-8"
  return env
})()

// tmux absent / no server / ps failure → empty snapshot, never a crash:
// discovery then degrades to the no-agent reply path.
function snapshot(): { panes: PaneInfo[]; procs: ProcInfo[] } {
  let procs: ProcInfo[] = []
  // Retry a transient empty/failed `tmux list-panes` before accepting "no panes". panesWithRetry is
  // a no-op on the happy path (breaks on the first non-empty read) and pure/unit-tested. The env is
  // forced UTF-8 (see SUBPROC_ENV) so tmux emits real tab separators.
  const panes = panesWithRetry(
    () => {
      try {
        const tmux = Bun.spawnSync(["tmux", "list-panes", "-a", "-F", PANE_FORMAT], {
          stdout: "pipe",
          stderr: "pipe",
          env: SUBPROC_ENV,
        })
        return { exitCode: tmux.exitCode ?? 1, stdout: tmux.stdout.toString() }
      } catch {
        return null // tmux binary missing — retrying cannot help
      }
    },
    { sleep: (ms) => Bun.sleepSync(ms) },
  )
  // The ps query gets the SAME transient-empty resilience as tmux above: `ps -axo` returning an
  // empty list is impossible on a live system (system procs always exist), so an empty/failed read
  // is a launchd-runtime flake — and an empty procs list makes findAgentInPane match nothing, so
  // live agent panes report as "no agent" exactly like an empty tmux read (the gap the tmux-only
  // retry missed). Retry an exit-0-but-empty read; break on the first non-empty or a hard failure.
  for (let i = 0; i < 3; i++) {
    if (i > 0) Bun.sleepSync(120)
    try {
      const ps = Bun.spawnSync(["ps", "-axo", "pid=,ppid=,command="], { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
      if (ps.exitCode !== 0) break // ps failed hard — retrying unlikely to help
      procs = parseProcList(ps.stdout.toString())
      if (procs.length > 0) break
    } catch {
      break // ps missing — never on a supported platform
    }
  }
  return { panes, procs }
}

// Read the per-pane registration SET (tg-cli#67). Tolerates the legacy
// single-object file shape (a daemon upgraded in place keeps the live
// registration written by the previous version — see parseRegistrations).
// `livePaneIds` prunes entries whose pane is gone; pass null to skip pruning
// (no snapshot available, or a momentarily-empty/flaky one — pruning on empty
// would wipe every live session at once).
function readRegistrations(paths: CtlPaths, livePaneIds: Set<string> | null = null): Registration[] {
  let raw: string | null
  try {
    raw = readFileSync(paths.registration, "utf8")
  } catch {
    return []
  }
  return pruneRegistrations(parseRegistrations(raw), livePaneIds)
}

// Durably PRUNE dead-pane entries from the on-disk store (review finding): the
// daemon reads-and-prunes in memory every poll, but without writing the pruned
// set back, dead entries accumulate forever — and upsertRegistration's cap
// evicts by insertion order, so 100 piled-up dead entries would eventually evict
// a still-LIVE session and silently drop its questions (the exact failure this
// feature fights). So when discovery sees the store shrink under a TRUSTWORTHY
// live-pane set, persist the smaller set. Race-safe: re-read + re-prune INSIDE
// the registration lock, so a `tg start` that upserted between the poll read and
// here is not clobbered. Best-effort and off the hot path — never throws, and is
// skipped entirely on a flaky/empty snapshot (livePaneIds === null).
function pruneRegistrationsOnDisk(paths: CtlPaths, livePaneIds: Set<string> | null): void {
  if (livePaneIds === null) return
  try {
    withRoutesLock(
      fsRoutesLockIo(`${paths.registration}.lock`),
      () => {
        let raw: string | null
        try {
          raw = readFileSync(paths.registration, "utf8")
        } catch {
          return
        }
        const current = parseRegistrations(raw)
        const pruned = pruneRegistrations(current, livePaneIds)
        if (pruned.length !== current.length) {
          writeFileSync(paths.registration, serializeRegistrations(pruned))
        }
      },
      { onContended: "skip" }, // a live writer holds the lock — let it; we prune next poll
    )
  } catch {
    // best-effort prune — never break the poll loop
  }
}

// Fresh discovery on every call — the registration file may have been
// rewritten by a newer `tg`/`tg-ctl start` since the last poll.
// An explicit `tg-ctl start --session X` (stored in the registration) outranks
// config.yaml's control.session: it is the fresher, more specific intent, and
// the auto-start path never sets it (tg passes only --pane/--cwd).
// Rate-limit the no-agent diagnostic so the per-poll idle check can't spam the log.
let lastNoAgentLogMs = 0
function discoverTarget(ctx: Ctx): DiscoverResult {
  const { panes, procs } = snapshot()
  // Prune dead-pane entries against the live snapshot, but ONLY when the snapshot
  // actually has panes — an empty/flaky read must not wipe every registration
  // (panesWithRetry already retried the transient empty case).
  const livePaneIds = panes.length > 0 ? new Set(panes.map((p) => p.paneId)) : null
  const regs = readRegistrations(ctx.paths, livePaneIds)
  // Persist the prune so dead-pane entries can't accumulate to the cap and evict
  // a live session (review finding). Off the hot path, lock-guarded, no-op when
  // nothing was pruned or the snapshot is untrustworthy.
  pruneRegistrationsOnDisk(ctx.paths, livePaneIds)
  // An explicit `tg-ctl start --session X` (the fresher, more specific intent)
  // outranks config.yaml's control.session; the auto-start path never sets it.
  const sessionPin = regs.find((r) => r.sessionName)?.sessionName ?? ctx.cfg.session
  const result = pickTargetPaneFromSet(panes, procs, regs, sessionPin)
  // OBSERVABILITY: a "no-agent" result is what produces the misleading "Claude Code not in tmux"
  // reply. It has been an UNREPRODUCIBLE intermittent in the launchd runtime, so log the snapshot
  // shape on it — the next occurrence then shows the REAL cause (tmux-empty vs ps-empty vs
  // agent-match-fail vs a stale registration) instead of failing silently. Rate-limited to ≤1/10s.
  if (!result.ok && result.reason === "no-agent") {
    const now = Date.now()
    if (now - lastNoAgentLogMs > 10_000) {
      lastNoAgentLogMs = now
      const agentPanes = panes.filter((p) => findAgentInPane(p, procs)).length
      const regSummary = regs.length > 0 ? regs.map((r) => `${r.paneId ?? "?"}@${r.cwd ?? "?"}`).join(",") : "none"
      log(
        `no-agent reply: panes=${panes.length} procs=${procs.length} agent-panes=${agentPanes} ` +
          `regs=${regs.length} reg=${regSummary}`,
      )
    }
  }
  return result
}

// All tmux panes that host an agent, as /agent selection candidates (item 1).
// The window name comes from the CORE snapshot's #{window_name} field (tg-cli#75
// fix C) — NOT a separate tmux call: that call skipped the UTF-8 locale env, so
// under launchd the tab-mangle blanked every name and the picker fell back to the
// cwd basename ("hyperide · claude" instead of "ext · claude"). A pane with no
// usable name (empty / a bare default) is detected downstream (isBareWindowName)
// and the label leans on the cwd basename there; here we fall back to the session
// name only when the snapshot carried no window name at all.
function listAgentCandidates(): AgentCandidate[] {
  const { panes, procs } = snapshot()
  const out: AgentCandidate[] = []
  for (const pane of panes) {
    const found = findAgentInPane(pane, procs)
    if (!found) continue
    out.push({
      paneId: pane.paneId,
      sessionName: pane.sessionName,
      windowIndex: pane.windowIndex,
      windowName: pane.windowName || pane.sessionName,
      agent: found.agent,
      // cwd — the picker derives a distinct project-dir label from its basename
      // when window names collide or are bare defaults (the "4 · claude" ×3 bug).
      panePath: pane.panePath,
    })
  }
  // A pane id is unique per tmux server; dedupe guards a merged/flaky snapshot.
  return dedupeCandidates(out)
}

// Execute an InjectStep plan. verify-pane re-runs discovery on a CURRENT
// snapshot — the agent may have exited between picking the target and typing
// into it, and injecting into a bare shell would EXECUTE the text (spec §5.2).
async function executeInjectSteps(steps: InjectStep[]): Promise<{ ok: true } | { ok: false; error: string }> {
  for (const step of steps) {
    if (step.kind === "verify-pane") {
      const { panes, procs } = snapshot()
      const pane = panes.find((p) => p.paneId === step.paneId)
      if (!pane || findAgentInPane(pane, procs) === null) {
        return { ok: false, error: `pane ${step.paneId} no longer hosts an agent — message not injected` }
      }
    } else if (step.kind === "tmux") {
      const proc = Bun.spawnSync(step.argv, {
        stdin: step.stdin !== undefined ? new TextEncoder().encode(step.stdin) : undefined,
        stdout: "ignore",
        stderr: "pipe",
      })
      if (proc.exitCode !== 0) {
        return { ok: false, error: `${step.argv.join(" ")} failed: ${proc.stderr.toString().trim()}` }
      }
    } else {
      await Bun.sleep(step.ms)
    }
  }
  return { ok: true }
}

// --- voice transcription (inbound STT) ---

// Configured AND the on-disk artefacts still exist. The config gate
// (isVoiceConfigured) is cheap; this adds the filesystem check the step function
// can't do (it is pure). A deleted model/binary falls back to onboarding instead
// of downloading the note and failing deep inside the runner.
function voiceReady(ctx: Ctx): boolean {
  if (!isVoiceConfigured(ctx.voice)) return false
  if (!existsSync(ctx.voice.binPath)) return false
  // whisper.cpp model is always a path → must exist. faster-whisper model is
  // EITHER a bare size token ('large-v3' — downloaded on demand, no path check)
  // OR a local CT2 directory path; a path-shaped value (contains a slash) must
  // exist on disk, else a stale/moved model would pass the gate and fail in
  // Python after the note was already downloaded.
  if (ctx.voice.runner === "whisper.cpp") {
    if (!existsSync(ctx.voice.modelPath)) return false
  } else if (ctx.voice.modelPath.includes("/")) {
    if (!existsSync(ctx.voice.modelPath)) return false
  }
  return true
}

// Spawn a binary ASYNCHRONOUSLY (Bun.spawn, not spawnSync) with a timeout +
// pipes, NEVER throwing. Async is the key: ffmpeg/whisper can take many seconds,
// and spawnSync would BLOCK the daemon's single event loop — freezing the
// Telegram poll loop AND the Unix hook server (q→buttons) until the child exits.
// `await proc.exited` yields the loop so hooks and other control messages keep
// flowing during a long transcription. The timeout kills the child (and so the
// awaited promise resolves) instead of wedging. A missing executable makes
// Bun.spawn throw ENOENT, which — uncaught — would bubble to the poll loop AFTER
// the offset was persisted and silently lose the note; caught here → exit 127.
async function spawnGuarded(
  argv: string[],
  timeoutMs: number,
): Promise<{ exitCode: number; stdout: string; stderr: string }> {
  let child: ReturnType<typeof Bun.spawn> | undefined
  try {
    child = Bun.spawn(argv, { stdin: "ignore", stdout: "pipe", stderr: "pipe" })
    const proc = child
    let timedOut = false
    const timer = setTimeout(() => {
      timedOut = true
      proc.kill("SIGKILL")
    }, timeoutMs)
    try {
      const [stdout, stderr] = await Promise.all([
        new Response(proc.stdout).text(),
        new Response(proc.stderr).text(),
      ])
      await proc.exited
      if (timedOut) return { exitCode: 124, stdout, stderr: `${stderr}\ntimed out after ${timeoutMs}ms` }
      return { exitCode: proc.exitCode ?? 1, stdout, stderr }
    } finally {
      clearTimeout(timer)
    }
  } catch (err) {
    return { exitCode: 127, stdout: "", stderr: `spawn ${argv[0]} failed: ${err}` }
  }
}

// Spawn ffmpeg (OGG→WAV 16k mono) then the configured Whisper, returning the
// cleaned transcript or null on failure. Both spawns are ASYNC (event loop stays
// free for hooks/poll during a long transcription), timeout-guarded so a stuck
// binary can't wedge the loop, and exception-guarded so a MISSING binary returns
// null (not an uncaught throw). The WAV is written next to the OGG.
async function runTranscription(ctx: Ctx, oggPath: string): Promise<string | null> {
  const wavPath = oggPath.replace(/\.[^.]+$/, "") + ".wav"
  const ff = await spawnGuarded(buildFfmpegArgv(oggPath, wavPath), 60_000)
  if (ff.exitCode !== 0 || !existsSync(wavPath)) {
    log(`ffmpeg failed: ${ff.stderr.trim()}`)
    return null
  }

  const argv =
    ctx.voice.runner === "whisper.cpp"
      ? buildWhisperCppArgv(ctx.voice, wavPath)
      : buildFasterWhisperArgv(ctx.voice.binPath, fasterWhisperScriptPath(ctx), ctx.voice, wavPath)

  const proc = await spawnGuarded(argv, 300_000)
  try {
    unlinkSync(wavPath)
  } catch {
    // best-effort cleanup
  }
  if (proc.exitCode !== 0) {
    log(`whisper failed (${ctx.voice.runner}): ${proc.stderr.trim()}`)
    return null
  }
  return cleanTranscript(proc.stdout)
}

// The faster-whisper runner script: the configured project's own transcriber
// when it ships one (my_faster_whisper.py / transcribe.py), else a generated
// fallback written into the config dir. `main.py` is intentionally NOT trusted
// as a transcriber — uv-init projects ship a "Hello world" main.py that would
// silently produce no text. Resolved at transcription time (not stored) so a
// moved project is tolerated. The fallback is written once and reused.
function fasterWhisperScriptPath(ctx: Ctx): string {
  // binPath is <project>/.venv/bin/python → project root is three dirs up.
  const projectRoot = resolve(ctx.voice.binPath, "..", "..", "..")
  for (const name of ["my_faster_whisper.py", "transcribe.py"]) {
    const candidate = join(projectRoot, name)
    if (existsSync(candidate)) return candidate
  }
  // No project transcriber → write (once) the self-contained fallback.
  const fallback = join(ctx.configDir, "tg-faster-whisper.py")
  if (!existsSync(fallback)) {
    try {
      mkdirSync(ctx.configDir, { recursive: true })
      writeFileSync(fallback, FASTER_WHISPER_FALLBACK_SCRIPT)
    } catch (err) {
      log(`faster-whisper fallback script write failed: ${err}`)
    }
  }
  return fallback
}

// Persist the resolved voice config into <configDir>/config.yaml, replacing any
// existing `voice:` block (or appending one). No secrets here — only
// binary/model paths + language. The config dir is created first (a fresh
// machine running `tg voice setup` before anything else has no ~/.config/tg-cli
// yet). Returns whether the write landed so the caller can avoid claiming
// "configured" on a swallowed ENOENT.
function persistVoiceConfigToDir(configDir: string, cfg: VoiceConfig): boolean {
  try {
    mkdirSync(configDir, { recursive: true })
    const path = join(configDir, "config.yaml")
    const existing = readFileOrNull(path) ?? ""
    writeFileSync(path, upsertVoiceBlock(existing, cfg))
    return true
  } catch (err) {
    log(`voice config persist failed: ${err}`)
    return false
  }
}

// `tg-ctl voice-setup` (invoked by `tg voice setup`): probe the host, decide,
// persist when ready, and print the human guidance to stdout so the CLI relays
// it. Never sends to Telegram — this is the interactive local path. Takes only
// what it needs (no bot token / chatId — the gate is bypassed for this command).
// Returns true on success (config written, or guidance shown for a not-ready
// host), false ONLY when a ready install could not be persisted — the caller
// exits non-zero in that case so scripts/agents don't mistake a failed write for
// a successful setup.
function runVoiceSetup(args: { configDir: string; home: string; language: string }): boolean {
  const verdict = decideOnboarding(probeWhisper(args.home), args.language)
  if (verdict.kind === "ready") {
    if (!persistVoiceConfigToDir(args.configDir, verdict.cfg)) {
      console.error(
        `Found a local Whisper (${verdict.cfg.runner}, ${verdict.cfg.modelPath}) but could not write ` +
          `${join(args.configDir, "config.yaml")}. Fix the permissions and re-run \`tg voice setup\`.`,
      )
      return false
    }
  }
  // This is the CLI path (`tg voice setup`): colorize the ✓/○ status glyph for a
  // terminal (green=configured, yellow=pending), and never when piped/NO_COLOR.
  // The DAEMON path (an unconfigured voice note) sends onboardingMessage to
  // Telegram uncolored — it builds the message directly and never calls this.
  console.log(colorizeVoiceStatus(onboardingMessage(verdict), shouldColorize()))
  return true
}

// Shared by `tg-ctl status` (CLI) and the /status command (TG reply). Works
// with no daemon running — everything is read from files + live discovery.
function composeStatus(ctx: Ctx): string {
  const pid = readPidFile(readFileOrNull(ctx.paths.pid))
  const alive = pidStatus(pid, kill0)
  const lines: string[] = [
    alive === "running"
      ? `tg-ctl: running (pid ${pid}) — bot ${ctx.botId}`
      : alive === "stale"
        ? `tg-ctl: not running (stale pidfile, pid ${pid}) — bot ${ctx.botId}`
        : `tg-ctl: not running — bot ${ctx.botId}`,
  ]
  // Show every LIVE registered session (the per-pane set), not just one — a
  // multi-session operator must SEE that all their panes are registered to
  // forward. Prune against the live snapshot so closed panes don't show as ghosts
  // (review finding); a flaky/empty snapshot skips pruning (shows all, fail-safe).
  const statusPanes = snapshot().panes
  const statusLive = statusPanes.length > 0 ? new Set(statusPanes.map((p) => p.paneId)) : null
  const regs = readRegistrations(ctx.paths, statusLive)
  if (regs.length === 0) {
    lines.push("registrations: none")
  } else {
    lines.push(`registrations: ${regs.length}`)
    for (const reg of regs) {
      lines.push(
        `  - pane ${reg.paneId ?? "?"}, cwd ${reg.cwd ?? "?"}` +
          (reg.sessionName ? `, session ${reg.sessionName}` : ""),
      )
    }
  }
  const found = discoverTarget(ctx)
  lines.push(
    found.ok
      ? `target: ${found.target.agent} in ${found.target.pane.sessionName}:${found.target.pane.windowIndex} ` +
          `${found.target.pane.paneId}` +
          (found.target.agentPid !== undefined ? ` (pid ${found.target.agentPid})` : "")
      : found.reason === "ambiguous"
        ? `target: ambiguous —\n${formatCandidates(found.candidates)}`
        : "target: no agent pane found",
  )
  const offsetMtime = fileMtimeMs(ctx.paths.offset)
  lines.push(
    offsetMtime === null
      ? "offset: none"
      : `offset: ${readOffset(readFileOrNull(ctx.paths.offset))} ` +
          `(file age ${Math.round((Date.now() - offsetMtime) / 1000)}s)`,
  )
  // Guide the user when q→buttons isn't wired (the hook is what forwards an
  // agent's question to Telegram — without it the feature is silently dead).
  const hooksRaw = readFileOrNull(join(ctx.home, ".claude", "settings.json"))
  let hooksOk = false
  if (hooksRaw) {
    try {
      hooksOk = claudeHooksInstalled(JSON.parse(hooksRaw), "tg-ctl ask")
    } catch {}
  }
  lines.push(
    hooksOk
      ? "q→buttons hooks: installed (Claude Code)"
      : "q→buttons hooks: NOT installed — run `tg-ctl install-hooks`",
  )
  // Autostart (the shared service-management lifecycle): an installed unit means the daemon
  // comes back at login. Mirrors the q→buttons line — installed reports the kind/label, absent
  // gets a hint. On the no-op fallback (no launchd/systemd) there's no unit to find.
  const env = autostartEnv(ctx)
  const kind = autostartKind(env)
  lines.push(
    kind === "none"
      ? "autostart: not supported on this OS — `tg-ctl start` runs now but won't survive reboot"
      : autostartUnitInstalled(env)
        ? `autostart: enabled (${kind}, ${autostartUnitLabel(kind)})`
        : "autostart: NOT enabled — run `tg-ctl enable` to start at login",
  )
  return lines.join("\n")
}

// Idempotently install the q→buttons agent-question hooks into Claude Code's
// user settings (backing the file up first), then print guidance for the other
// harnesses. Pure JSON merge lives in features/tg-ctl/hook-install.ts.
function installHooks(home: string): void {
  const settingsPath = join(home, ".claude", "settings.json")
  const command = "tg-ctl ask"
  const raw = readFileOrNull(settingsPath)
  let existing: Record<string, unknown> = {}
  if (raw) {
    try {
      const parsed = JSON.parse(raw)
      if (parsed && typeof parsed === "object") existing = parsed as Record<string, unknown>
    } catch {
      console.error(`tg-ctl: ${settingsPath} is not valid JSON — fix or move it aside, then re-run`)
      process.exit(1)
    }
  }
  const { settings, changed } = withClaudeHooks(existing, command)
  if (!changed) {
    console.log("tg-ctl: Claude Code q→buttons hooks already installed — nothing to do.")
  } else {
    if (raw) {
      try {
        writeFileSync(`${settingsPath}.bak`, raw)
      } catch {}
    }
    mkdirSync(join(home, ".claude"), { recursive: true })
    writeFileSync(settingsPath, `${JSON.stringify(settings, null, 2)}\n`)
    console.log(`tg-ctl: installed Claude Code q→buttons hooks → ${settingsPath}` + (raw ? ` (backup: ${settingsPath}.bak)` : ""))
  }
  console.log("")
  console.log("Codex: add a PermissionRequest hook running `tg-ctl ask --agent codex`, then trust it via /hooks (manual, first run).")
  console.log("opencode: native — the bot subscribes to question/permission SSE events; no hook file needed.")
  console.log("Restart any running agent session so it loads the new hooks.")
}

// --- start: registration snapshot + detached daemon spawn, then exit ---

function startLauncher(ctx: Ctx, flags: StartFlags): void {
  mkdirSync(ctx.configDir, { recursive: true })
  // UPSERT this session's entry into the per-pane registration SET (tg-cli#67),
  // keyed by paneId — instead of OVERWRITING one global slot. A `tg` send from
  // any OTHER live session no longer clobbers this session's registration, so
  // every concurrently-registered session's questions keep forwarding. Written
  // synchronously EVEN IF the daemon already runs — a fresh `tg` call re-targets
  // a long-lived daemon at the current pane (its own entry only).
  const reg: Registration = { registeredAt: Math.floor(Date.now() / 1000) }
  if (flags.paneId) reg.paneId = flags.paneId
  if (flags.cwd) reg.cwd = flags.cwd
  if (flags.session) reg.sessionName = flags.session
  // Serialize the read-modify-write across concurrent `tg start`s (two sessions
  // racing the upsert would last-writer-wins-clobber each other's entry — the
  // very lost-update the routes lock was built for). Same O_EXCL lockfile +
  // PID-liveness break; onContended:'skip' loses only THIS start's bookkeeping,
  // never another session's entry. Best-effort: a write failure must never block
  // the daemon launch below, so the whole RMW is swallowed.
  try {
    withRoutesLock(
      fsRoutesLockIo(`${ctx.paths.registration}.lock`),
      () => {
        let raw: string | null
        try {
          raw = readFileSync(ctx.paths.registration, "utf8")
        } catch {
          raw = null
        }
        writeFileSync(
          ctx.paths.registration,
          serializeRegistrations(upsertRegistration(parseRegistrations(raw), reg)),
        )
      },
      { onContended: "skip" },
    )
  } catch {
    // best-effort registration bookkeeping — never block the daemon launch
  }

  // No lock, no pipes (see header). The daemon flocks first and exits 0 if
  // another instance holds the bot, so double-starts are a cheap no-op.
  const logFd = openSync(ctx.paths.log, "a")
  const proc = Bun.spawn([process.execPath, import.meta.path, "run"], {
    detached: true,
    stdio: ["ignore", logFd, logFd],
  })
  proc.unref()
  closeSync(logFd) // the child holds its own dup
  console.log(`tg-ctl: daemon launch requested (bot ${ctx.botId}) — log: ${ctx.paths.log}`)
  // Hint at autostart unless it's already installed, so a one-shot `start` doesn't silently die
  // at the next reboot (the shared service-management contract: start HINTS at enable). Skipped
  // on the no-op fallback OS, where there's nothing to enable.
  const env = autostartEnv(ctx)
  if (autostartKind(env) !== "none" && !autostartUnitInstalled(env)) {
    console.log("tg-ctl: not set to start at login — run `tg-ctl enable` to survive reboots.")
  }
}

// --- stop / status ---

function stopDaemon(ctx: Ctx): void {
  const pid = readPidFile(readFileOrNull(ctx.paths.pid))
  const alive = pidStatus(pid, kill0)
  if (alive === "absent") {
    console.log("tg-ctl: not running")
    return
  }
  if (alive === "stale") {
    try {
      unlinkSync(ctx.paths.pid)
    } catch {}
    console.log(`tg-ctl: not running (cleaned stale pidfile, pid ${pid})`)
    return
  }
  try {
    process.kill(pid!, "SIGTERM")
  } catch (err) {
    console.error(`tg-ctl: SIGTERM failed for pid ${pid}: ${err}`)
    process.exit(1)
  }
  // Brief wait so `stop && status` doesn't race the dying daemon.
  for (let i = 0; i < 20 && kill0(pid!); i++) Bun.sleepSync(100)
  try {
    unlinkSync(ctx.paths.pid)
  } catch {}
  console.log(kill0(pid!) ? `tg-ctl: SIGTERM sent (pid ${pid}, still exiting)` : `tg-ctl: stopped (pid ${pid})`)
}

// --- enable / disable: OS autostart self-registration (the agenttools_service contract) ---

// Exit code for an autostart enable/disable that failed to install/remove the OS unit (the OS
// control command returned nonzero, or the unit file could not be written/removed). Mirrors the
// agenttools_service contract's exit-code 4 for "autostart enable/disable failed", so a script
// can branch on "the service is up but autostart is NOT live".
const EXIT_AUTOSTART_FAILED = 4

// Resolve the path the autostart unit should launch. launchd/systemd run the agent with a
// minimal PATH, so argv MUST be absolute. The deployed binary is the ~/.files/bin/tg-ctl symlink
// on PATH; fall back to this script's own path when it isn't installed (e.g. a worktree run) so
// `enable` from a dev checkout still launches the right file.
function resolveDeployedBin(home: string): string {
  const deployed = join(home, ".files", "bin", "tg-ctl")
  return existsSync(deployed) ? deployed : import.meta.path
}

// True when `systemctl --user` is usable on this Linux host. Cheap probe, never throws. macOS
// never calls this (autostartKind short-circuits to launchd before hasSystemd is read).
function hasUserSystemd(): boolean {
  try {
    const r = Bun.spawnSync(["systemctl", "--user", "--version"], { stdout: "ignore", stderr: "ignore" })
    return r.exitCode === 0
  } catch {
    return false
  }
}

function autostartEnv(ctx: Ctx): AutostartEnv {
  return {
    platform: process.platform,
    home: ctx.home,
    binPath: resolveDeployedBin(ctx.home),
    bunPath: process.execPath,
    logPath: ctx.paths.log,
    // The resolved config dir, so a non-default `TG_CTL_CONFIG_DIR=/x tg-ctl enable` pins it into
    // the unit (the OS launches the daemon with a minimal env that wouldn't carry it otherwise).
    configDir: ctx.configDir,
    xdgConfigHome: process.env.XDG_CONFIG_HOME ?? "",
    hasSystemd: process.platform === "linux" ? hasUserSystemd() : false,
  }
}

// The OS unit label/name for a status/enable message (the lib's launchd Label / systemd unit
// name). Defined only for the kinds that HAVE a unit; "none" (the no-op fallback) installs no
// unit, so it has no label and callers must not ask — guarded explicitly so the signature can't
// silently mislabel a fallback as launchd.
function autostartUnitLabel(kind: "launchd" | "systemd"): string {
  return kind === "systemd" ? `${SYSTEMD_UNIT}.service` : LAUNCHD_LABEL
}

// Is the launchd/systemd unit file already on disk for tg-ctl? Cheap existence check (no plist/
// unit body rendered); on the no-op fallback (no unit file) this returns false.
function autostartUnitInstalled(env: AutostartEnv): boolean {
  const path = autostartUnitPath(env)
  return path !== undefined && existsSync(path)
}

// Run one plan command. Returns true on success. An `optional` command that fails is treated as
// success (e.g. `launchctl unload` when nothing was loaded yet). stderr is surfaced on a hard
// failure so the user sees the launchctl/systemctl error.
function runAutostartCommand(cmd: AutostartCommand): boolean {
  try {
    const r = Bun.spawnSync(cmd.argv, { stdout: "ignore", stderr: "pipe" })
    if (r.exitCode === 0) return true
    if (cmd.optional) return true
    const stderr = r.stderr ? new TextDecoder().decode(r.stderr).trim() : ""
    console.error(`tg-ctl: ${cmd.describe} failed (${cmd.argv.join(" ")}): exit ${r.exitCode}${stderr ? ` — ${stderr}` : ""}`)
    return false
  } catch (err) {
    if (cmd.optional) return true
    console.error(`tg-ctl: ${cmd.describe} failed to spawn (${cmd.argv.join(" ")}): ${err}`)
    return false
  }
}

// `tg-ctl enable [--dry-run]` — install OS autostart AND start now. Mirrors the lib's
// ServiceManager.enable single-owner contract:
//   - launchd/systemd OWN the process (RunAtLoad / enable --now), so we stop any background
//     (pidfile) instance first to avoid two daemons fighting over the bot, then install the unit;
//     the activating command's exit code decides whether autostart is actually live.
//   - if the OS control command FAILS (sandbox / missing binary), OR there's no supported OS
//     autostart at all (the 'none' fallback), we fall back to a plain background `start` so the
//     service is still up now, and report that it will NOT survive reboot (enabled=false).
// Idempotent: re-running re-writes the same unit and reloads it. `--dry-run` prints the plan
// (unit path + launchctl/systemctl commands) and touches nothing — the e2e test uses it so it
// never loads a real LaunchAgent. Returns the process exit code.
function enableAutostart(ctx: Ctx, dryRun: boolean): number {
  const env = autostartEnv(ctx)
  const plan = buildEnablePlan(env)
  if (dryRun) {
    console.log(`tg-ctl: [dry-run] autostart kind: ${plan.kind}` + (plan.kind !== "none" ? `, ${autostartUnitLabel(plan.kind)}` : ""))
    if (plan.kind === "none") {
      console.log("tg-ctl: [dry-run] no supported OS autostart — would `tg-ctl start` now (no reboot survival)")
    }
    if (plan.file) console.log(`tg-ctl: [dry-run] would write ${plan.file.path}`)
    for (const cmd of plan.commands) console.log(`tg-ctl: [dry-run] would run: ${cmd.argv.join(" ")}`)
    return 0
  }

  // No supported OS autostart: just background-start now (the lib's NoopAutostartBackend path).
  if (plan.kind === "none") {
    startLauncher(ctx, {})
    console.error("tg-ctl: autostart is not supported on this OS — started now, but it will NOT survive reboot.")
    return 0
  }

  // The OS is about to launch its own copy. Stop any background (pidfile) instance first so we
  // don't end up with two processes on the same bot — the no-double-start invariant.
  stopDaemon(ctx)

  if (plan.file) {
    try {
      mkdirSync(dirname(plan.file.path), { recursive: true })
      writeFileSync(plan.file.path, plan.file.content, { mode: plan.file.mode })
    } catch (err) {
      console.error(`tg-ctl: writing ${plan.file.path} failed: ${err}`)
      return EXIT_AUTOSTART_FAILED
    }
  }
  // Run all commands; the LAST one is the activating one (`launchctl load` / `enable --now`)
  // whose success means autostart is live (mirrors the lib gating `enabled` on its exit code).
  let activated = true
  for (const cmd of plan.commands) {
    if (!runAutostartCommand(cmd)) activated = false
  }
  if (!activated) {
    // The unit file is on disk but the OS control command failed — autostart is NOT live. Fall
    // back to a background start so the service is at least up now, and report enabled=false.
    console.error(`tg-ctl: ${plan.kind} autostart command failed — falling back to a one-shot start (will NOT survive reboot).`)
    startLauncher(ctx, {})
    return EXIT_AUTOSTART_FAILED
  }
  // Past the kind === "none" early return, a launchd/systemd plan ALWAYS carries a file; narrow
  // explicitly so the success message doesn't lean on a non-null assertion.
  const where = plan.file ? ` at ${plan.file.path}` : ""
  console.log(
    `tg-ctl: autostart enabled — ${plan.kind} (${autostartUnitLabel(plan.kind)})${where}. ` +
      "The daemon starts at login and is running now.",
  )
  return 0
}

// `tg-ctl disable` — remove OS autostart AND stop the running daemon. Mirrors the lib's
// ServiceManager.disable: run the deactivating command (unload / disable --now) and only remove
// the unit file if it succeeded — a still-loaded unit's file is left in place rather than
// orphaning the live OS process. Then stop any background instance too. Idempotent: a missing
// unit is a no-op, not an error. Returns the process exit code (4 if the OS deactivate failed).
function disableAutostart(ctx: Ctx): number {
  const env = autostartEnv(ctx)
  const plan = buildDisablePlan(env)
  let removeFailed = false
  if (plan.filePath && existsSync(plan.filePath)) {
    // The first command is the deactivator (unload / disable --now); it gates file removal.
    const [deactivateCmd, ...postCmds] = plan.commands
    const ok = deactivateCmd ? runAutostartCommand(deactivateCmd) : true
    if (ok) {
      try {
        unlinkSync(plan.filePath)
      } catch (err) {
        console.error(`tg-ctl: removing ${plan.filePath} failed: ${err}`)
        removeFailed = true
      }
      for (const cmd of postCmds) runAutostartCommand(cmd)
    } else {
      // Deactivate failed — leave the file so `status` doesn't lie about the unit being gone.
      console.error(`tg-ctl: ${plan.kind} deactivate failed — leaving the unit file in place (the OS may still be running it).`)
      removeFailed = true
    }
  }
  // disable also stops the manager-spawned (background) instance. On launchd/systemd the unload/
  // disable above already stopped the OS-owned copy; this is the catch-all for a pidfile instance.
  stopDaemon(ctx)
  if (removeFailed) return EXIT_AUTOSTART_FAILED
  // On the 'none' fallback there was never an OS unit — say what actually happened (stopped the
  // background instance) rather than the misleading "autostart disabled (none)".
  console.log(
    plan.kind === "none"
      ? "tg-ctl: no OS autostart to remove — stopped the background instance."
      : `tg-ctl: autostart disabled (${plan.kind}).`,
  )
  return 0
}

// --- hook/client handoff over a local Unix socket ---

const MAX_HOOK_REQUEST_BYTES = 64 * 1024

// How long an UNSCOPED forwarded question (paneId undefined — the hook ran
// without TMUX_PANE) may stay open before it self-clears to "expired — answer in
// terminal". This bound exists ONLY for the unscoped case, because an unscoped
// question defers inbound for ALL panes (paneHasPendingQuestion's fail-closed
// `if (!pb.req.paneId) return true`); without the bound it would wedge every
// pane's routing forever. A SCOPED question gets NO timer and waits indefinitely
// for its Telegram answer or socket close — that is safe (the timer is armed only
// for the `!req.paneId` branch in handleHookSocketLine). Overridable via env only
// so the integration tests can exercise the expiry without a real 110s wait;
// production never sets it.
const UNSCOPED_ABANDON_MS = (() => {
  const raw = Number(process.env.TG_CTL_UNSCOPED_TIMEOUT_MS)
  // setTimeout clamps any delay > 2^31-1 ms to ~1ms in Node/Bun, which would
  // flip a huge "wait longer" override into "expire instantly" — the opposite of
  // intent. Clamp to TIMEOUT_MAX so an oversized value still means "a long wait".
  // A non-positive / non-numeric / absent value (incl. 0) falls back to the 110s
  // default — 0 is NOT "expire instantly" (the bound is a backstop, never zero).
  const TIMEOUT_MAX = 2_147_483_647
  return Number.isFinite(raw) && raw > 0 ? Math.min(raw, TIMEOUT_MAX) : 110_000
})()

interface PendingButton {
  req: ButtonRequest
  socket: Socket
  messageId: number | null
  // Only a SCOPED-less (unscoped) question arms an abandon timer; a scoped
  // question waits forever, so its timer is undefined. clearTimeout(undefined)
  // is a safe no-op, so every clearTimeout(entry.timer) call site is correct
  // whether or not the timer was armed.
  timer?: ReturnType<typeof setTimeout>
  finalText?: string
}

function normalizeButtonRequest(value: unknown): ButtonRequest | null {
  if (!value || typeof value !== "object") return null
  const rec = value as Record<string, unknown>
  const requestId = typeof rec.requestId === "string" && rec.requestId ? rec.requestId : null
  const agent = typeof rec.agent === "string" ? rec.agent : null
  const kind = rec.kind === "question" || rec.kind === "permission" ? rec.kind : null
  const question = typeof rec.question === "string" && rec.question ? rec.question : null
  if (!requestId || !agent || !kind || !question) return null
  const options = Array.isArray(rec.options)
    ? rec.options
        .filter((o): o is Record<string, unknown> => Boolean(o) && typeof o === "object")
        .map((o) => {
          const label = typeof o.label === "string" ? o.label : ""
          const description = typeof o.description === "string" ? o.description : undefined
          return label ? (description ? { label, description } : { label }) : null
        })
        .filter((o): o is { label: string; description?: string } => o !== null)
    : undefined

  // Custom allow/deny button wording (plan-approval → Proceed/Keep planning).
  // Both labels must be present + non-empty strings, else fall back to the
  // default Approve/Reject by leaving it undefined.
  const dl = rec.decisionLabels
  const decisionLabels =
    dl && typeof dl === "object" &&
    typeof (dl as Record<string, unknown>).allow === "string" && (dl as Record<string, unknown>).allow &&
    typeof (dl as Record<string, unknown>).deny === "string" && (dl as Record<string, unknown>).deny
      ? { allow: (dl as Record<string, string>).allow, deny: (dl as Record<string, string>).deny }
      : undefined
  // Which Claude hook event fired — decides the reply shape (PreToolUse →
  // permissionDecision; PermissionRequest → decision.behavior). Default
  // PermissionRequest preserves the pre-existing reply for older payloads.
  const permissionEvent = rec.permissionEvent === "PreToolUse" ? "PreToolUse" : undefined

  return {
    requestId,
    buttonId: typeof rec.buttonId === "string" ? rec.buttonId : undefined,
    paneId: typeof rec.paneId === "string" ? rec.paneId : undefined,
    cwd: typeof rec.cwd === "string" ? rec.cwd : undefined,
    sessionName: typeof rec.sessionName === "string" ? rec.sessionName : undefined,
    agent: agent as ButtonRequest["agent"],
    kind,
    question,
    title: typeof rec.title === "string" ? rec.title : undefined,
    options,
    decisionLabels,
    permissionEvent,
  }
}

function canForwardButtonRequest(req: ButtonRequest): boolean {
  if (questionCapability(req.agent) !== "buttons") return false
  return !(req.agent === "codex" && req.kind !== "permission")
}

function hookMatchesRegistration(regs: Registration[], req: ButtonRequest): boolean {
  return registrationSetAllowsHook(regs, req, resolve)
}

// One-line, greppable descriptors for the ask-forward log. They identify which
// question arrived and which registration it was matched against, so a silent
// non-forward (the question stays in the harness) becomes a visible log line
// stating exactly why it was dropped — never a bare socket.end("null").
function describeAskRequest(req: ButtonRequest): string {
  return `agent=${req.agent} kind=${req.kind} req=${req.requestId} pane=${req.paneId ?? "-"} cwd=${req.cwd ?? "-"} session=${req.sessionName ?? "-"}`
}

function describeRegistration(regs: Registration[]): string {
  if (regs.length === 0) return "none"
  return regs
    .map((reg) => `pane=${reg.paneId ?? "-"} cwd=${reg.cwd ?? "-"} session=${reg.sessionName ?? "-"}`)
    .join(" | ")
}

function describeHookLine(line: string): string {
  const one = line.replace(/\s+/g, " ").trim()
  return one.length > 120 ? `${one.slice(0, 120)}…` : one
}

function startHookServer(
  ctx: Ctx,
  pending: Map<string, PendingButton>,
  activeKeys: Set<string>,
  onAbandon: (paneId: string) => void,
): Server | null {
  try {
    try {
      unlinkSync(ctx.paths.socket)
    } catch {}
    const server = createServer((socket) => {
      socket.setEncoding("utf8")
      let raw = ""
      socket.on("data", (chunk) => {
        raw += chunk
        const newline = raw.indexOf("\n")
        if (newline === -1) {
          // A hook request is a single small JSON line; anything bigger is a
          // misbehaving client trying to grow the buffer forever.
          if (raw.length > MAX_HOOK_REQUEST_BYTES) socket.destroy()
          return
        }
        const line = raw.slice(0, newline).trim()
        raw = raw.slice(newline + 1)
        void handleHookSocketLine(ctx, pending, activeKeys, onAbandon, socket, line)
      })
    })
    server.on("error", (err) => {
      log(`hook socket failed: ${err}`)
    })
    server.listen(ctx.paths.socket, () => {
      // Owner-only: the socket answers with approved hook JSON, so other local
      // users must not be able to connect (the guard trusts client-sent fields).
      try {
        chmodSync(ctx.paths.socket, 0o600)
      } catch {}
    })
    return server
  } catch (err) {
    log(`hook socket failed: ${err}`)
    return null
  }
}

async function handleHookSocketLine(
  ctx: Ctx,
  pending: Map<string, PendingButton>,
  activeKeys: Set<string>,
  // Called when a forwarded question is removed WITHOUT a Telegram answer
  // (timeout, hook socket close, send failure). The daemon drops that pane's
  // deferred backlog so it can't resurface, stale + out of order, on a LATER
  // unrelated question's answer (review finding).
  onAbandon: (paneId: string) => void,
  socket: Socket,
  line: string,
): Promise<void> {
  let req: ButtonRequest | null = null
  try {
    req = normalizeButtonRequest(JSON.parse(line))
  } catch {
    // malformed hook payload: let the local agent UI take over
  }
  if (!req) {
    // A non-forward must NEVER be silent: the question stays in the harness and
    // the operator gets zero signal. Every drop below logs a distinct, greppable
    // `ask-forward` reason so a question that doesn't reach Telegram is visible.
    log(`ask-forward dropped: reason=unparsable-payload line=${describeHookLine(line)}`)
    socket.end("null\n")
    return
  }

  log(`ask-forward arrived: ${describeAskRequest(req)}`)

  // The per-pane registration SET: the question forwards when ITS pane matches
  // ANY registered entry, so EVERY concurrently-registered session forwards
  // (tg-cli#67), not only the single global last-writer. No liveness pruning
  // here — the asking pane is itself live (it is blocking on this very question),
  // and an unrelated dead-pane entry can never match this req's paneId, so a
  // prune would only cost an extra tmux read on the hot forward path.
  const registrations = readRegistrations(ctx.paths)
  if (!hookMatchesRegistration(registrations, req)) {
    log(
      `ask-forward dropped: reason=not-registered ${describeAskRequest(req)} reg=${describeRegistration(registrations)}`,
    )
    socket.end("null\n")
    return
  }

  if (!canForwardButtonRequest(req)) {
    log(`ask-forward dropped: reason=not-forwardable ${describeAskRequest(req)}`)
    socket.end("null\n")
    void sendMessage(
      ctx,
      `native question forwarding isn't available for \`${req.agent}\` — answer in the terminal`,
    )
    return
  }

  const pendingKey = callbackRequestId(req)
  if (activeKeys.has(pendingKey)) {
    log(`ask-forward dropped: reason=duplicate-in-flight ${describeAskRequest(req)} key=${pendingKey}`)
    socket.end("null\n")
    return
  }
  activeKeys.add(pendingKey)
  const entry: PendingButton = {
    req,
    socket,
    messageId: null,
  }
  // A SCOPED question (paneId known) waits INDEFINITELY for its Telegram answer
  // or a socket close — no abandon timer. This is the CTO's daily lifeline: a
  // forwarded question must not silently expire to "answer in terminal" while the
  // human is still deciding. It is safe to wait forever because a scoped question
  // defers inbound for ONLY its own pane (paneHasPendingQuestion's
  // `pb.req.paneId === paneId` arm), and THAT pane's agent is itself blocked
  // waiting on this very question — so the deferral never starves inbound the
  // agent would otherwise process, and the queue flushes when the answer arrives.
  //
  // With the timer gone, the ONLY non-answer release for a scoped entry is the
  // socket 'close' below (registered before any await, so a close at any point —
  // even before messageId is set — is caught and dead-letters the pane). The hook
  // client (`tg-ctl ask`) holds this socket open for the agent's whole block, so
  // the agent's death closes the fd and frees the pane; a half-open socket would
  // be the only way to strand it, the same fd the kernel reaps on process exit.
  //
  // An UNSCOPED question (paneId undefined) still gets the bound: it defers ALL
  // panes (the fail-closed `if (!pb.req.paneId) return true`), so leaving it open
  // forever WOULD wedge every pane's routing. The timer is the only thing that
  // keeps that fail-closed defer from becoming a permanent all-pane wedge. The
  // #55 reply-route picker resolves where a REPLY goes, not a question's own
  // paneId — an unscoped question is never re-scoped, so this bound must stay.
  if (!req.paneId) {
    entry.timer = setTimeout(() => {
      if (pending.get(pendingKey) !== entry) return
      pending.delete(pendingKey)
      activeKeys.delete(pendingKey)
      // Unscoped → no onAbandon(paneId) (there is no pane to dead-letter); the
      // editMessageText/finalText path mirrors the socket-close branch.
      if (entry.messageId !== null) void editMessageText(ctx, entry.messageId, "expired — answer in terminal")
      else entry.finalText = "expired — answer in terminal"
      socket.end("null\n")
    }, UNSCOPED_ABANDON_MS)
  }
  pending.set(pendingKey, entry)

  let socketClosed = false
  socket.on("close", () => {
    socketClosed = true
    const current = pending.get(pendingKey)
    if (current !== entry) return
    clearTimeout(entry.timer)
    pending.delete(pendingKey)
    activeKeys.delete(pendingKey)
    if (entry.req.paneId) onAbandon(entry.req.paneId)
    if (entry.messageId !== null) void editMessageText(ctx, entry.messageId, "expired — answer in terminal")
    else entry.finalText = "expired — answer in terminal"
  })

  const payload = buildButtonMessage(ctx.chatId, req)
  const messageId = await sendMessage(ctx, payload.text, { reply_markup: payload.reply_markup })
  if (messageId === null) {
    // The low-level `sendMessage failed: …` is already logged in botPost; tie it
    // to THIS forwarded question being abandoned so the drop is greppable too.
    log(`ask-forward dropped: reason=send-failed ${describeAskRequest(req)}`)
    if (pending.get(pendingKey) === entry) {
      pending.delete(pendingKey)
      activeKeys.delete(pendingKey)
      clearTimeout(entry.timer)
      if (entry.req.paneId) onAbandon(entry.req.paneId)
      if (!socketClosed) socket.end("null\n")
    }
    return
  }
  log(`ask-forward posted: ${describeAskRequest(req)} messageId=${messageId}`)
  entry.messageId = messageId
  if (pending.get(pendingKey) !== entry || entry.finalText) {
    void editMessageText(ctx, messageId, entry.finalText ?? "expired — answer in terminal")
  }
}

// The agent kind the hook was installed for (`tg-ctl ask --agent codex`);
// defaults to claude. Decides how the raw payload is normalized + formatted.
function hookAgentFromArgv(): AgentKind {
  const i = process.argv.indexOf("--agent")
  const v = i >= 0 ? process.argv[i + 1] : undefined
  const known = ["claude", "codex", "opencode", "pi", "aider"]
  return (v && known.includes(v) ? v : "claude") as AgentKind
}

function tmuxSessionName(): string | undefined {
  if (!process.env.TMUX) return undefined
  try {
    const r = Bun.spawnSync(["tmux", "display-message", "-p", "#{session_name}"], { stdout: "pipe", stderr: "pipe" })
    if (r.exitCode === 0) return r.stdout.toString().trim() || undefined
  } catch {}
  return undefined
}

async function askDaemon(ctx: Ctx): Promise<void> {
  const input = await readStdinText()
  if (!input.trim()) return
  let payload: unknown
  try {
    payload = JSON.parse(input)
  } catch {
    return
  }
  // Normalize the harness's raw hook payload (or an already-normalized request)
  // into a ButtonRequest, filling routing fields from the hook process's own
  // env. null → unsupported shape; emit nothing so the local agent UI takes over.
  const env: HookEnv = {
    agent: hookAgentFromArgv(),
    paneId: process.env.TMUX_PANE || undefined,
    cwd: process.cwd(),
    sessionName: tmuxSessionName(),
  }
  const req = normalizeHookPayload(payload, env)
  if (!req) {
    // Unsupported payload shape (multi-question / multi-select / free-form / an
    // event we don't forward). This never reaches the daemon, so the daemon log
    // can't see it — emit here (hook process stderr) so the drop isn't silent.
    log(`ask-forward dropped: reason=unsupported-payload agent=${env.agent} pane=${env.paneId ?? "-"} cwd=${env.cwd ?? "-"}`)
    return
  }
  const requestLine = JSON.stringify(req)

  const output = await new Promise<string | null>((resolve) => {
    const socket = createConnection(ctx.paths.socket)
    let raw = ""
    const timer = setTimeout(() => {
      socket.destroy()
      resolve(null)
    }, 120_000)
    socket.setEncoding("utf8")
    socket.on("connect", () => socket.write(requestLine + "\n"))
    socket.on("data", (chunk) => {
      raw += chunk
    })
    socket.on("error", () => {
      clearTimeout(timer)
      resolve(null)
    })
    socket.on("end", () => {
      clearTimeout(timer)
      resolve(raw.trim() || null)
    })
  })
  if (output && output !== "null") console.log(output)
  else {
    // The daemon declined (replied "null") or the connection failed / timed out,
    // so nothing was forwarded and the harness UI takes over. The daemon already
    // logs WHY it declined (ask-forward dropped: …); log here too in case the
    // daemon was unreachable (no socket) and never got a chance to.
    log(`ask-forward not-posted: req=${req.requestId} agent=${req.agent} pane=${req.paneId ?? "-"} — daemon declined or unreachable`)
  }
}

async function readStdinText(): Promise<string> {
  return await new Promise((resolve, reject) => {
    let out = ""
    process.stdin.setEncoding("utf8")
    process.stdin.on("data", (chunk) => {
      out += chunk
    })
    process.stdin.on("end", () => resolve(out))
    process.stdin.on("error", reject)
  })
}

// --- run: the daemon itself ---

async function runDaemon(ctx: Ctx): Promise<never> {
  mkdirSync(ctx.configDir, { recursive: true })

  // flock FIRST (spec §6): bound to the open file description, released by the
  // kernel on ANY exit including SIGKILL. Neither Bun nor Node expose flock
  // and macOS has no flock(1), hence bun:ffi. The fd stays open for the
  // daemon's lifetime.
  const { dlopen, FFIType } = await import("bun:ffi")
  const lib = process.platform === "darwin" ? "libSystem.B.dylib" : "libc.so.6"
  const ffi = dlopen(lib, { flock: { args: [FFIType.i32, FFIType.i32], returns: FFIType.i32 } })
  const LOCK_EX_NB = 6 // LOCK_EX (2) | LOCK_NB (4)
  const lockFd = openSync(ctx.paths.lock, "w")
  if (ffi.symbols.flock(lockFd, LOCK_EX_NB) !== 0) {
    // Another daemon owns this bot — idempotent no-op (spec §6).
    process.exit(0)
  }

  writeFileSync(ctx.paths.pid, `${process.pid}\n`)
  const pendingButtons = new Map<string, PendingButton>()
  const activeButtonKeys = new Set<string>()
  // /agent (and unrecognized-reply) selection awaiting a button tap: token →
  // message + candidate list. `prewrapped` = inject the message verbatim (a reply
  // already carries its wrap/anchor) instead of wrapping it again.
  const pendingAgent = new Map<
    string,
    {
      message: string
      candidates: AgentCandidate[]
      messageId: number | null
      timer: ReturnType<typeof setTimeout>
      prewrapped?: boolean
      // Bare `/agent` picker: there is no message yet. A tap must NOT inject an
      // empty message — it confirms the choice and tells the user the selector
      // to address it with (`/agent <selector> <message>`).
      selectOnly?: boolean
    }
  >()
  let agentTokenSeq = 0
  // Inbound queued behind an agent's outstanding question (defer-while-waiting):
  // pane → already-wrapped texts, flushed when the question is answered. The
  // flag tells the trailing `ack` to mark the source message with DEFER_REACTION
  // (✍️ "noted, queued") instead of 👀.
  const deferred = new DeferQueues()
  // Panes with an in-flight flushDeferred. While a flush drains a pane, its queue
  // is momentarily empty (taken out per round), so deferred.has() alone would let
  // a live message inject AHEAD of items still being flushed. This flag keeps new
  // inbound deferring for the whole flush, preserving strict FIFO; the drain
  // loop's next round picks up whatever was enqueued meanwhile.
  const flushingPanes = new Set<string>()
  // Panes whose forwarded question was abandoned (timeout / socket close / send
  // failure, no terminal answer) WHILE a flush was draining that pane. The flush
  // loop owns the queue here, so onQuestionAbandoned cannot drop it directly; it
  // records the pane and the drain loop dead-letters the residual queue instead of
  // pasting it into the still-open prompt (codex P2 — concurrent-flush resurface).
  const abandonedDuringFlush = new Set<string>()
  let lastWasDeferred = false
  const paneHasPendingQuestion = (paneId: string): boolean => {
    for (const pb of pendingButtons.values()) {
      // tg#30: an UNSCOPED question — paneId undefined because the hook subprocess ran WITHOUT
      // TMUX_PANE (the common Claude Code case) — defers inbound for ANY pane (fail CLOSED). The
      // old guard required `pb.req.paneId && === paneId`, so a paneId-less question matched NO pane,
      // inbound was NOT deferred, and the next message was send-keys'd into the open prompt. We
      // can't prove an unscoped question is a DIFFERENT pane than the inject target, so don't paste.
      // This can NEVER wedge routing: every entry self-clears in ≤110s (the abandon timer above),
      // unlike a stale queue (which is intentionally NOT treated as a defer).
      if (!pb.req.paneId) return true
      if (pb.req.paneId === paneId) return true
    }
    return false
  }
  // A live inbound message defers behind an OPEN question OR an in-flight flush
  // (which sets flushingPanes for its whole duration, incl. the 800ms settle and
  // every inter-paste gap). Those two cover every window where injecting now would
  // either hit an open prompt or jump ahead of older queued items.
  //
  // It deliberately does NOT defer merely because the queue is non-empty: a queue
  // can outlive its question (the Telegram prompt expires / its hook socket closes
  // WITHOUT a terminal answer — the agent is still blocked locally, so we must not
  // flush, but no future answer will arrive to drain it either). Treating a
  // non-empty queue as "defer" would then wedge EVERY later message to that pane
  // forever (review finding). FIFO during a real flush is preserved by
  // flushingPanes; a question (live or expired-in-terminal) is preserved by
  // paneHasPendingQuestion while the prompt is open.
  const shouldDeferInbound = (paneId: string): boolean =>
    paneHasPendingQuestion(paneId) || flushingPanes.has(paneId)
  // Enqueue only — the caller sets lastWasDeferred when this came from a MESSAGE
  // action (which earns a ⏳ ack); a button-callback defer edits its prompt
  // instead and must NOT leak the flag onto the next message's ack.
  const enqueueDeferred = (paneId: string, wrappedText: string): void => {
    deferred.enqueue(paneId, wrappedText)
  }
  const injectDeferredOne = async (paneId: string, text: string): Promise<boolean> => {
    // Must NEVER throw: a throw here rejects driveFlush, which (a) loses the
    // already-taken batch and (b) becomes an unhandled rejection in the
    // fire-and-forget flushDeferred call. executeInjectSteps normally returns
    // {ok:false} on tmux errors, but a spawn/exception could still escape — treat
    // any throw as a failed paste (drop + log), exactly like {ok:false}.
    try {
      const res = await executeInjectSteps(buildTextInjectPlan(paneId, text))
      if (!res.ok) log(`deferred flush into ${paneId} failed: ${res.error}`)
      return res.ok
    } catch (err) {
      log(`deferred flush into ${paneId} threw: ${err}`)
      return false
    }
  }
  // Tell the user a pane's deferred backlog was dropped without reaching the agent
  // (its question was abandoned before an answer). Declared above flushDeferred so
  // the latter can reference it (via deadLetterAbandoned) without a TDZ hazard.
  // User-facing dead-letter notice (no-op when nothing was queued — no ping if
  // there's nothing to resend). Callers own the daemon.log record so the resolution
  // is always traced even at count 0; this only handles the Telegram side.
  const notifyDeadLettered = (paneId: string, count: number): void => {
    if (count === 0) return
    // Guard the fire-and-forget send: this is a safety-critical notice (the user's
    // only signal that messages were dropped), so a transport failure must at least
    // hit the daemon log rather than vanish silently (review finding). NOTE: like
    // every void-send in this daemon, an in-flight send can still be cut off by a
    // shutdown right after a dead-letter — a pre-existing outbound-durability gap,
    // not introduced here.
    sendMessage(
      ctx,
      `⚠️ the question expired before it was answered — ${count} queued message(s) were NOT delivered. Resend them.`,
    ).catch((err) => log(`failed to notify dead-letter on ${paneId}: ${err}`))
  }
  const flushDeferred = async (paneId: string): Promise<void> => {
    if (!deferred.has(paneId)) return
    // Re-entrancy guard: two answers for the same pane could both reach here (the
    // action loop awaits each, but flushDeferred is fire-and-forget). The flag
    // also routes new inbound into the queue for the whole flush (FIFO).
    if (flushingPanes.has(paneId)) return
    flushingPanes.add(paneId)
    // The flag is cleared in the finally below, and onQuestionAbandoned only sets
    // it while flushingPanes holds this pane — which the re-entrancy guard above
    // makes mutually exclusive with a second concurrent flush — so it is always
    // clean on entry; no defensive clear is needed here.
    //
    // Dead-letter the orphaned backlog for a pane whose abandoned question has no
    // answer coming. `tail` is the slice driveFlush already removed from the live
    // queue (via the round's take()); `deferred.drop()` returns whatever else is
    // still queued. They are disjoint — take() emptied the pane entry at the start
    // of the round, so anything drop() returns was enqueued after it — so the sum
    // is the exact count of messages that never reached the agent.
    const deadLetterAbandoned = (tail: readonly string[]): void => {
      const dropped = deferred.drop(paneId)
      const count = tail.length + dropped.length
      // Always log the resolution (even a zero-count one) so daemon.log records
      // that the abandonment flag was seen and handled — distinguishing "flagged
      // and resolved" from "never flagged" (review finding). The user-facing notice
      // (notifyDeadLettered) stays count-gated: nothing to resend means no ping.
      log(`flush on ${paneId} dead-lettered ${count} orphaned message(s) (abandoned, no answer coming)`)
      notifyDeadLettered(paneId, count)
    }
    try {
      // Let the agent consume the just-delivered answer before the first paste.
      await Bun.sleep(800)
      // Drain in rounds: each round takes the current queue and feeds it to
      // driveFlush (which re-checks paneHasPendingQuestion before EVERY paste).
      // A round can leave a tail three ways: a NEW question opened (re-defer it —
      // it flushes when that question is answered); a question was ABANDONED
      // mid-flush (dead-letter the residual — no answer is coming, see codex P2);
      // or fresh messages were enqueued DURING the round (drain them next round,
      // while the pane stays free — otherwise they'd sit until the next unrelated
      // question). Inject FAILURES do NOT re-defer: there may be no future question
      // to flush them, so they are logged + dropped rather than wedging the queue
      // forever (review finding).
      // Resolve a mid-flush abandonment. The queue is keyed by PANE, not question,
      // so when a question is abandoned we cannot tell its orphaned messages from
      // those of ANOTHER question still live on the same pane. Gate strictly on
      // pane-idle (codex P2: "dead-letter once no question is pending"):
      //   - a question is STILL pending → a live prompt owns the queue; re-defer
      //     the residual so its answer flushes it. Dropping here would lose that
      //     live question's legitimately-queued messages (review finding #1).
      //   - no question pending → the messages are truly orphaned (no answer is
      //     coming); dead-letter them rather than paste into the still-open prompt.
      // `tail` is driveFlush's untouched slice (already removed from the queue). The
      // pending read and the redefer/drop that follows run in ONE synchronous tick
      // (no await between), so no inbound can interleave and be misrouted.
      const resolveAbandonment = (tail: readonly string[]): void => {
        if (paneHasPendingQuestion(paneId)) {
          deferred.redefer(paneId, [...tail])
          log(`deferred flush into ${paneId} paused — ${tail.length} item(s) re-queued (abandon raced a new question)`)
        } else {
          deadLetterAbandoned(tail)
        }
      }
      for (;;) {
        // A question abandoned exactly at a round boundary (after driveFlush
        // returned, before this take) leaves no tail to hand back, but the queue
        // still must not be pasted — resolve it (dead-letter if idle, re-defer if a
        // new question is now pending) and stop.
        if (abandonedDuringFlush.has(paneId)) {
          resolveAbandonment([])
          return
        }
        const queue = deferred.take(paneId)
        if (queue.length === 0) return
        const outcome = await driveFlush(
          queue,
          () => paneHasPendingQuestion(paneId),
          (text) => injectDeferredOne(paneId, text),
          () => abandonedDuringFlush.has(paneId),
        )
        if (outcome.abandoned.length > 0 || abandonedDuringFlush.has(paneId)) {
          resolveAbandonment(outcome.abandoned)
          return
        }
        if (outcome.reDeferred.length > 0) {
          deferred.redefer(paneId, outcome.reDeferred)
          log(`deferred flush into ${paneId} paused — ${outcome.reDeferred.length} item(s) re-queued behind a new question`)
          return
        }
        // Stop if a question is now open (its answer re-triggers the flush) or the
        // queue is empty; else loop to drain anything enqueued during this round.
        if (paneHasPendingQuestion(paneId) || !deferred.has(paneId)) return
      }
    } finally {
      flushingPanes.delete(paneId)
      abandonedDuringFlush.delete(paneId)
    }
  }
  // A forwarded question was removed WITHOUT a Telegram answer (timeout / hook
  // socket close / send failure). The agent's local prompt is still open, so we
  // must NOT flush — but we must also not leave the pane's backlog to resurface,
  // stale and out of order, when some LATER unrelated question on this pane is
  // answered. Dead-letter it and tell the user (the messages never landed).
  //
  // The queue is keyed by PANE, not by question, so it may hold items that belong
  // to a DIFFERENT outstanding handler on the same pane. Drop ONLY when the pane
  // is otherwise idle: skip if a flush is in flight (it owns + will deliver the
  // queue) or another question is still pending (its answer will flush). Dropping
  // in either case would lose another handler's messages (review finding).
  const onQuestionAbandoned = (paneId: string): void => {
    // A flush is draining this pane: it owns the queue (taken out per round), so
    // dropping here would race the loop and could lose nothing OR the wrong items.
    // Record the pane instead — the drain loop checks the flag and dead-letters the
    // residual once it sees no pending question, rather than pasting those orphaned
    // messages into the still-open terminal prompt (codex P2 concurrent-flush race).
    if (flushingPanes.has(paneId)) {
      abandonedDuringFlush.add(paneId)
      // Timestamp the abandonment itself: the flush resolves it later (re-defer or
      // dead-letter), but logging here makes the event visible in daemon.log for
      // post-incident review even if the resolution path is quiet (review finding).
      log(`question abandoned on ${paneId} mid-flush — flagged for the drain loop`)
      return
    }
    // Another question is still pending on this pane: its answer will flush the
    // queue legitimately, so leave it (the queue is keyed by PANE, not question).
    if (paneHasPendingQuestion(paneId)) return
    // Pane is idle and no flush owns the queue: drop the orphaned backlog now. The
    // pending check above and this drop run in the SAME synchronous tick (no await
    // between), so no inbound for a freshly-opened question can interleave and be
    // dropped by mistake — the daemon's inbound handling is event-loop callbacks.
    const droppedCount = deferred.drop(paneId).length
    log(`question abandoned on ${paneId} (idle) — dead-lettered ${droppedCount} queued message(s)`)
    notifyDeadLettered(paneId, droppedCount)
  }
  let hookServer: Server | null = null
  const cleanExit = (code: number): never => {
    try {
      unlinkSync(ctx.paths.pid)
    } catch {}
    try {
      hookServer?.close()
    } catch {}
    try {
      unlinkSync(ctx.paths.socket)
    } catch {}
    process.exit(code)
  }
  process.on("SIGTERM", () => cleanExit(0))
  process.on("SIGINT", () => cleanExit(0))

  hookServer = startHookServer(ctx, pendingButtons, activeButtonKeys, onQuestionAbandoned)

  if (ctx.cfg.transport === "channel") {
    log("transport 'channel' is reserved for v1.2+ — falling back to tmux")
  }

  let offset = readOffset(readFileOrNull(ctx.paths.offset))
  let lastAgentSeenMs = Date.now() // grace period from daemon start
  let consecutive409 = 0
  let warned409 = false

  // The origin pane of the LAST MESSAGE in the chat, from routes.json (tg-cli#78):
  // the pane that produced the newest outbound `tg` send. This is the single
  // "who posted last" value the no-reply bind uses — NOT a per-pane aggregate.
  const lastMessagePaneId = (): string | null => lastMessagePane(parseRoutes(readFileOrNull(ctx.paths.routes)))

  // The base discovery: §10 priority chain + liveness bookkeeping, NO last-message
  // bind. Used by liveness/history paths that must NOT silently pick an agent. The
  // no-reply bind lives ONLY in discoverForInject below, so it can never leak onto
  // the reply path (which uses handleReplyRoute's own #49 fail-closed, not discover())
  // or the history-attribution path.
  const discover = (): DiscoverResult => {
    const result = discoverTarget(ctx)
    // Agent panes existing — even ambiguous ones — keep the daemon alive.
    if (result.ok || result.candidates.length > 0) lastAgentSeenMs = Date.now()
    return result
  }

  // discover() PLUS the no-reply last-message bind (tg-cli#78): an otherwise-ambiguous
  // NON-reply inbound binds to the agent of the LAST MESSAGE in the chat rather than
  // asking. This runs BEFORE #76's ambiguous-picker: a fresh message after the last
  // agent posted lands there directly; the picker fires only when there is NO last
  // message, or its pane is gone / not a candidate. The lookup is LAZY — only on a
  // genuinely ambiguous base result — so the common ok/no-agent path never reads
  // routes.json. This is the ONLY discovery used by the non-reply INJECT paths
  // (injectViaTarget with autoBind). A no-last-message case stays ambiguous → #76's
  // picker (the unscoped fail-closed, #49).
  const discoverForInject = (): DiscoverResult => {
    const result = discover()
    if (result.ok || result.reason !== "ambiguous") return result
    return resolveByLastMessage(result, lastMessagePaneId())
  }

  // Resolve a DiscoverResult's ambiguous `TargetPane[]` to the picker's
  // `AgentCandidate[]` (window names + cwd → distinct labels). The TargetPane
  // shape carries no window name, so re-derive over a fresh listAgentCandidates()
  // snapshot, keeping ONLY the discovery-narrowed panes that are STILL a live
  // agent candidate. A pane that raced away between the two snapshots (or no
  // longer passes the agent-candidate criterion) drops out — the picker shows
  // only panes a tap can actually route into, never a synthetic button into a
  // dead/non-agent pane. The set/discovery layer already guarantees ≥2 live
  // candidates on the ambiguous path, so the result is non-empty in practice; if
  // a freak full race emptied it, postRoutePicker/postSelectPicker fall back to
  // the no-agent reply rather than an empty button set.
  const candidatesForPicker = (panes: TargetPane[]): AgentCandidate[] => {
    const want = new Set(panes.map((c) => c.pane.paneId))
    return listAgentCandidates().filter((c) => want.has(c.paneId))
  }

  // The "not found" reply for a target that genuinely has NO agent. The ambiguous
  // case never reaches here anymore — it posts the inline-keyboard PICKER (buttons,
  // like /agent) instead of the old plain-text candidate dump (tg-cli#72). Kept as
  // a tiny helper for the no-agent message + the /kill path's reuse.
  const replyNoAgent = async (): Promise<void> => {
    await sendMessage(ctx, NO_AGENT_REPLY)
  }

  // Pick a target, run the plan; every failure mode turns into a TG reply so
  // the human is never left wondering whether the message landed. Returns
  // true only when the plan actually executed — the caller uses it to decide
  // whether the source message earns its 👀 delivery receipt.
  //
  // `autoBind` (default off, tg-cli#78) opts a HARMLESS content inject
  // (text/photo/voice) into the no-reply last-message bind: an otherwise-ambiguous
  // non-reply message lands on the agent of the LAST MESSAGE in the chat FIRST
  // (discoverForInject), so the picker below fires LESS often. It is OFF for control
  // keys (/stop's Escape) — interrupting a GUESSED agent is the wrong default; an
  // ambiguous control verb asks.
  //
  // When the target is STILL ambiguous (auto-bind off, or no last message to prefer)
  // and the inject carries routable text, it posts the agent PICKER (tappable buttons,
  // tg-cli#76) and arms the pending route — a tap injects `deferText` verbatim, exactly
  // like the /agent picker. A control verb with no text (inject-key /stop) has nothing
  // to route through a tap, so it falls back to the picker WITHOUT a pending route
  // (select-only) — the buttons still tell the human which agents are live, not a
  // text dump.
  const injectViaTarget = async (
    buildPlan: (paneId: string) => InjectStep[],
    deferText?: string,
    autoBind = false,
  ): Promise<boolean> => {
    const found = autoBind ? discoverForInject() : discover()
    if (!found.ok) {
      // Routable text present (a real message) → route picker: a tap injects it
      // verbatim. Empty/whitespace deferText is treated as "no text" (same rule as
      // postAgentPicker's selectOnly), so it never arms a pending route that would
      // inject nothing on tap.
      if (found.reason === "ambiguous" && deferText !== undefined && deferText.trim() !== "") {
        return postRoutePicker(candidatesForPicker(found.candidates), deferText)
      }
      if (found.reason === "ambiguous") {
        // No routable text (a /stop with several agents): show the live agents as
        // a select-only picker rather than dumping them as text. A select-only tap
        // does NOT re-run the control verb (it only hands back the selector), so
        // the verb did NOT execute — return false so the source message earns no
        // 👀 "delivered" receipt (matching the kill-agent ambiguous branch below
        // and this function's "true only when the plan executed" contract).
        await postSelectPicker(candidatesForPicker(found.candidates))
        return false
      }
      await replyNoAgent()
      return false
    }
    const paneId = found.target.pane.paneId
    // Defer a text message behind the pane's outstanding question OR an existing
    // backlog (⏳); control verbs (Escape, no deferText) always go through to
    // interrupt it.
    if (deferText !== undefined && shouldDeferInbound(paneId)) {
      enqueueDeferred(paneId, deferText)
      lastWasDeferred = true
      return true
    }
    const result = await executeInjectSteps(buildPlan(paneId))
    if (!result.ok) {
      log(`inject aborted: ${result.error}`)
      await sendMessage(ctx, result.error)
      return false
    }
    return true
  }

  // Inject a wrapped message into ONE specific pane (the /agent target). The
  // plan's verify-pane step still re-checks the pane hosts an agent first.
  const injectToPane = async (
    paneId: string,
    from: string,
    msg: string,
  ): Promise<{ ok: boolean; error?: string; deferred?: boolean }> => {
    const wrapped = wrapInbound(ctx.cfg.injectWrap, from, msg)
    if (shouldDeferInbound(paneId)) {
      enqueueDeferred(paneId, wrapped)
      return { ok: true, deferred: true }
    }
    const res = await executeInjectSteps(buildTextInjectPlan(paneId, wrapped))
    return res.ok ? { ok: true } : { ok: false, error: res.error }
  }

  // `label` identifies the chosen agent: `<window> · <agent>` for a direct/
  // confident route, or the picker's DISTINCT label (cwd-derived) when several
  // agents shared a bare window name — so the confirmation never reads an
  // ambiguous "4 · claude".
  const routedReply = (label: string, deferred?: boolean): string =>
    deferred ? `⏳ queued for ${label} (answering a question)` : `→ ${label}`

  // The distinct label for `target` within `fleet` (cwd-derived disambiguation),
  // falling back to `<window> · <agent>` if the target isn't in the fleet.
  const labelFor = (target: AgentCandidate, fleet: AgentCandidate[]): string => {
    const i = fleet.indexOf(target)
    return i >= 0 ? distinctLabels(fleet)[i] : `${target.windowName} · ${target.agent}`
  }

  // Post the session-grouped inline-keyboard agent PICKER and arm its pending
  // selection. `message` empty ⇒ a bare-`/agent` select-only picker (a tap
  // confirms the choice, no inject); non-empty ⇒ the route picker (a tap injects
  // the message). Returns false only when the picker send itself failed.
  const postAgentPicker = async (subset: AgentCandidate[], message: string): Promise<boolean> => {
    const token = `a${++agentTokenSeq}`
    const payload = buildAgentSelectMessage(ctx.chatId, subset, token, message)
    const messageId = await sendMessage(ctx, payload.text, { reply_markup: payload.reply_markup })
    // Picker send failed (Telegram rejected / >4096-char list / network): do NOT
    // store a pending route it can never resolve, and do NOT earn a 👀 receipt.
    if (messageId === null) {
      await sendMessage(ctx, "couldn't post the agent picker — try a narrower /agent <window>")
      return false
    }
    const timer = setTimeout(() => pendingAgent.delete(token), 10 * 60_000)
    pendingAgent.set(token, { message, candidates: subset, messageId, timer, selectOnly: message.trim() === "" })
    return true
  }

  // Select-only picker (buttons, no pending route): the bare-`/agent` flow, but
  // also the fallback for an ambiguous control verb that carries no routable text
  // (a /stop or /kill across several agents) — the buttons show the live agents
  // instead of a plain-text dump, and a tap hands back the selector to address one.
  // Guards an empty subset (a freak full race where candidatesForPicker filtered
  // every discovery pane out) → the no-agent reply, never a button-less picker
  // (mirrors postRoutePicker; matches the candidatesForPicker fallback comment).
  const postSelectPicker = async (subset: AgentCandidate[]): Promise<boolean> => {
    if (subset.length === 0) {
      await replyNoAgent()
      return false
    }
    return postAgentPicker(subset, "")
  }

  // Route picker for ALREADY-WRAPPED text (a tap injects it VERBATIM, prewrapped:
  // true) — the ambiguous-target path (injectViaTarget) and, with a gone-target
  // `notice`, the reply-route picker. Unlike postReplyPicker it does NOT reorder by
  // LRU/MRU: the ambiguous fleet has no prior reply usage to rank by. Returns false
  // only when the picker send itself failed.
  const postRoutePicker = async (
    subset: AgentCandidate[],
    prewrappedText: string,
    notice?: string,
  ): Promise<boolean> => {
    if (subset.length === 0) {
      await replyNoAgent()
      return false
    }
    const token = `a${++agentTokenSeq}`
    const payload = buildAgentSelectMessage(ctx.chatId, subset, token, prewrappedText, false, notice)
    const messageId = await sendMessage(ctx, payload.text, { reply_markup: payload.reply_markup })
    if (messageId === null) {
      await sendMessage(ctx, "couldn't post the agent picker — try a narrower /agent <window>")
      return false
    }
    const timer = setTimeout(() => pendingAgent.delete(token), 10 * 60_000)
    pendingAgent.set(token, { message: prewrappedText, candidates: subset, messageId, timer, prewrapped: true })
    return true
  }

  // /agent routing (item 1): bare `/agent` → an inline-keyboard PICKER (tappable
  // buttons, one distinct-labelled button per agent); confident phonetic match →
  // direct inject; ambiguous / no-match → the same session-grouped picker
  // carrying the pending message.
  const handleAgentRoute = async (action: Extract<Action, { kind: "agent-route" }>): Promise<boolean> => {
    const candidates = listAgentCandidates()
    if (candidates.length === 0) {
      await sendMessage(ctx, NO_AGENT_REPLY)
      return false
    }
    if (!action.all.trim()) {
      // Bare `/agent`: show the tappable picker so the CTO can SELECT an agent
      // (the buttons he asked for — "где кнопки?"), with distinct labels.
      return postAgentPicker(candidates, "")
    }

    let subset = candidates
    let message = action.all
    if (action.selector) {
      const m = matchWindows(action.selector, candidates)
      if (m.matches.length > 0) {
        if (!action.rest.trim()) {
          const names = m.matches.map((c) => c.windowName).join(", ")
          await sendMessage(ctx, `matched ${names} — add a message: /agent ${action.selector} <message>`)
          return true
        }
        if (m.confident) {
          const target = m.matches[0]
          const res = await injectToPane(target.paneId, action.from, action.rest)
          if (!res.ok) {
            await sendMessage(ctx, res.error ?? "inject failed")
            return false
          }
          if (res.deferred) lastWasDeferred = true
          await sendMessage(ctx, routedReply(labelFor(target, candidates), res.deferred))
          return true
        }
        subset = m.matches
        message = action.rest
      }
      // selector matched nothing → the whole text is the message, ask over all
    }

    if (subset.length === 1) {
      const target = subset[0]
      const res = await injectToPane(target.paneId, action.from, message)
      if (!res.ok) {
        await sendMessage(ctx, res.error ?? "inject failed")
        return false
      }
      if (res.deferred) lastWasDeferred = true
      await sendMessage(ctx, routedReply(labelFor(target, candidates), res.deferred))
      return true
    }

    return postAgentPicker(subset, message)
  }

  const handleAgentCallback = async (action: Extract<Action, { kind: "agent-callback" }>): Promise<boolean> => {
    const pending = pendingAgent.get(action.token)
    if (!pending) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    // A tap must come from THIS prompt's Telegram message. After a restart
    // agentTokenSeq reuses tokens (a1, a2…), so a tap on an OLD prompt that
    // reused the token must not consume the new pending route (codex P2).
    if (pending.messageId !== null && action.messageId !== null && action.messageId !== pending.messageId) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    const target = pending.candidates[action.index]
    if (!target) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    pendingAgent.delete(action.token)
    clearTimeout(pending.timer)
    // Bare-`/agent` select-only picker: there is no message to inject. Confirm
    // the choice and hand back the exact selector to address this agent — the
    // selector matchWindows keys on is the window name (its cwd basename when the
    // window name is bare/numeric, which still phonetically matches that pane).
    if (pending.selectOnly) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "selected")
      if (pending.messageId !== null) {
        // Verify the suggested selector against the FULL live fleet, not the
        // pending subset: an ambiguous `/agent <sel>` (no message) narrows
        // `pending.candidates` to the matches, but the user's follow-up `/agent
        // <selector> <message>` re-resolves against ALL agents — a pane OUTSIDE
        // the subset whose window name matches the suggestion would otherwise be
        // a silent misroute (review finding). A fresh snapshot that still
        // contains the chosen pane is authoritative; if it raced away, fall back
        // to the pending subset (the picker re-opens — safe).
        const live = listAgentCandidates()
        const fleet = live.some((c) => c.paneId === target.paneId) ? live : pending.candidates
        const liveTarget = fleet.find((c) => c.paneId === target.paneId) ?? target
        const selector = suggestSelector(liveTarget, fleet)
        // Show the DISTINCT label (not the ambiguous "4 · claude") so the user
        // sees which agent they picked, then the exact command to address it.
        const label = labelFor(liveTarget, fleet)
        void editMessageText(ctx, pending.messageId, `selected ${label} — send: /agent ${selector} <message>`)
      }
      return true
    }
    // A reply's pending text already carries its wrap/anchor → inject verbatim;
    // a /agent message is raw → wrap it. Both defer behind an open question. A
    // callback edits its own prompt, so it must NOT set lastWasDeferred.
    let res: { ok: boolean; error?: string; deferred?: boolean }
    if (pending.prewrapped) {
      if (shouldDeferInbound(target.paneId)) {
        enqueueDeferred(target.paneId, pending.message)
        res = { ok: true, deferred: true }
      } else {
        const r = await executeInjectSteps(buildTextInjectPlan(target.paneId, pending.message))
        res = r.ok ? { ok: true } : { ok: false, error: r.error }
      }
    } else {
      res = await injectToPane(target.paneId, action.from, pending.message)
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, res.ok ? (res.deferred ? "queued" : "sent") : "failed")
    if (pending.messageId !== null) {
      void editMessageText(
        ctx,
        pending.messageId,
        res.ok ? routedReply(labelFor(target, pending.candidates), res.deferred) : `inject failed: ${res.error ?? ""}`,
      )
    }
    return res.ok
  }

  // A reply: route to the recognized origin pane (routes map) or, when unknown,
  // a session-grouped picker ordered LRU/MRU. injectText already carries the
  // wrap + quote anchor, so it is injected verbatim everywhere here.
  const handleReplyRoute = async (action: Extract<Action, { kind: "reply-route" }>): Promise<boolean> => {
    const routes = parseRoutes(readFileOrNull(ctx.paths.routes))
    const recognized = recognizeRoute(routes, action.replyToMessageId)
    const injectVerbatim = async (paneId: string): Promise<boolean> => {
      if (shouldDeferInbound(paneId)) {
        enqueueDeferred(paneId, action.injectText)
        lastWasDeferred = true
        return true
      }
      const res = await executeInjectSteps(buildTextInjectPlan(paneId, action.injectText))
      if (!res.ok) {
        await sendMessage(ctx, res.error)
        return false
      }
      return true
    }

    // Post the LRU/MRU-ordered agent picker for this reply and arm its pending
    // selection. Shared by the unrecognized-multi-agent case AND the
    // recognized-but-unconfirmed origin case (a known origin we currently can't
    // SEE must never auto-collapse onto the wrong agent — let the human pick).
    // `notice` prepends a gone-target line ("That agent … is no longer running")
    // when the reply's recorded origin pane is no longer a live, same-project agent.
    const postReplyPicker = async (candidates: AgentCandidate[], notice?: string): Promise<boolean> => {
      const usage = aggregateUsage(routes)
      const order = orderByLruMru(candidates.map((c) => c.paneId), usage)
      const byPane = new Map(candidates.map((c) => [c.paneId, c]))
      const sorted = order.map((pid) => byPane.get(pid)!).filter(Boolean)
      const token = `a${++agentTokenSeq}`
      // preserveOrder: keep the LRU/MRU ranking — groupBySession must not re-sort.
      const payload = buildAgentSelectMessage(ctx.chatId, sorted, token, action.injectText, true, notice)
      const messageId = await sendMessage(ctx, payload.text, { reply_markup: payload.reply_markup })
      if (messageId === null) {
        await sendMessage(ctx, "couldn't post the reply picker")
        return false
      }
      const timer = setTimeout(() => pendingAgent.delete(token), 10 * 60_000)
      pendingAgent.set(token, { message: action.injectText, candidates: sorted, messageId, timer, prewrapped: true })
      return true
    }

    // A human label for the GONE origin agent of this recognized reply — the
    // project dir (cwd basename) it was recorded against, else its pane id. Used
    // in the picker notice so the CTO sees WHICH agent vanished, not just "an agent".
    const goneOriginLabel = (): string => {
      const cwd = recognized?.cwd
      if (cwd) {
        const base = cwd.replace(/\/+$/, "").split("/").pop()
        if (base) return base
      }
      return recognized?.paneId ?? "the agent you replied to"
    }
    const goneNotice = (): string => `That agent (${goneOriginLabel()}) is no longer running — pick a live one:`

    if (recognized) {
      const { panes, procs } = snapshot()
      const pane = panes.find((p) => p.paneId === recognized.paneId)
      // Route to the origin pane ONLY if it still hosts an agent AND is still the
      // SAME project: a tmux pane id is reused after kill-pane, so a stale
      // message_id→%N map could otherwise inject a reply into a DIFFERENT
      // project's agent — leaking project A's reply into project B (review
      // --brainstorm finding). routeMatchesPane validates the recorded send-path
      // (now the origin pane's path — see tg recordRoute) against the live pane's
      // path; on mismatch (or no recorded cwd for an old route) fall through to
      // the picker rather than risk mis-routing.
      const sameProject = routeMatchesPane({ recognizedCwd: recognized.cwd, panePath: pane?.panePath })
      if (pane && sameProject && findAgentInPane(pane, procs)) return injectVerbatim(recognized.paneId)

      // We KNOW the origin pane but the snapshot can't CONFIRM it. snapshot()
      // already retried the transient empty/partial `tmux list-panes` read
      // (panesWithRetry); if it STILL can't see the recognized pane there are two
      // shapes — and the launchd no-locale flake (`no-agent reply: panes=0`) makes
      // a zero/partial snapshot a real, recurring runtime state, not a one-off:
      //   (a) the snapshot returned ZERO/partial panes — origin almost certainly
      //       still alive, just invisible. The OLD code fell through and, when the
      //       partial snapshot left exactly ONE agent visible (deterministically
      //       the last writer of the single global registration slot — [rig]/%2),
      //       silently injected the recognized reply into THAT wrong agent. A
      //       recognized reply must NEVER lose to whatever single agent is visible.
      //   (b) the origin pane is genuinely gone/reused/different-project — the
      //       legitimate fall-through to the picker (04cb6e5).
      // Tell them apart by whether the origin pane appears in the snapshot AT ALL
      // (`pane` IS that lookup — undefined ⇔ not visible). When it is NOT visible,
      // post the PICKER (human disambiguates) instead of the single-candidate
      // auto-inject — never the registration's last-writer pane.
      if (!pane) {
        const candidates = listAgentCandidates()
        if (candidates.length === 0) {
          await sendMessage(ctx, NO_AGENT_REPLY)
          return false
        }
        // Even a single visible candidate is NOT trusted here: the recognized
        // origin is unconfirmed, so post the picker rather than auto-inject. The
        // origin pane isn't visible — it may be a snapshot flake OR genuinely gone;
        // either way the human picks. Name the agent they meant so a real kill
        // reads as "that agent is gone" rather than a silent re-ask (CTO ask, #72).
        return postReplyPicker(candidates, goneNotice())
      }
      // origin pane visible but not a same-project agent → genuinely reused/gone;
      // fall through to the normal picker path below (with the gone notice).
    }

    const candidates = listAgentCandidates()
    if (candidates.length === 0) {
      await sendMessage(ctx, NO_AGENT_REPLY)
      return false
    }
    // An UNRECOGNIZED reply (no origin known) with a single agent is unambiguous —
    // inject there. The recognized-but-unconfirmed case above never reaches here.
    if (!recognized && candidates.length === 1) return injectVerbatim(candidates[0].paneId)

    // Anything else — several agents, OR a recognized reply that fell through
    // (origin visible but reused/gone) — goes to the LRU/MRU-ordered picker. A
    // recognized reply that reached here KNEW an origin that's now gone (its pane
    // was reused by a different project), so it carries the gone notice; an
    // unrecognized reply never knew an origin, so no notice.
    return postReplyPicker(candidates, recognized ? goneNotice() : undefined)
  }

  // --- forum topics (docs/specs/tg-forum-topics.md §7, §8) ---
  // The binding store is read fresh on each access (like routes) and rewritten on every
  // transition. It is only consulted when control.topics is enabled; with the flag off the
  // store stays empty and topicStatusOf below is never wired into stepUpdates, so the flat
  // 1:1 path is byte-identical.
  const loadTopics = (): TopicBinding[] => parseTopics(readFileOrNull(ctx.paths.topics))
  const persistTopics = (topics: TopicBinding[]): void => {
    // Best-effort, off the inject path: a write error must never break the poll loop — it is
    // logged, not thrown. A lost close/reopen transition leaves the binding at its prior status
    // (e.g. still `bound` after a swallowed close), but that does NOT mis-route: handleTopicRoute
    // re-verifies the pane on the NEXT message and closes a binding whose pane is gone. So the
    // store self-heals on the next routed message rather than relying on another service message.
    try {
      writeFileSync(ctx.paths.topics, serializeTopics(topics), { mode: 0o600 })
    } catch (err) {
      log(`topics persist failed: ${err}`)
    }
  }
  // threadId → current binding status (or null when untracked) for stepUpdates' pure routing.
  const topicStatusOf = (threadId: number): TopicStatus | null => findTopic(loadTopics(), threadId)?.status ?? null
  // sendMessage threaded into a topic — all topic-originated daemon output MUST carry
  // message_thread_id or it lands in General (spec §3).
  const sendToTopic = (threadId: number, text: string): Promise<number | null> =>
    sendMessage(ctx, text, { message_thread_id: threadId })

  // Route an inbound message inside a BOUND topic into that topic's mapped pane. The
  // injectText is already wrapped by stepUpdates. Safety (mirrors handleReplyRoute's
  // routeMatchesPane defense): a tmux pane id is REUSED after kill-pane, so before injecting we
  // require (a) the pane still hosts an agent AND (b) — when the binding recorded a working
  // `path` (every spawn-created binding does) — the live pane's path still matches it, so a
  // DIFFERENT project's agent that inherited the old `%N` can never receive this topic's
  // message. Any failure marks the binding closed and reports into the topic; it NEVER falls
  // through to the flat discovered target (which would leak a topic message into a 1:1 agent).
  const handleTopicRoute = async (action: Extract<Action, { kind: "topic-route" }>): Promise<boolean> => {
    const topics = loadTopics()
    const binding = findTopic(topics, action.threadId)
    if (!binding || binding.status !== "bound" || !binding.paneId) {
      // stepUpdates only emits topic-route for a status it saw as 'bound'; a race that lost the
      // pane between the status read and here closes it rather than mis-routing.
      await sendToTopic(action.threadId, "this topic's agent is no longer bound — recreate the topic")
      return false
    }
    const { panes, procs } = snapshot()
    const pane = panes.find((p) => p.paneId === binding.paneId)
    if (!pane || findAgentInPane(pane, procs) === null) {
      // The agent's pane is genuinely GONE (closed / no agent there) → terminal. Mark the binding
      // closed (increment 2's re-spawn picks it up), tell the human, inject nothing.
      persistTopics(appendTopic(topics, markClosed(binding, Math.floor(Date.now() / 1000))))
      await sendToTopic(action.threadId, "this topic's agent has exited — recreate the topic to respawn it")
      return false
    }
    // The pane hosts an agent but its path no longer matches the binding's recorded project
    // (pane-id reuse guard). Treat this as NON-terminal and recoverable: a path mismatch can be a
    // tmux pane-id REUSE by another project's agent (must not inject — leak) BUT also a transient
    // empty pane_current_path read or the agent doing a legitimate `cd`. So SKIP this message
    // (never leak into a stranger) WITHOUT closing the binding — a true reuse keeps failing the
    // same way (no harm), while a transient/cd self-heals on the next message. (markClosed here
    // would irreversibly kill a still-live topic with no respawn path until increment 2.)
    if (binding.path !== undefined && !routeMatchesPane({ recognizedCwd: binding.path, panePath: pane.panePath })) {
      await sendToTopic(action.threadId, "this topic's agent pane can't be confirmed right now — try again")
      return false
    }
    if (shouldDeferInbound(binding.paneId)) {
      // The pane passed the same-project guard above, so we defer behind its open question /
      // backlog exactly like the flat path. KNOWN GAP (increment-2 hardening): the shared
      // deferred-flush drain re-verifies agent-presence but NOT panePath, so a kill-pane + id
      // reuse in the narrow enqueue→flush window could still flush into a stranger's pane. This
      // is a property of the shared flush mechanism (flat 1:1 shares it); tightening it means
      // teaching the flush drain about per-route project identity, deferred to the spawn increment.
      enqueueDeferred(binding.paneId, action.injectText)
      lastWasDeferred = true
      return true
    }
    const res = await executeInjectSteps(buildTextInjectPlan(binding.paneId, action.injectText))
    if (!res.ok) {
      await sendToTopic(action.threadId, res.error)
      return false
    }
    return true
  }

  // forum_topic_closed / reopened on a tracked topic → persist the status transition. The
  // binding is retained (closed keeps the path/model for a later re-spawn); reopen drops back
  // into the /new flow (increment 2 owns the actual re-attach/spawn).
  const handleTopicLifecycle = (action: Extract<Action, { kind: "topic-close" | "topic-reopen" }>): boolean => {
    const topics = loadTopics()
    const binding = findTopic(topics, action.threadId)
    if (!binding) return false // untracked — stepUpdates already filtered, defensive only
    const ts = Math.floor(Date.now() / 1000)
    const next = action.kind === "topic-close" ? markClosed(binding, ts) : markReopened(binding, ts)
    persistTopics(appendTopic(topics, next))
    return true
  }

  // --- forum-topics SPAWN executor (docs/specs/tg-forum-topics.md §5, increment 2) ---
  // The /new flow that creates a binding and launches a fresh agent into its own tmux window.
  // SAFETY (this is the CTO's daily lifeline daemon): every step is exception-guarded — a bad
  // path, a missing tmux, an unknown model, or a spawn error NEVER throws into the poll loop;
  // it logs, posts a human-readable error INTO the topic, and leaves the binding mid-flow so the
  // human can retry. The whole feature only runs when ctx.cfg.topics is on (the flag default-off
  // keeps 1:1 behaviour byte-identical), and the spawn refuses for an already-bound topic, so a
  // duplicate forum_topic_created or a daemon restart can never double-spawn into a live topic.

  // statSync throws on a broken symlink / EACCES — guard so a malformed path answer can never
  // bubble into the poll loop. A non-existent or non-directory path → false (re-ask the human).
  const isExistingDirectory = (path: string): boolean => {
    try {
      return statSync(path).isDirectory()
    } catch {
      return false
    }
  }

  // The tmux session to spawn the new window into: the configured pin, else the session a live
  // agent already runs in (so the new window lands beside the existing agents), else undefined
  // (tmux new-window without -t targets the current/only session). Best-effort, never throws.
  const sessionForSpawn = (): string | undefined => {
    if (ctx.cfg.session) return ctx.cfg.session
    const { panes, procs } = snapshot()
    for (const p of panes) {
      if (findAgentInPane(p, procs) !== null) return p.sessionName
    }
    return panes[0]?.sessionName
  }

  // Run `tmux new-window … -- <agent argv>` and return the created pane id, or an error.
  // -P -F '#{pane_id}' prints the new pane id on stdout → bound immediately (no discovery race,
  // spec §5). Fully guarded: a spawn throw (tmux missing) or a non-zero exit becomes a typed
  // error, never an exception. The path + argv are discrete argv elements (never shell-split),
  // so a directory with spaces is safe.
  const spawnTopicWindow = (windowSlug: string, path: string, model: string): { ok: true; paneId: string } | { ok: false; error: string } => {
    const argv = spawnArgv(model, path)
    if (!argv) return { ok: false, error: `unknown model \`${model}\` — pick a model again` }
    try {
      // sessionForSpawn() runs snapshot() (tmux list-panes / ps), which CAN throw if a binary is
      // missing — it MUST be inside this try, else the throw escapes the local guard, past
      // handleTopicModel, into the poll loop (exactly the "never throws" guarantee this defends).
      const session = sessionForSpawn()
      const tmuxArgv = [
        "tmux",
        "new-window",
        ...(session ? ["-t", session] : []),
        "-n",
        windowSlug,
        "-c",
        path,
        "-P",
        "-F",
        "#{pane_id}",
        "--",
        ...argv,
      ]
      const proc = Bun.spawnSync(tmuxArgv, { stdout: "pipe", stderr: "pipe", env: SUBPROC_ENV })
      if (proc.exitCode !== 0) {
        return { ok: false, error: `couldn't start the agent (tmux: ${proc.stderr.toString().trim() || `exit ${proc.exitCode}`})` }
      }
      const paneId = proc.stdout.toString().trim()
      if (!paneId) return { ok: false, error: "tmux did not return a pane id — agent not started" }
      return { ok: true, paneId }
    } catch (err) {
      return { ok: false, error: `couldn't start the agent (${err})` }
    }
  }

  // A new forum topic was created → begin the /new flow: persist an awaiting-path binding and
  // ask for the working directory (free-text path, per spec §5; the recent-repo button picker is
  // increment-4 polish). stepUpdates already filtered a duplicate create for an in-flight/bound
  // topic, so reaching here means an untracked or previously-closed topic; the createTopic upsert
  // resets it to awaiting-path either way (a fresh /new flow).
  const handleTopicNew = async (action: Extract<Action, { kind: "topic-new" }>): Promise<boolean> => {
    const topics = loadTopics()
    persistTopics(appendTopic(topics, createTopic(action.threadId, action.name, Math.floor(Date.now() / 1000))))
    await sendToTopic(
      action.threadId,
      "New agent for this topic. Which directory should it work in? Send an absolute path (e.g. /Users/you/project).",
    )
    return true
  }

  // Post the awaiting-model prompt with one inline button per catalog model. The callback data
  // (tgm:<threadId>:<modelId>) routes the tap back to handleTopicModel. Reused by handleTopicNew's
  // path step AND by a reopen that resumed at awaiting-model.
  const askTopicModel = (threadId: number): Promise<number | null> =>
    sendMessage(ctx, "Which model should this agent run?", {
      message_thread_id: threadId,
      reply_markup: { inline_keyboard: buildModelKeyboard(threadId, MODEL_CATALOG) },
    })

  // A user message inside an awaiting-* topic → the path answer. Validate the directory (must
  // exist + be a dir, spec §10) before advancing; a bad path re-asks WITHOUT advancing so the
  // human just resends. On a good path → awaiting-model + the model button prompt.
  const handleTopicAnswer = async (action: Extract<Action, { kind: "topic-answer" }>): Promise<boolean> => {
    const topics = loadTopics()
    const binding = findTopic(topics, action.threadId)
    if (!binding) return false // untracked — defensive (stepUpdates only emits for awaiting-*)
    if (binding.status === "awaiting-model") {
      // The model is chosen by BUTTON, not text — a stray message here just re-shows the buttons
      // rather than mis-reading prose as a model id.
      await askTopicModel(action.threadId)
      return true
    }
    const path = action.text.trim()
    // Require an ABSOLUTE path: isExistingDirectory (statSync) resolves a relative path against the
    // DAEMON's cwd, but `tmux new-window -c <path>` resolves it against the tmux SERVER's cwd — a
    // relative path could validate here yet spawn the agent in a different directory (or fail). An
    // absolute path resolves identically for both, so validation and spawn always see the same dir.
    if (!path || !isAbsolute(path) || !isExistingDirectory(path)) {
      await sendToTopic(action.threadId, `\`${path || "(empty)"}\` is not an absolute path to an existing directory — send a full path like /Users/you/project.`)
      return false
    }
    persistTopics(appendTopic(topics, applyPathAnswer(binding, path, Math.floor(Date.now() / 1000))))
    await askTopicModel(action.threadId)
    return true
  }

  // A model button tap → spawn the agent and bind the topic. Refuses a second spawn for an
  // already-bound topic (idempotency: a late/duplicate tap can't launch a second agent), and
  // re-asks on an unknown model id. On success the new pane is bound immediately and a
  // confirmation posts into the topic; on a spawn failure the binding stays awaiting-model so
  // the human can re-pick (no half-state, no crash).
  const handleTopicModel = async (action: Extract<Action, { kind: "topic-model" }>): Promise<boolean> => {
    // Answer the tap with a CONTEXT toast — not a blanket "starting…" that misleads on a refuse
    // branch (already-bound / wrong state / unknown model). Each early return answers its own.
    const topics = loadTopics()
    const binding = findTopic(topics, action.threadId)
    if (!binding) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "not in setup")
      await sendToTopic(action.threadId, "this topic isn't in setup — recreate it to spawn an agent")
      return false
    }
    if (binding.status === "bound") {
      // The model keyboard stays live after bind (clearing it is increment-4 polish), so a human
      // can tap it repeatedly. Answer ONLY the transient callback toast — NOT a fresh sendToTopic
      // per tap — so multi-tapping a dangling button can't flood the topic with messages.
      await answerCallbackQuery(ctx, action.callbackQueryId, "an agent is already running here")
      return false
    }
    if (binding.status !== "awaiting-model" || !binding.path) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "send a directory first")
      await sendToTopic(action.threadId, "send the working directory first, then pick a model")
      return false
    }
    // Validate the model id ONCE, up front (applyModelAnswer and spawnArgv both resolve against
    // MODEL_CATALOG — the single source of truth). An unknown id can only arrive via a stale/forged
    // callback (the keyboard emits valid ids); reject it BEFORE the "starting…" toast so the user
    // never sees "starting…" followed by "unknown model", and BEFORE persisting — so a bad id can't
    // strand the binding at awaiting-model with a model that spawn would forever reject.
    const ts = Math.floor(Date.now() / 1000)
    const withModel = applyModelAnswer(binding, action.modelId, ts)
    if (!withModel) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "unknown model")
      await sendToTopic(action.threadId, `unknown model \`${action.modelId}\` — pick a model again`)
      return false
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, "starting…")
    persistTopics(appendTopic(topics, withModel))
    const slug = slugifyTopicName(binding.name, action.threadId)
    const spawned = spawnTopicWindow(slug, binding.path, action.modelId)
    if (!spawned.ok) {
      // Leave the binding at awaiting-model (withModel) so a re-tap retries without losing the path.
      await sendToTopic(action.threadId, spawned.error)
      return false
    }
    persistTopics(appendTopic(loadTopics(), markBound(withModel, spawned.paneId, Math.floor(Date.now() / 1000))))
    await sendToTopic(action.threadId, `spawned \`${action.modelId}\` in \`${binding.path}\` (window \`${slug}\`) — send a message to talk to it`)
    return true
  }

  // getFile → /file/ download into ~/.cache/tg-cli/inbound under the daemon-
  // chosen name (never the Telegram basename, spec §5.2). Returns the local path
  // or null (already logged + replied). Shared by media + voice download. The
  // WHOLE body is exception-guarded: a getFile timeout, a non-JSON body, a
  // download read error or a disk-write failure THROWS otherwise, and since the
  // poll loop persists the offset BEFORE acting, an uncaught throw loses the note
  // permanently with no reply. Catch → "media download failed" → null.
  const downloadFileToCache = async (fileId: string, suggestedName: string): Promise<string | null> => {
    // Log each retry of a network step with its label, the file id, and the
    // attempt count — shared by both steps so the message format stays in sync.
    const retryLog = (step: string) => (i: RetryInfo) =>
      log(`${step} retry ${i.attempt}/${i.maxAttempts} for ${fileId} in ${i.delayMs}ms`)
    try {
      // BOTH network steps run under bounded retry-with-backoff (default 3
      // attempts, ~300ms→900ms→2.7s jittered) so a single transient blip —
      // dropped connection, 5xx, timeout — no longer silently loses the inbound
      // note. Worst case wall time per step ≈ maxAttempts·timeout + backoffs
      // (getFile ~30s/try, file bytes ~120s/try). retryFetch only retries a
      // thrown error / non-2xx HTTP; a 200-with-{ok:false} getFile body is a
      // PERMANENT Telegram error (e.g. file gone) and is handled below, not
      // retried — same for a final non-2xx from either step, which is returned
      // for the local `!resp.ok` checks rather than thrown.
      const getFile = () =>
        fetch(`${api(ctx)}/getFile?file_id=${encodeURIComponent(fileId)}`, {
          signal: AbortSignal.timeout(30_000),
        })
      const fileResp = await retryFetch(getFile, { onRetry: retryLog("getFile") })
      const fileJson = (await fileResp.json()) as { ok: boolean; result?: { file_path?: string } }
      const remotePath = fileJson.ok ? fileJson.result?.file_path : undefined
      if (!remotePath) {
        log(`getFile failed for ${fileId}`)
        await sendMessage(ctx, "media download failed")
        return null
      }
      const fetchBytes = () =>
        fetch(`${ctx.apiBase}/file/bot${ctx.token}/${remotePath}`, {
          signal: AbortSignal.timeout(120_000),
        })
      const dataResp = await retryFetch(fetchBytes, { onRetry: retryLog("file download") })
      if (!dataResp.ok) {
        log(`file download failed: HTTP ${dataResp.status} for ${fileId} after retries`)
        await sendMessage(ctx, "media download failed")
        return null
      }
      const dir = join(ctx.home, ".cache", "tg-cli", "inbound")
      mkdirSync(dir, { recursive: true })
      const dest = join(dir, suggestedName)
      writeFileSync(dest, new Uint8Array(await dataResp.arrayBuffer()))
      return dest
    } catch (err) {
      log(`media download error for ${fileId}: ${err}`)
      await sendMessage(ctx, "media download failed")
      return null
    }
  }

  const downloadMedia = async (action: Extract<Action, { kind: "download-media" }>): Promise<boolean> => {
    const dest = await downloadFileToCache(action.fileId, action.suggestedName)
    if (dest === null) return false
    const noun = action.mediaKind === "photo" ? "photo" : "file"
    const msg = `sent ${noun}: ${dest}` + (action.caption ? `\n${action.caption}` : "")
    const wrapped = wrapInbound(ctx.cfg.injectWrap, action.from, msg, action.messageId)
    // A non-reply photo/file → auto-bind to the last-active agent like a text msg.
    return injectViaTarget((paneId) => buildTextInjectPlan(paneId, wrapped), wrapped, true)
  }

  // Voice note → text (inbound STT). Unconfigured? Walk the user through setup
  // instead of dropping it (the CTO's "если не настроено — бот проводит через
  // настройку"). Otherwise: download OGG → ffmpeg WAV 16k mono → local Whisper →
  // clean → route EXACTLY like a typed message (reply-route when it was a reply,
  // else inject into the discovered pane). The 👀 ack still fires via the step's
  // trailing ack action when this returns true.
  const transcribeVoice = async (action: Extract<Action, { kind: "transcribe-voice" }>): Promise<boolean> => {
    // Reload the voice config from disk EVERY note: a `tg voice setup` run while
    // this daemon was already up must take effect without a restart. The parsed
    // PARTIAL is kept too, to tell "explicitly disabled" from "not configured".
    const rawYaml = readFileOrNull(join(ctx.configDir, "config.yaml")) ?? ""
    const voicePartial = parseVoiceConfig(rawYaml)
    ctx.voice = resolveVoiceConfig(voicePartial)

    // Master switch: an explicit `voice.enabled: false` means OFF — drop the
    // note silently (no onboarding, no re-enable). The documented opt-out must
    // survive a discoverable Whisper still being on the box.
    if (voicePartial.enabled === false) {
      log("voice note ignored — voice.enabled: false")
      return false
    }

    if (!voiceReady(ctx)) {
      // Not yet configured → auto-onboarding reply. No ack (the reply IS the
      // signal); returning false marks the action unhandled for the ack gate.
      const verdict = decideOnboarding(probeWhisper(ctx.home), ctx.voice.language)
      if (verdict.kind === "ready") {
        // We discovered a working install on the fly — persist it so the NEXT
        // voice note transcribes without re-prompting. But only CLAIM success if
        // the write actually landed: a read-only config.yaml would otherwise tell
        // the user "configured" while the next note loops back to onboarding.
        if (persistVoiceConfigToDir(ctx.configDir, verdict.cfg)) {
          ctx.voice = verdict.cfg
          await sendMessage(ctx, onboardingMessage(verdict))
        } else {
          await sendMessage(
            ctx,
            `🎙️ Found a local Whisper (${verdict.cfg.runner}, ${verdict.cfg.modelPath}) but could not save ` +
              `the config. Fix write permissions on ${join(ctx.configDir, "config.yaml")} and resend, or run \`tg voice setup\`.`,
          )
        }
      } else {
        await sendMessage(ctx, onboardingMessage(verdict))
      }
      return false
    }

    const dest = await downloadFileToCache(action.fileId, action.suggestedName)
    if (dest === null) return false

    const text = await runTranscription(ctx, dest)
    if (text === null) {
      await sendMessage(ctx, "voice transcription failed — see daemon log")
      return false
    }
    if (text.trim() === "") {
      await sendMessage(ctx, "voice note had no recognizable speech")
      return false
    }

    // Route exactly like a typed message, but present the transcript as a 🎤-marked
    // quote (formatVoiceTranscript) so the agent can tell it's transcribed speech, not
    // typed text: a reply note carries the quote anchor and goes through the SAME
    // reply-route path; a standalone note injects into the discovered pane.
    const quoted = formatVoiceTranscript(text)
    if (action.replyToMessageId !== undefined) {
      const injectText = `${action.replyAnchor ?? ""}\n${wrapInbound(
        ctx.cfg.injectWrap,
        action.from,
        quoted,
        action.messageId,
      )}`.replace(/^\n/, "")
      return handleReplyRoute({
        kind: "reply-route",
        replyToMessageId: action.replyToMessageId,
        injectText,
        from: action.from,
      })
    }
    const wrapped = wrapInbound(ctx.cfg.injectWrap, action.from, quoted, action.messageId)
    // A non-reply voice note → auto-bind to the last-active agent like a text msg.
    return injectViaTarget((paneId) => buildTextInjectPlan(paneId, wrapped), wrapped, true)
  }

  // Best-effort delivery receipt (spec §10): 👀 on the source message. A
  // failed reaction is logged and otherwise ignored — receipts must never
  // break the poll loop (e.g. a Bot API fake without the endpoint).
  const setReaction = async (messageId: number, emoji: string): Promise<void> => {
    try {
      const resp = await fetch(`${api(ctx)}/setMessageReaction`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          chat_id: ctx.chatId,
          message_id: messageId,
          reaction: [{ type: "emoji", emoji }],
        }),
        signal: AbortSignal.timeout(15_000),
      })
      if (!resp.ok) log(`setMessageReaction failed: ${resp.status}`)
    } catch (err) {
      log(`setMessageReaction failed: ${err}`)
    }
  }
  const setSeenReaction = (messageId: number): Promise<void> => setReaction(messageId, "👀")
  // ⏳ is NOT in Telegram's allowed reaction set; ✍️ ("noted, queued") is the
  // closest allowed emoji for "deferred behind the agent's open question".
  const DEFER_REACTION = "✍️"

  // Returns true when the action was handled successfully — the 'ack' case
  // reads the PREVIOUS action's verdict to decide whether the source message
  // earns its 👀 receipt (actions for one message are contiguous, ack last).
  let lastActionOk = true
  const executeAction = async (action: Action): Promise<boolean> => {
    switch (action.kind) {
      case "reply":
        await sendMessage(ctx, action.text)
        return true
      case "answer-callback":
        await answerCallbackQuery(ctx, action.callbackQueryId, action.text)
        return true
      case "answer-question": {
        const pending = pendingButtons.get(action.requestId)
        if (!pending) {
          await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
          return true
        }
        // A tap must come from THIS prompt's Telegram message: a stale tap on
        // an earlier prompt that reused the callback key must not answer this
        // one. Skipped only while sendMessage is still in flight (messageId
        // unknown) — that race is resolved in the tap's favor by design.
        if (
          pending.messageId !== null &&
          action.messageId !== null &&
          action.messageId !== pending.messageId
        ) {
          await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
          return true
        }
        const answer = resolveButtonCallback(pending.req, { requestId: action.requestId, value: action.value })
        if (answer.status !== "answered") {
          await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
          return true
        }
        pendingButtons.delete(action.requestId)
        activeButtonKeys.delete(action.requestId)
        clearTimeout(pending.timer)
        const finalText = `answered: ${answer.label}`
        if (pending.messageId === null) pending.finalText = finalText
        const output = formatAgentHookOutput(pending.req, answer)
        pending.socket.end(output === null ? "null\n" : `${JSON.stringify(output)}\n`)
        void answerCallbackQuery(ctx, action.callbackQueryId, "answered")
        if (pending.messageId !== null) void editMessageText(ctx, pending.messageId, finalText)
        // The agent is unblocked → deliver anything queued behind this question.
        // Fire-and-forget, but guard the promise: an error here must never become
        // an unhandled rejection that takes down the daemon.
        if (pending.req.paneId) {
          flushDeferred(pending.req.paneId).catch((err) => log(`flushDeferred error: ${err}`))
        }
        return true
      }
      case "status":
        await sendMessage(ctx, composeStatus(ctx))
        return true
      case "agent-route":
        return handleAgentRoute(action)
      case "agent-callback":
        return handleAgentCallback(action)
      case "inject-text":
        // A plain non-reply message → opt into the no-reply auto-bind (fix B).
        return injectViaTarget((paneId) => buildTextInjectPlan(paneId, action.text), action.text, true)
      case "reply-route":
        return handleReplyRoute(action)
      case "inject-key":
        return injectViaTarget((paneId) => buildKeyInjectPlan(paneId, action.key))
      case "kill-agent": {
        // /kill sends SIGINT — a DESTRUCTIVE verb. It must NOT auto-bind to a
        // guessed agent (killing the wrong one is unrecoverable); on an ambiguous
        // fleet it asks (the select-picker below) rather than the no-reply auto-bind
        // that resolves a harmless content inject. So this uses the base discover(),
        // not discoverForInject (tg-cli#75 review).
        const found = discover()
        if (!found.ok) {
          // Ambiguous /kill (several live agents) → show the live agents as a
          // select-only picker (buttons) instead of a plain-text candidate dump;
          // no-agent → the no-agent reply. (A tap on the picker hands back the
          // selector to re-issue against one agent — kill-on-tap is out of scope.)
          if (found.reason === "ambiguous") {
            await postSelectPicker(candidatesForPicker(found.candidates))
          } else {
            await replyNoAgent()
          }
          return false
        }
        if (found.target.agentPid === undefined) {
          await sendMessage(ctx, "agent pid unknown — not killed")
          return false
        }
        try {
          // SIGINT kills the interactive agent (~1s) — spec §5.2 reserves it
          // for the explicit /kill verb. /stop is the survivable Escape.
          process.kill(found.target.agentPid, "SIGINT")
          await sendMessage(ctx, "session killed — restore via `claude --resume`")
          return true
        } catch (err) {
          await sendMessage(ctx, `kill failed: ${err}`)
          return false
        }
      }
      case "download-media":
        return downloadMedia(action)
      case "transcribe-voice":
        return transcribeVoice(action)
      case "topic-route":
        return handleTopicRoute(action)
      case "topic-close":
      case "topic-reopen":
        return handleTopicLifecycle(action)
      case "topic-new":
        return handleTopicNew(action)
      case "topic-answer":
        return handleTopicAnswer(action)
      case "topic-model":
        return handleTopicModel(action)
      case "ack":
        if (lastWasDeferred) {
          lastWasDeferred = false
          await setReaction(action.messageId, DEFER_REACTION)
        } else if (lastActionOk) {
          await setSeenReaction(action.messageId)
        }
        return true
    }
  }

  // Publish the command menu once on startup, before entering the poll loop.
  // Best-effort — publishBotCommands swallows every failure so a Telegram
  // hiccup can never block routing.
  await publishBotCommands(ctx)

  log(`daemon up — pid ${process.pid}, bot ${ctx.botId}, offset ${offset}`)

  for (;;) {
    try {
      // Idle TTL first, so even an error-backoff loop eventually exits. A
      // newer registration file also counts as agent activity (the daemon may
      // have been retargeted while no pane was discoverable yet).
      const regMtime = fileMtimeMs(ctx.paths.registration)
      if (regMtime !== null && regMtime > lastAgentSeenMs) lastAgentSeenMs = regMtime
      discover()
      if (Date.now() - lastAgentSeenMs > ctx.cfg.idleExitMin * 60_000) {
        log(`no agent pane for ${ctx.cfg.idleExitMin} min — idle exit`)
        cleanExit(0)
      }

      const resp = await fetch(
        `${api(ctx)}/getUpdates?timeout=50&offset=${offset}&allowed_updates=${encodeURIComponent('["message","callback_query"]')}`,
        { signal: AbortSignal.timeout(60_000) },
      )
      if (resp.status === 409) {
        // Another consumer is long-polling this bot (other machine, or a
        // lingering server-side poll right after a restart) — the flock can't
        // prevent that. Back off 1,2,4…60s; warn ONCE per streak.
        consecutive409 += 1
        if (consecutive409 === 5 && !warned409) {
          warned409 = true
          log("5 consecutive 409s — another consumer is polling this bot")
          await sendMessage(ctx, "another consumer is polling this bot")
        }
        await Bun.sleep(Math.min(2 ** (consecutive409 - 1), 60) * 1000)
        continue
      }
      if (!resp.ok) {
        log(`getUpdates HTTP ${resp.status}: ${(await resp.text()).slice(0, 200)}`)
        await Bun.sleep(5000)
        continue
      }
      const json = (await resp.json()) as { ok: boolean; result?: TgUpdate[]; description?: string }
      if (!json.ok || !Array.isArray(json.result)) {
        log(`getUpdates API error: ${json.description ?? "malformed response"}`)
        await Bun.sleep(5000)
        continue
      }
      consecutive409 = 0
      warned409 = false

      const step = stepUpdates(json.result, {
        cfg: ctx.cfg,
        chatId: ctx.chatId,
        nowSec: Math.floor(Date.now() / 1000),
        currentOffset: offset,
        wrap: (name, msg, messageId) => wrapInbound(ctx.cfg.injectWrap, name, msg, messageId),
        // Local-time quote anchor for replies (item 3); pure module defaults to UTC.
        fmtTime: (s) => {
          const d = new Date(s * 1000)
          const p = (n: number): string => String(n).padStart(2, "0")
          return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`
        },
        // Forum-topics mode (spec §8). OFF by default: when ctx.cfg.topics is false stepUpdates
        // ignores message_thread_id and the flat 1:1 path is byte-identical to before. When on,
        // topicStatusOf reads the binding store so topic messages route per-topic.
        topicsEnabled: ctx.cfg.topics,
        topicStatusOf: ctx.cfg.topics ? topicStatusOf : undefined,
      })

      // At-most-once (spec §10): persist the offset BEFORE acting. A crash
      // mid-action loses the message (the human resends); a replay would
      // double-inject ghost prompts into a live agent session — strictly worse.
      if (step.newOffset !== offset) {
        offset = step.newOffset
        writeFileSync(ctx.paths.offset, `${offset}\n`)
      }
      if (step.skippedStale > 0) {
        await sendMessage(ctx, `skipped ${step.skippedStale} stale messages`)
      }

      // Persist inbound history for `tg replies` recall — every message the CTO
      // sent in this batch. Best-effort, off the inject path: a read/write error
      // here never blocks delivery. Stale + rejected senders are filtered the
      // same way stepUpdates does (inboundHistoryRecords). Only when the batch
      // carried messages — an empty 50s long-poll skips the walk.
      //
      // Pane stamping must match where the message ACTUALLY routes, else a reply
      // (which routes to its recognized ORIGIN pane, not the default target) would
      // be logged under the wrong pane and vanish from that pane's scoped recall.
      // `resolvePane` mirrors handleReplyRoute's recognition: a reply whose
      // replied-to id is in the routes map AND still maps to a live same-project
      // agent pane is stamped with that pane; everything else uses the default
      // discovered target.
      if (json.result.length > 0) {
        const found = discover()
        const targetPane = found.ok ? found.target.pane.paneId : null
        const histRoutes = parseRoutes(readFileOrNull(ctx.paths.routes))
        const resolvePane = (m: TgMessage): string | null => {
          const replyId = m.reply_to_message?.message_id
          if (replyId === undefined) return null
          // ONLY the kinds that actually reply-route (updates.ts): a text reply
          // whose body is NOT a /command, or a voice/audio reply. A photo/document
          // reply becomes download-media and injects into the DEFAULT target, so
          // origin-stamping it would disagree with delivery — leave it default.
          const isRoutedReply =
            (m.text !== undefined && !m.text.startsWith("/")) || m.voice !== undefined || m.audio !== undefined
          if (!isRoutedReply) return null
          const recognized = recognizeRoute(histRoutes, replyId)
          if (!recognized) return null
          const { panes, procs } = snapshot()
          const pane = panes.find((p) => p.paneId === recognized.paneId)
          const sameProject = routeMatchesPane({ recognizedCwd: recognized.cwd, panePath: pane?.panePath })
          if (pane && sameProject && findAgentInPane(pane, procs)) return recognized.paneId
          // Mirror handleReplyRoute's recognized-but-unconfirmed guard (HISTORY
          // STAMP ONLY — this return is the scoped-recall pane, NEVER an inject
          // target). When the origin pane is NOT visible (`!pane` — the launchd
          // empty/partial flake), the reply still BELONGS to its recognized origin
          // (the picker routes it there), so stamp it under the origin pane, NOT
          // the default discovered target (the registration's last-writer = the
          // WRONG pane). A genuinely reused/different-project VISIBLE pane (`pane`
          // present but failed the same-project/agent check above) falls back to
          // the default. The two recognized-but-unconfirmed paths intentionally
          // diverge: handleReplyRoute posts the picker (delivery), this stamps the
          // origin pane (attribution) — neither ever injects into an unconfirmed pane.
          return pane ? null : recognized.paneId
        }
        appendHistory(
          ctx.paths.history,
          inboundHistoryRecords(json.result, {
            chatId: ctx.chatId,
            allowedSenders: ctx.cfg.allowedSenders,
            pane: targetPane,
            nowSec: Math.floor(Date.now() / 1000),
            stalenessSec: ctx.cfg.stalenessSec,
            resolvePane,
          }),
        )
      }

      // STRICTLY SEQUENTIAL — one action fully completes (its persist + spawn) before the next
      // starts. The forum-topics no-double-spawn guarantee relies on this: two `topic-model` taps
      // in one batch are handled one-after-another, so the first reaches `bound` before the second's
      // bound-guard reads the store. Parallelizing this (Promise.all) would let both load
      // `awaiting-model` and both spawn — do NOT make action dispatch concurrent.
      for (const action of step.actions) {
        lastActionOk = await executeAction(action)
      }
    } catch (err) {
      // The daemon must survive anything — malformed updates, network
      // failures, tmux races. Log and back off.
      log(`poll loop error: ${err}`)
      await Bun.sleep(5000)
    }
  }
}

// --- CLI entrypoint (only runs when executed directly, not when imported) ---
if (import.meta.main) {
  const cmd = process.argv[2]
  // Bare invocation (no subcommand) prints HELP on stdout and exits 0 — it NEVER launches the
  // daemon (the shared service-management contract: a bare `<tool> <service>` is help, not run).
  if (!cmd || cmd === "-h" || cmd === "--help") {
    console.log(USAGE)
    process.exit(0)
  }
  if (!["start", "run", "stop", "status", "enable", "disable", "ask", "install-hooks", "voice-setup"].includes(cmd)) {
    console.error(USAGE)
    process.exit(1)
  }

  const home = process.env.HOME ?? "~"
  // install-hooks edits ~/.claude/settings.json only — no bot token needed.
  if (cmd === "install-hooks") {
    installHooks(home)
    process.exit(0)
  }
  // TG_CTL_CONFIG_DIR exists so tests can point a spawned daemon at a tmpdir. Resolve it to an
  // ABSOLUTE path: `enable` pins this dir into the launchd/systemd unit, and the OS launches the
  // login daemon from its own cwd (not the shell's) — a relative override would resolve against
  // the wrong directory and silently miss the .env it was enabled with. (The default branch is
  // already absolute, so this is a no-op there.)
  const configDir = resolve(process.env.TG_CTL_CONFIG_DIR || join(home, ".config", "tg-cli"))
  const fileEnv = loadEnv(join(configDir, ".env"))
  const env = { ...fileEnv, ...process.env }

  // voice-setup is a LOCAL probe + config write — no Telegram I/O, so it runs
  // before the bot-token gate (a user may set up voice before configuring creds).
  if (cmd === "voice-setup") {
    const configYaml = readFileOrNull(join(configDir, "config.yaml")) ?? ""
    const voiceCfg = resolveVoiceConfig(parseVoiceConfig(configYaml))
    const ok = runVoiceSetup({ configDir, home, language: voiceCfg.language })
    process.exit(ok ? 0 : 1)
  }

  const token = env.TG_BOT_TOKEN ?? ""
  const botId = botIdFromToken(token)
  if (cmd === "ask" && (!botId || !env.TG_CHAT_ID)) {
    process.exit(0)
  }
  if (!botId || !env.TG_CHAT_ID) {
    console.error(`Error: TG_BOT_TOKEN and TG_CHAT_ID must be set in ${join(configDir, ".env")}`)
    process.exit(1)
  }

  const configYaml = readFileOrNull(join(configDir, "config.yaml")) ?? ""
  const cfg = resolveControlConfig(parseControlConfig(configYaml))
  const voice = resolveVoiceConfig(parseVoiceConfig(configYaml))

  const ctx: Ctx = {
    configDir,
    paths: ctlPaths(configDir, botId),
    cfg,
    voice,
    token,
    chatId: Number(env.TG_CHAT_ID),
    apiBase: env.TG_API_BASE || "https://api.telegram.org",
    botId,
    home,
  }

  if (cmd === "start") {
    startLauncher(ctx, parseStartFlags(process.argv.slice(3)))
    process.exit(0)
  }
  if (cmd === "stop") {
    stopDaemon(ctx)
    process.exit(0)
  }
  if (cmd === "enable") {
    process.exit(enableAutostart(ctx, process.argv.includes("--dry-run")))
  }
  if (cmd === "disable") {
    process.exit(disableAutostart(ctx))
  }
  if (cmd === "status") {
    console.log(composeStatus(ctx))
    process.exit(0)
  }
  if (cmd === "ask") {
    await askDaemon(ctx)
    process.exit(0)
  }
  await runDaemon(ctx)
}
