// --- Pure helpers (exported for tests) ---

// Same .env shape `tg` reads (KEY=VALUE lines, # comments). Reimplemented
// locally on purpose: importing from ./tg would drag the entire sender module
// graph into the daemon for a 15-line parser.
export function loadEnv(filePath: string): Record<string, string> {
  const env: Record<string, string> = {}
  try {
    const lines = readFileSync(filePath, "utf8").split("\n")
    for (const line of lines) {
      const trimmed = line.trim()
      if (!trimmed || trimmed.startsWith("#")) continue
      const eq = trimmed.indexOf("=")
      if (eq === -1) continue
      const key = trimmed.slice(0, eq).trim()
      const value = trimmed.slice(eq + 1).trim()
      if (key) env[key] = value
    }
  } catch {
    // file doesn't exist — skip
  }
  return env
}

export interface StartFlags {
  paneId?: string
  cwd?: string
  session?: string
}

// `tg` passes `--pane ''` when TMUX_PANE is unset — empty values are skipped,
// not stored, so the registration never carries hollow fields.
export function parseStartFlags(args: string[]): StartFlags {
  const out: StartFlags = {}
  for (let i = 0; i < args.length; i++) {
    const value = args[i + 1]
    if (!value) continue
    if (args[i] === "--pane") {
      out.paneId = value
      i++
    } else if (args[i] === "--cwd") {
      out.cwd = value
      i++
    } else if (args[i] === "--session") {
      out.session = value
      i++
    }
  }
  return out
}

// Offset file content → next getUpdates offset. Malformed/absent → 0
// (Telegram treats 0 as "no confirmed updates yet").
export function readOffset(content: string | null): number {
  if (content === null) return 0
  const trimmed = content.trim()
  return /^\d+$/.test(trimmed) ? Number(trimmed) : 0
}

// One line per candidate so the ambiguity reply names realistic choices.
export function formatCandidates(candidates: TargetPane[]): string {
  return candidates
    .map((c) => `${c.pane.sessionName}:${c.pane.windowIndex} ${c.pane.paneId} (${c.agent}, ${c.pane.panePath})`)
    .join("\n")
}

// --- Effectful plumbing (only ever invoked from the import.meta.main block) ---

interface Ctx {
  configDir: string
  paths: CtlPaths
  cfg: ControlConfig
  token: string
  chatId: number
  apiBase: string
  botId: string
  home: string
}

function log(msg: string): void {
  console.error(`[${new Date().toISOString()}] ${msg}`)
}

function readFileOrNull(path: string): string | null {
  try {
    return readFileSync(path, "utf8")
  } catch {
    return null
  }
}

function fileMtimeMs(path: string): number | null {
  try {
    return statSync(path).mtimeMs
  } catch {
    return null
  }
}

function kill0(pid: number): boolean {
  try {
    process.kill(pid, 0)
    return true
  } catch {
    return false
  }
}

function api(ctx: Ctx): string {
  return `${ctx.apiBase}/bot${ctx.token}`
}

// Daemon-side Bot API call. Never throws and never exits — a failed notice
// must not take the poll loop down with it.
async function botPost(ctx: Ctx, method: string, body: unknown): Promise<Record<string, unknown> | null> {
  try {
    const resp = await fetch(`${api(ctx)}/${method}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
      signal: AbortSignal.timeout(15_000),
    })
    if (!resp.ok) {
      log(`${method} failed: ${resp.status} ${(await resp.text()).slice(0, 200)}`)
      return null
    }
    const json = (await resp.json()) as Record<string, unknown>
    return json && typeof json === "object" ? json : null
  } catch (err) {
    log(`${method} failed: ${err}`)
    return null
  }
}

async function sendMessage(ctx: Ctx, text: string, extra: Record<string, unknown> = {}): Promise<number | null> {
  const json = await botPost(ctx, "sendMessage", { chat_id: ctx.chatId, text, ...extra })
  const result = json?.result
  if (!result || typeof result !== "object") return null
  const messageId = (result as { message_id?: unknown }).message_id
  return typeof messageId === "number" ? messageId : null
}

async function answerCallbackQuery(ctx: Ctx, callbackQueryId: string, text: string): Promise<void> {
  await botPost(ctx, "answerCallbackQuery", { callback_query_id: callbackQueryId, text })
}

async function editMessageText(ctx: Ctx, messageId: number, text: string): Promise<void> {
  await botPost(ctx, "editMessageText", { chat_id: ctx.chatId, message_id: messageId, text })
}

// Tab separator — pane_current_path may contain spaces (see discover.ts).
const PANE_FORMAT =
  "#{session_name}\t#{window_index}\t#{pane_id}\t#{pane_pid}\t#{pane_current_command}\t#{pane_current_path}"

// tmux absent / no server / ps failure → empty snapshot, never a crash:
// discovery then degrades to the no-agent reply path.
function snapshot(): { panes: PaneInfo[]; procs: ProcInfo[] } {
  let panes: PaneInfo[] = []
  let procs: ProcInfo[] = []
  try {
    const tmux = Bun.spawnSync(["tmux", "list-panes", "-a", "-F", PANE_FORMAT], {
      stdout: "pipe",
      stderr: "pipe",
    })
    if (tmux.exitCode === 0) panes = parsePaneList(tmux.stdout.toString())
  } catch {
    // tmux binary missing
  }
  try {
    const ps = Bun.spawnSync(["ps", "-axo", "pid=,ppid=,command="], {
      stdout: "pipe",
      stderr: "pipe",
    })
    if (ps.exitCode === 0) procs = parseProcList(ps.stdout.toString())
  } catch {
    // ps missing — never on a supported platform
  }
  return { panes, procs }
}

function readRegistration(paths: CtlPaths): Registration | null {
  try {
    const parsed = JSON.parse(readFileSync(paths.registration, "utf8"))
    return parsed && typeof parsed === "object" ? (parsed as Registration) : null
  } catch {
    return null
  }
}

// Fresh discovery on every call — the registration file may have been
// rewritten by a newer `tg`/`tg-ctl start` since the last poll.
// An explicit `tg-ctl start --session X` (stored in the registration) outranks
// config.yaml's control.session: it is the fresher, more specific intent, and
// the auto-start path never sets it (tg passes only --pane/--cwd).
function discoverTarget(ctx: Ctx): DiscoverResult {
  const { panes, procs } = snapshot()
  const reg = readRegistration(ctx.paths)
  return pickTargetPane(panes, procs, reg, reg?.sessionName ?? ctx.cfg.session)
}

// All tmux panes that host an agent, as /agent selection candidates (item 1).
// Window names are fetched in a SEPARATE tmux call so the core PANE_FORMAT /
// parsePaneList (relied on by inject + q→buttons) stays untouched; a pane with
// no name falls back to its session name.
function listAgentCandidates(): AgentCandidate[] {
  const { panes, procs } = snapshot()
  const nameByPane = new Map<string, string>()
  try {
    const r = Bun.spawnSync(["tmux", "list-panes", "-a", "-F", "#{pane_id}\t#{window_name}"], {
      stdout: "pipe",
      stderr: "pipe",
    })
    if (r.exitCode === 0) {
      for (const line of r.stdout.toString().split("\n")) {
        const tab = line.indexOf("\t")
        if (tab > 0) nameByPane.set(line.slice(0, tab), line.slice(tab + 1).trim())
      }
    }
  } catch {
    // tmux missing — candidates will just use session names as window names
  }
  const out: AgentCandidate[] = []
  for (const pane of panes) {
    const found = findAgentInPane(pane, procs)
    if (!found) continue
    out.push({
      paneId: pane.paneId,
      sessionName: pane.sessionName,
      windowIndex: pane.windowIndex,
      windowName: nameByPane.get(pane.paneId) || pane.sessionName,
      agent: found.agent,
    })
  }
  return out
}

// Execute an InjectStep plan. verify-pane re-runs discovery on a CURRENT
// snapshot — the agent may have exited between picking the target and typing
// into it, and injecting into a bare shell would EXECUTE the text (spec §5.2).
async function executeInjectSteps(steps: InjectStep[]): Promise<{ ok: true } | { ok: false; error: string }> {
  for (const step of steps) {
    if (step.kind === "verify-pane") {
      const { panes, procs } = snapshot()
      const pane = panes.find((p) => p.paneId === step.paneId)
      if (!pane || findAgentInPane(pane, procs) === null) {
        return { ok: false, error: `pane ${step.paneId} no longer hosts an agent — message not injected` }
      }
    } else if (step.kind === "tmux") {
      const proc = Bun.spawnSync(step.argv, {
        stdin: step.stdin !== undefined ? new TextEncoder().encode(step.stdin) : undefined,
        stdout: "ignore",
        stderr: "pipe",
      })
      if (proc.exitCode !== 0) {
        return { ok: false, error: `${step.argv.join(" ")} failed: ${proc.stderr.toString().trim()}` }
      }
    } else {
      await Bun.sleep(step.ms)
    }
  }
  return { ok: true }
}

// Shared by `tg-ctl status` (CLI) and the /status command (TG reply). Works
// with no daemon running — everything is read from files + live discovery.
function composeStatus(ctx: Ctx): string {
  const pid = readPidFile(readFileOrNull(ctx.paths.pid))
  const alive = pidStatus(pid, kill0)
  const lines: string[] = [
    alive === "running"
      ? `tg-ctl: running (pid ${pid}) — bot ${ctx.botId}`
      : alive === "stale"
        ? `tg-ctl: not running (stale pidfile, pid ${pid}) — bot ${ctx.botId}`
        : `tg-ctl: not running — bot ${ctx.botId}`,
  ]
  const reg = readRegistration(ctx.paths)
  lines.push(
    reg
      ? `registration: pane ${reg.paneId ?? "?"}, cwd ${reg.cwd ?? "?"}` +
          (reg.sessionName ? `, session ${reg.sessionName}` : "")
      : "registration: none",
  )
  const found = discoverTarget(ctx)
  lines.push(
    found.ok
      ? `target: ${found.target.agent} in ${found.target.pane.sessionName}:${found.target.pane.windowIndex} ` +
          `${found.target.pane.paneId}` +
          (found.target.agentPid !== undefined ? ` (pid ${found.target.agentPid})` : "")
      : found.reason === "ambiguous"
        ? `target: ambiguous —\n${formatCandidates(found.candidates)}`
        : "target: no agent pane found",
  )
  const offsetMtime = fileMtimeMs(ctx.paths.offset)
  lines.push(
    offsetMtime === null
      ? "offset: none"
      : `offset: ${readOffset(readFileOrNull(ctx.paths.offset))} ` +
          `(file age ${Math.round((Date.now() - offsetMtime) / 1000)}s)`,
  )
  // Guide the user when q→buttons isn't wired (the hook is what forwards an
  // agent's question to Telegram — without it the feature is silently dead).
  const hooksRaw = readFileOrNull(join(ctx.home, ".claude", "settings.json"))
  let hooksOk = false
  if (hooksRaw) {
    try {
      hooksOk = claudeHooksInstalled(JSON.parse(hooksRaw), "tg-ctl ask")
    } catch {}
  }
  lines.push(
    hooksOk
      ? "q→buttons hooks: installed (Claude Code)"
      : "q→buttons hooks: NOT installed — run `tg-ctl install-hooks`",
  )
  return lines.join("\n")
}

// Idempotently install the q→buttons agent-question hooks into Claude Code's
// user settings (backing the file up first), then print guidance for the other
// harnesses. Pure JSON merge lives in features/tg-ctl/hook-install.ts.
function installHooks(home: string): void {
  const settingsPath = join(home, ".claude", "settings.json")
  const command = "tg-ctl ask"
  const raw = readFileOrNull(settingsPath)
  let existing: Record<string, unknown> = {}
  if (raw) {
    try {
      const parsed = JSON.parse(raw)
      if (parsed && typeof parsed === "object") existing = parsed as Record<string, unknown>
    } catch {
      console.error(`tg-ctl: ${settingsPath} is not valid JSON — fix or move it aside, then re-run`)
      process.exit(1)
    }
  }
  const { settings, changed } = withClaudeHooks(existing, command)
  if (!changed) {
    console.log("tg-ctl: Claude Code q→buttons hooks already installed — nothing to do.")
  } else {
    if (raw) {
      try {
        writeFileSync(`${settingsPath}.bak`, raw)
      } catch {}
    }
    mkdirSync(join(home, ".claude"), { recursive: true })
    writeFileSync(settingsPath, `${JSON.stringify(settings, null, 2)}\n`)
    console.log(`tg-ctl: installed Claude Code q→buttons hooks → ${settingsPath}` + (raw ? ` (backup: ${settingsPath}.bak)` : ""))
  }
  console.log("")
  console.log("Codex: add a PermissionRequest hook running `tg-ctl ask --agent codex`, then trust it via /hooks (manual, first run).")
  console.log("opencode: native — the bot subscribes to question/permission SSE events; no hook file needed.")
  console.log("Restart any running agent session so it loads the new hooks.")
}

// --- start: registration snapshot + detached daemon spawn, then exit ---

function startLauncher(ctx: Ctx, flags: StartFlags): void {
  mkdirSync(ctx.configDir, { recursive: true })
  // Registration is written synchronously EVEN IF the daemon already runs —
  // a fresh `tg` call re-targets a long-lived daemon at the current pane.
  const reg: Registration = { registeredAt: Math.floor(Date.now() / 1000) }
  if (flags.paneId) reg.paneId = flags.paneId
  if (flags.cwd) reg.cwd = flags.cwd
  if (flags.session) reg.sessionName = flags.session
  writeFileSync(ctx.paths.registration, JSON.stringify(reg))

  // No lock, no pipes (see header). The daemon flocks first and exits 0 if
  // another instance holds the bot, so double-starts are a cheap no-op.
  const logFd = openSync(ctx.paths.log, "a")
  const proc = Bun.spawn([process.execPath, import.meta.path, "run"], {
    detached: true,
    stdio: ["ignore", logFd, logFd],
  })
  proc.unref()
  closeSync(logFd) // the child holds its own dup
  console.log(`tg-ctl: daemon launch requested (bot ${ctx.botId}) — log: ${ctx.paths.log}`)
}

// --- stop / status ---

function stopDaemon(ctx: Ctx): void {
  const pid = readPidFile(readFileOrNull(ctx.paths.pid))
  const alive = pidStatus(pid, kill0)
  if (alive === "absent") {
    console.log("tg-ctl: not running")
    return
  }
  if (alive === "stale") {
    try {
      unlinkSync(ctx.paths.pid)
    } catch {}
    console.log(`tg-ctl: not running (cleaned stale pidfile, pid ${pid})`)
    return
  }
  try {
    process.kill(pid!, "SIGTERM")
  } catch (err) {
    console.error(`tg-ctl: SIGTERM failed for pid ${pid}: ${err}`)
    process.exit(1)
  }
  // Brief wait so `stop && status` doesn't race the dying daemon.
  for (let i = 0; i < 20 && kill0(pid!); i++) Bun.sleepSync(100)
  try {
    unlinkSync(ctx.paths.pid)
  } catch {}
  console.log(kill0(pid!) ? `tg-ctl: SIGTERM sent (pid ${pid}, still exiting)` : `tg-ctl: stopped (pid ${pid})`)
}

// --- hook/client handoff over a local Unix socket ---

const MAX_HOOK_REQUEST_BYTES = 64 * 1024

interface PendingButton {
  req: ButtonRequest
  socket: Socket
  messageId: number | null
  timer: ReturnType<typeof setTimeout>
  finalText?: string
}

function normalizeButtonRequest(value: unknown): ButtonRequest | null {
  if (!value || typeof value !== "object") return null
  const rec = value as Record<string, unknown>
  const requestId = typeof rec.requestId === "string" && rec.requestId ? rec.requestId : null
  const agent = typeof rec.agent === "string" ? rec.agent : null
  const kind = rec.kind === "question" || rec.kind === "permission" ? rec.kind : null
  const question = typeof rec.question === "string" && rec.question ? rec.question : null
  if (!requestId || !agent || !kind || !question) return null
  const options = Array.isArray(rec.options)
    ? rec.options
        .filter((o): o is Record<string, unknown> => Boolean(o) && typeof o === "object")
        .map((o) => {
          const label = typeof o.label === "string" ? o.label : ""
          const description = typeof o.description === "string" ? o.description : undefined
          return label ? (description ? { label, description } : { label }) : null
        })
        .filter((o): o is { label: string; description?: string } => o !== null)
    : undefined

  return {
    requestId,
    buttonId: typeof rec.buttonId === "string" ? rec.buttonId : undefined,
    paneId: typeof rec.paneId === "string" ? rec.paneId : undefined,
    cwd: typeof rec.cwd === "string" ? rec.cwd : undefined,
    sessionName: typeof rec.sessionName === "string" ? rec.sessionName : undefined,
    agent: agent as ButtonRequest["agent"],
    kind,
    question,
    title: typeof rec.title === "string" ? rec.title : undefined,
    options,
  }
}

function canForwardButtonRequest(req: ButtonRequest): boolean {
  if (questionCapability(req.agent) !== "buttons") return false
  return !(req.agent === "codex" && req.kind !== "permission")
}

function hookMatchesRegistration(ctx: Ctx, req: ButtonRequest): boolean {
  return registrationAllowsHook(readRegistration(ctx.paths), req, resolve)
}

function startHookServer(ctx: Ctx, pending: Map<string, PendingButton>, activeKeys: Set<string>): Server | null {
  try {
    try {
      unlinkSync(ctx.paths.socket)
    } catch {}
    const server = createServer((socket) => {
      socket.setEncoding("utf8")
      let raw = ""
      socket.on("data", (chunk) => {
        raw += chunk
        const newline = raw.indexOf("\n")
        if (newline === -1) {
          // A hook request is a single small JSON line; anything bigger is a
          // misbehaving client trying to grow the buffer forever.
          if (raw.length > MAX_HOOK_REQUEST_BYTES) socket.destroy()
          return
        }
        const line = raw.slice(0, newline).trim()
        raw = raw.slice(newline + 1)
        void handleHookSocketLine(ctx, pending, activeKeys, socket, line)
      })
    })
    server.on("error", (err) => {
      log(`hook socket failed: ${err}`)
    })
    server.listen(ctx.paths.socket, () => {
      // Owner-only: the socket answers with approved hook JSON, so other local
      // users must not be able to connect (the guard trusts client-sent fields).
      try {
        chmodSync(ctx.paths.socket, 0o600)
      } catch {}
    })
    return server
  } catch (err) {
    log(`hook socket failed: ${err}`)
    return null
  }
}

async function handleHookSocketLine(
  ctx: Ctx,
  pending: Map<string, PendingButton>,
  activeKeys: Set<string>,
  socket: Socket,
  line: string,
): Promise<void> {
  let req: ButtonRequest | null = null
  try {
    req = normalizeButtonRequest(JSON.parse(line))
  } catch {
    // malformed hook payload: let the local agent UI take over
  }
  if (!req) {
    socket.end("null\n")
    return
  }

  if (!hookMatchesRegistration(ctx, req)) {
    socket.end("null\n")
    return
  }

  if (!canForwardButtonRequest(req)) {
    socket.end("null\n")
    void sendMessage(
      ctx,
      `native question forwarding isn't available for \`${req.agent}\` — answer in the terminal`,
    )
    return
  }

  const pendingKey = callbackRequestId(req)
  if (activeKeys.has(pendingKey)) {
    socket.end("null\n")
    return
  }
  activeKeys.add(pendingKey)
  const entry: PendingButton = {
    req,
    socket,
    messageId: null,
    timer: undefined as unknown as ReturnType<typeof setTimeout>,
  }
  entry.timer = setTimeout(() => {
    if (pending.get(pendingKey) !== entry) return
    pending.delete(pendingKey)
    activeKeys.delete(pendingKey)
    if (entry.messageId !== null) void editMessageText(ctx, entry.messageId, "expired — answer in terminal")
    else entry.finalText = "expired — answer in terminal"
    socket.end("null\n")
  }, 110_000)
  pending.set(pendingKey, entry)

  let socketClosed = false
  socket.on("close", () => {
    socketClosed = true
    const current = pending.get(pendingKey)
    if (current !== entry) return
    clearTimeout(entry.timer)
    pending.delete(pendingKey)
    activeKeys.delete(pendingKey)
    if (entry.messageId !== null) void editMessageText(ctx, entry.messageId, "expired — answer in terminal")
    else entry.finalText = "expired — answer in terminal"
  })

  const payload = buildButtonMessage(ctx.chatId, req)
  const messageId = await sendMessage(ctx, payload.text, { reply_markup: payload.reply_markup })
  if (messageId === null) {
    if (pending.get(pendingKey) === entry) {
      pending.delete(pendingKey)
      activeKeys.delete(pendingKey)
      clearTimeout(entry.timer)
      if (!socketClosed) socket.end("null\n")
    }
    return
  }
  entry.messageId = messageId
  if (pending.get(pendingKey) !== entry || entry.finalText) {
    void editMessageText(ctx, messageId, entry.finalText ?? "expired — answer in terminal")
  }
}

// The agent kind the hook was installed for (`tg-ctl ask --agent codex`);
// defaults to claude. Decides how the raw payload is normalized + formatted.
function hookAgentFromArgv(): AgentKind {
  const i = process.argv.indexOf("--agent")
  const v = i >= 0 ? process.argv[i + 1] : undefined
  const known = ["claude", "codex", "opencode", "pi", "aider"]
  return (v && known.includes(v) ? v : "claude") as AgentKind
}

function tmuxSessionName(): string | undefined {
  if (!process.env.TMUX) return undefined
  try {
    const r = Bun.spawnSync(["tmux", "display-message", "-p", "#{session_name}"], { stdout: "pipe", stderr: "pipe" })
    if (r.exitCode === 0) return r.stdout.toString().trim() || undefined
  } catch {}
  return undefined
}

async function askDaemon(ctx: Ctx): Promise<void> {
  const input = await readStdinText()
  if (!input.trim()) return
  let payload: unknown
  try {
    payload = JSON.parse(input)
  } catch {
    return
  }
  // Normalize the harness's raw hook payload (or an already-normalized request)
  // into a ButtonRequest, filling routing fields from the hook process's own
  // env. null → unsupported shape; emit nothing so the local agent UI takes over.
  const env: HookEnv = {
    agent: hookAgentFromArgv(),
    paneId: process.env.TMUX_PANE || undefined,
    cwd: process.cwd(),
    sessionName: tmuxSessionName(),
  }
  const req = normalizeHookPayload(payload, env)
  if (!req) return
  const requestLine = JSON.stringify(req)

  const output = await new Promise<string | null>((resolve) => {
    const socket = createConnection(ctx.paths.socket)
    let raw = ""
    const timer = setTimeout(() => {
      socket.destroy()
      resolve(null)
    }, 120_000)
    socket.setEncoding("utf8")
    socket.on("connect", () => socket.write(requestLine + "\n"))
    socket.on("data", (chunk) => {
      raw += chunk
    })
    socket.on("error", () => {
      clearTimeout(timer)
      resolve(null)
    })
    socket.on("end", () => {
      clearTimeout(timer)
      resolve(raw.trim() || null)
    })
  })
  if (output && output !== "null") console.log(output)
}

async function readStdinText(): Promise<string> {
  return await new Promise((resolve, reject) => {
    let out = ""
    process.stdin.setEncoding("utf8")
    process.stdin.on("data", (chunk) => {
      out += chunk
    })
    process.stdin.on("end", () => resolve(out))
    process.stdin.on("error", reject)
  })
}

// --- run: the daemon itself ---

async function runDaemon(ctx: Ctx): Promise<never> {
  mkdirSync(ctx.configDir, { recursive: true })

  // flock FIRST (spec §6): bound to the open file description, released by the
  // kernel on ANY exit including SIGKILL. Neither Bun nor Node expose flock
  // and macOS has no flock(1), hence bun:ffi. The fd stays open for the
  // daemon's lifetime.
  const { dlopen, FFIType } = await import("bun:ffi")
  const lib = process.platform === "darwin" ? "libSystem.B.dylib" : "libc.so.6"
  const ffi = dlopen(lib, { flock: { args: [FFIType.i32, FFIType.i32], returns: FFIType.i32 } })
  const LOCK_EX_NB = 6 // LOCK_EX (2) | LOCK_NB (4)
  const lockFd = openSync(ctx.paths.lock, "w")
  if (ffi.symbols.flock(lockFd, LOCK_EX_NB) !== 0) {
    // Another daemon owns this bot — idempotent no-op (spec §6).
    process.exit(0)
  }

  writeFileSync(ctx.paths.pid, `${process.pid}\n`)
  const pendingButtons = new Map<string, PendingButton>()
  const activeButtonKeys = new Set<string>()
  // /agent (and unrecognized-reply) selection awaiting a button tap: token →
  // message + candidate list. `prewrapped` = inject the message verbatim (a reply
  // already carries its wrap/anchor) instead of wrapping it again.
  const pendingAgent = new Map<
    string,
    {
      message: string
      candidates: AgentCandidate[]
      messageId: number | null
      timer: ReturnType<typeof setTimeout>
      prewrapped?: boolean
    }
  >()
  let agentTokenSeq = 0
  // Inbound queued behind an agent's outstanding question (defer-while-waiting):
  // pane → already-wrapped texts, flushed when the question is answered. The
  // flag tells the trailing `ack` to mark the source message ⏳ instead of 👀.
  const deferredByPane = new Map<string, string[]>()
  let lastWasDeferred = false
  const paneHasPendingQuestion = (paneId: string): boolean => {
    for (const pb of pendingButtons.values()) if (pb.req.paneId && pb.req.paneId === paneId) return true
    return false
  }
  // Enqueue only — the caller sets lastWasDeferred when this came from a MESSAGE
  // action (which earns a ⏳ ack); a button-callback defer edits its prompt
  // instead and must NOT leak the flag onto the next message's ack.
  const enqueueDeferred = (paneId: string, wrappedText: string): void => {
    const q = deferredByPane.get(paneId)
    if (q) q.push(wrappedText)
    else deferredByPane.set(paneId, [wrappedText])
  }
  const flushDeferred = async (paneId: string): Promise<void> => {
    const queue = deferredByPane.get(paneId)
    if (!queue?.length) return
    deferredByPane.delete(paneId)
    // Let the agent consume the just-delivered answer before the next paste.
    await Bun.sleep(800)
    for (const text of queue) {
      const res = await executeInjectSteps(buildTextInjectPlan(paneId, text))
      if (!res.ok) log(`deferred flush into ${paneId} failed: ${res.error}`)
    }
  }
  let hookServer: Server | null = null
  const cleanExit = (code: number): never => {
    try {
      unlinkSync(ctx.paths.pid)
    } catch {}
    try {
      hookServer?.close()
    } catch {}
    try {
      unlinkSync(ctx.paths.socket)
    } catch {}
    process.exit(code)
  }
  process.on("SIGTERM", () => cleanExit(0))
  process.on("SIGINT", () => cleanExit(0))

  hookServer = startHookServer(ctx, pendingButtons, activeButtonKeys)

  if (ctx.cfg.transport === "channel") {
    log("transport 'channel' is reserved for v1.2+ — falling back to tmux")
  }

  let offset = readOffset(readFileOrNull(ctx.paths.offset))
  let lastAgentSeenMs = Date.now() // grace period from daemon start
  let consecutive409 = 0
  let warned409 = false

  const discover = (): DiscoverResult => {
    const result = discoverTarget(ctx)
    // Agent panes existing — even ambiguous ones — keep the daemon alive.
    if (result.ok || result.candidates.length > 0) lastAgentSeenMs = Date.now()
    return result
  }

  const replyNotFound = async (found: Extract<DiscoverResult, { ok: false }>): Promise<void> => {
    await sendMessage(
      ctx,
      found.reason === "ambiguous"
        ? `ambiguous target — candidates:\n${formatCandidates(found.candidates)}`
        : NO_AGENT_REPLY,
    )
  }

  // Pick a target, run the plan; every failure mode turns into a TG reply so
  // the human is never left wondering whether the message landed. Returns
  // true only when the plan actually executed — the caller uses it to decide
  // whether the source message earns its 👀 delivery receipt.
  const injectViaTarget = async (
    buildPlan: (paneId: string) => InjectStep[],
    deferText?: string,
  ): Promise<boolean> => {
    const found = discover()
    if (!found.ok) {
      await replyNotFound(found)
      return false
    }
    const paneId = found.target.pane.paneId
    // Defer a text message behind the pane's outstanding question (⏳); control
    // verbs (Escape, no deferText) always go through to interrupt it.
    if (deferText !== undefined && paneHasPendingQuestion(paneId)) {
      enqueueDeferred(paneId, deferText)
      lastWasDeferred = true
      return true
    }
    const result = await executeInjectSteps(buildPlan(paneId))
    if (!result.ok) {
      log(`inject aborted: ${result.error}`)
      await sendMessage(ctx, result.error)
      return false
    }
    return true
  }

  // Inject a wrapped message into ONE specific pane (the /agent target). The
  // plan's verify-pane step still re-checks the pane hosts an agent first.
  const injectToPane = async (
    paneId: string,
    from: string,
    msg: string,
  ): Promise<{ ok: boolean; error?: string; deferred?: boolean }> => {
    const wrapped = wrapInbound(ctx.cfg.injectWrap, from, msg)
    if (paneHasPendingQuestion(paneId)) {
      enqueueDeferred(paneId, wrapped)
      return { ok: true, deferred: true }
    }
    const res = await executeInjectSteps(buildTextInjectPlan(paneId, wrapped))
    return res.ok ? { ok: true } : { ok: false, error: res.error }
  }

  const routedReply = (windowName: string, agent: string, deferred?: boolean): string =>
    deferred ? `⏳ queued for ${windowName} · ${agent} (answering a question)` : `→ ${windowName} · ${agent}`

  // /agent routing (item 1): bare list, confident phonetic match → direct
  // inject, ambiguous / no-selector → session-grouped selection buttons.
  const handleAgentRoute = async (action: Extract<Action, { kind: "agent-route" }>): Promise<boolean> => {
    const candidates = listAgentCandidates()
    if (candidates.length === 0) {
      await sendMessage(ctx, NO_AGENT_REPLY)
      return false
    }
    if (!action.all.trim()) {
      const groups = groupBySession(candidates)
      const lines = groups.flatMap((g) => [`▸ ${g.session}`, ...g.candidates.map((c) => `   ${c.windowName} · ${c.agent}`)])
      await sendMessage(ctx, `agents (address with /agent <window> <message>):\n${lines.join("\n")}`)
      return true
    }

    let subset = candidates
    let message = action.all
    if (action.selector) {
      const m = matchWindows(action.selector, candidates)
      if (m.matches.length > 0) {
        if (!action.rest.trim()) {
          const names = m.matches.map((c) => c.windowName).join(", ")
          await sendMessage(ctx, `matched ${names} — add a message: /agent ${action.selector} <message>`)
          return true
        }
        if (m.confident) {
          const target = m.matches[0]
          const res = await injectToPane(target.paneId, action.from, action.rest)
          if (!res.ok) {
            await sendMessage(ctx, res.error ?? "inject failed")
            return false
          }
          if (res.deferred) lastWasDeferred = true
          await sendMessage(ctx, routedReply(target.windowName, target.agent, res.deferred))
          return true
        }
        subset = m.matches
        message = action.rest
      }
      // selector matched nothing → the whole text is the message, ask over all
    }

    if (subset.length === 1) {
      const target = subset[0]
      const res = await injectToPane(target.paneId, action.from, message)
      if (!res.ok) {
        await sendMessage(ctx, res.error ?? "inject failed")
        return false
      }
      if (res.deferred) lastWasDeferred = true
      await sendMessage(ctx, routedReply(target.windowName, target.agent, res.deferred))
      return true
    }

    const token = `a${++agentTokenSeq}`
    const payload = buildAgentSelectMessage(ctx.chatId, subset, token, message)
    const messageId = await sendMessage(ctx, payload.text, { reply_markup: payload.reply_markup })
    // Picker send failed (Telegram rejected / >4096-char list / network): do NOT
    // store a pending route it can never resolve, and do NOT earn a 👀 receipt.
    if (messageId === null) {
      await sendMessage(ctx, "couldn't post the agent picker — try a narrower /agent <window>")
      return false
    }
    const timer = setTimeout(() => pendingAgent.delete(token), 10 * 60_000)
    pendingAgent.set(token, { message, candidates: subset, messageId, timer })
    return true
  }

  const handleAgentCallback = async (action: Extract<Action, { kind: "agent-callback" }>): Promise<boolean> => {
    const pending = pendingAgent.get(action.token)
    if (!pending) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    // A tap must come from THIS prompt's Telegram message. After a restart
    // agentTokenSeq reuses tokens (a1, a2…), so a tap on an OLD prompt that
    // reused the token must not consume the new pending route (codex P2).
    if (pending.messageId !== null && action.messageId !== null && action.messageId !== pending.messageId) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    const target = pending.candidates[action.index]
    if (!target) {
      await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
      return true
    }
    pendingAgent.delete(action.token)
    clearTimeout(pending.timer)
    // A reply's pending text already carries its wrap/anchor → inject verbatim;
    // a /agent message is raw → wrap it. Both defer behind an open question. A
    // callback edits its own prompt, so it must NOT set lastWasDeferred.
    let res: { ok: boolean; error?: string; deferred?: boolean }
    if (pending.prewrapped) {
      if (paneHasPendingQuestion(target.paneId)) {
        enqueueDeferred(target.paneId, pending.message)
        res = { ok: true, deferred: true }
      } else {
        const r = await executeInjectSteps(buildTextInjectPlan(target.paneId, pending.message))
        res = r.ok ? { ok: true } : { ok: false, error: r.error }
      }
    } else {
      res = await injectToPane(target.paneId, action.from, pending.message)
    }
    await answerCallbackQuery(ctx, action.callbackQueryId, res.ok ? (res.deferred ? "queued" : "sent") : "failed")
    if (pending.messageId !== null) {
      void editMessageText(
        ctx,
        pending.messageId,
        res.ok ? routedReply(target.windowName, target.agent, res.deferred) : `inject failed: ${res.error ?? ""}`,
      )
    }
    return res.ok
  }

  // A reply: route to the recognized origin pane (routes map) or, when unknown,
  // a session-grouped picker ordered LRU/MRU. injectText already carries the
  // wrap + quote anchor, so it is injected verbatim everywhere here.
  const handleReplyRoute = async (action: Extract<Action, { kind: "reply-route" }>): Promise<boolean> => {
    const routes = parseRoutes(readFileOrNull(ctx.paths.routes))
    const recognized = recognizeRoute(routes, action.replyToMessageId)
    const injectVerbatim = async (paneId: string): Promise<boolean> => {
      if (paneHasPendingQuestion(paneId)) {
        enqueueDeferred(paneId, action.injectText)
        lastWasDeferred = true
        return true
      }
      const res = await executeInjectSteps(buildTextInjectPlan(paneId, action.injectText))
      if (!res.ok) {
        await sendMessage(ctx, res.error)
        return false
      }
      return true
    }

    if (recognized) {
      const { panes, procs } = snapshot()
      const pane = panes.find((p) => p.paneId === recognized.paneId)
      // Route to the origin pane ONLY if it still hosts an agent AND is still the
      // SAME project: a tmux pane id is reused after kill-pane, so a stale
      // message_id→%N map could otherwise inject a reply into a DIFFERENT
      // project's agent — leaking project A's reply into project B (review
      // --brainstorm finding). Validate cwd; on mismatch (or no recorded cwd for
      // an old route) fall through to the picker rather than risk mis-routing.
      const sameProject = recognized.cwd
        ? pane !== undefined && resolve(pane.panePath) === resolve(recognized.cwd)
        : false
      if (pane && sameProject && findAgentInPane(pane, procs)) return injectVerbatim(recognized.paneId)
      // recognized pane gone / reused / unverifiable → fall through to the picker
    }

    const candidates = listAgentCandidates()
    if (candidates.length === 0) {
      await sendMessage(ctx, NO_AGENT_REPLY)
      return false
    }
    if (candidates.length === 1) return injectVerbatim(candidates[0].paneId)

    // Unrecognized reply with several agents → picker ordered LRU/MRU.
    const usage = aggregateUsage(routes)
    const order = orderByLruMru(candidates.map((c) => c.paneId), usage)
    const byPane = new Map(candidates.map((c) => [c.paneId, c]))
    const sorted = order.map((pid) => byPane.get(pid)!).filter(Boolean)
    const token = `a${++agentTokenSeq}`
    // preserveOrder: keep the LRU/MRU ranking — groupBySession must not re-sort.
    const payload = buildAgentSelectMessage(ctx.chatId, sorted, token, action.injectText, true)
    const messageId = await sendMessage(ctx, payload.text, { reply_markup: payload.reply_markup })
    if (messageId === null) {
      await sendMessage(ctx, "couldn't post the reply picker")
      return false
    }
    const timer = setTimeout(() => pendingAgent.delete(token), 10 * 60_000)
    pendingAgent.set(token, { message: action.injectText, candidates: sorted, messageId, timer, prewrapped: true })
    return true
  }

  const downloadMedia = async (action: Extract<Action, { kind: "download-media" }>): Promise<boolean> => {
    // getFile resolves the file_id to a server path; the bytes come from the
    // /file/ endpoint. The local name is ALWAYS the daemon-chosen
    // suggestedName — never the Telegram-supplied basename (spec §5.2).
    const fileResp = await fetch(`${api(ctx)}/getFile?file_id=${encodeURIComponent(action.fileId)}`, {
      signal: AbortSignal.timeout(30_000),
    })
    const fileJson = (await fileResp.json()) as { ok: boolean; result?: { file_path?: string } }
    const remotePath = fileJson.ok ? fileJson.result?.file_path : undefined
    if (!remotePath) {
      log(`getFile failed for ${action.fileId}`)
      await sendMessage(ctx, "media download failed")
      return false
    }
    const dataResp = await fetch(`${ctx.apiBase}/file/bot${ctx.token}/${remotePath}`, {
      signal: AbortSignal.timeout(120_000),
    })
    if (!dataResp.ok) {
      log(`file download failed: HTTP ${dataResp.status}`)
      await sendMessage(ctx, "media download failed")
      return false
    }
    const dir = join(ctx.home, ".cache", "tg-cli", "inbound")
    mkdirSync(dir, { recursive: true })
    const dest = join(dir, action.suggestedName)
    writeFileSync(dest, new Uint8Array(await dataResp.arrayBuffer()))
    const noun = action.mediaKind === "photo" ? "photo" : "file"
    const msg = `sent ${noun}: ${dest}` + (action.caption ? `\n${action.caption}` : "")
    const wrapped = wrapInbound(ctx.cfg.injectWrap, action.from, msg)
    return injectViaTarget((paneId) => buildTextInjectPlan(paneId, wrapped), wrapped)
  }

  // Best-effort delivery receipt (spec §10): 👀 on the source message. A
  // failed reaction is logged and otherwise ignored — receipts must never
  // break the poll loop (e.g. a Bot API fake without the endpoint).
  const setReaction = async (messageId: number, emoji: string): Promise<void> => {
    try {
      const resp = await fetch(`${api(ctx)}/setMessageReaction`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          chat_id: ctx.chatId,
          message_id: messageId,
          reaction: [{ type: "emoji", emoji }],
        }),
        signal: AbortSignal.timeout(15_000),
      })
      if (!resp.ok) log(`setMessageReaction failed: ${resp.status}`)
    } catch (err) {
      log(`setMessageReaction failed: ${err}`)
    }
  }
  const setSeenReaction = (messageId: number): Promise<void> => setReaction(messageId, "👀")
  // ⏳ is NOT in Telegram's allowed reaction set; ✍️ ("noted, queued") is the
  // closest allowed emoji for "deferred behind the agent's open question".
  const DEFER_REACTION = "✍️"

  // Returns true when the action was handled successfully — the 'ack' case
  // reads the PREVIOUS action's verdict to decide whether the source message
  // earns its 👀 receipt (actions for one message are contiguous, ack last).
  let lastActionOk = true
  const executeAction = async (action: Action): Promise<boolean> => {
    switch (action.kind) {
      case "reply":
        await sendMessage(ctx, action.text)
        return true
      case "answer-callback":
        await answerCallbackQuery(ctx, action.callbackQueryId, action.text)
        return true
      case "answer-question": {
        const pending = pendingButtons.get(action.requestId)
        if (!pending) {
          await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
          return true
        }
        // A tap must come from THIS prompt's Telegram message: a stale tap on
        // an earlier prompt that reused the callback key must not answer this
        // one. Skipped only while sendMessage is still in flight (messageId
        // unknown) — that race is resolved in the tap's favor by design.
        if (
          pending.messageId !== null &&
          action.messageId !== null &&
          action.messageId !== pending.messageId
        ) {
          await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
          return true
        }
        const answer = resolveButtonCallback(pending.req, { requestId: action.requestId, value: action.value })
        if (answer.status !== "answered") {
          await answerCallbackQuery(ctx, action.callbackQueryId, "expired")
          return true
        }
        pendingButtons.delete(action.requestId)
        activeButtonKeys.delete(action.requestId)
        clearTimeout(pending.timer)
        const finalText = `answered: ${answer.label}`
        if (pending.messageId === null) pending.finalText = finalText
        const output = formatAgentHookOutput(pending.req, answer)
        pending.socket.end(output === null ? "null\n" : `${JSON.stringify(output)}\n`)
        void answerCallbackQuery(ctx, action.callbackQueryId, "answered")
        if (pending.messageId !== null) void editMessageText(ctx, pending.messageId, finalText)
        // The agent is unblocked → deliver anything queued behind this question.
        if (pending.req.paneId) void flushDeferred(pending.req.paneId)
        return true
      }
      case "status":
        await sendMessage(ctx, composeStatus(ctx))
        return true
      case "agent-route":
        return handleAgentRoute(action)
      case "agent-callback":
        return handleAgentCallback(action)
      case "inject-text":
        return injectViaTarget((paneId) => buildTextInjectPlan(paneId, action.text), action.text)
      case "reply-route":
        return handleReplyRoute(action)
      case "inject-key":
        return injectViaTarget((paneId) => buildKeyInjectPlan(paneId, action.key))
      case "kill-agent": {
        const found = discover()
        if (!found.ok) {
          await replyNotFound(found)
          return false
        }
        if (found.target.agentPid === undefined) {
          await sendMessage(ctx, "agent pid unknown — not killed")
          return false
        }
        try {
          // SIGINT kills the interactive agent (~1s) — spec §5.2 reserves it
          // for the explicit /kill verb. /stop is the survivable Escape.
          process.kill(found.target.agentPid, "SIGINT")
          await sendMessage(ctx, "session killed — restore via `claude --resume`")
          return true
        } catch (err) {
          await sendMessage(ctx, `kill failed: ${err}`)
          return false
        }
      }
      case "download-media":
        return downloadMedia(action)
      case "ack":
        if (lastWasDeferred) {
          lastWasDeferred = false
          await setReaction(action.messageId, DEFER_REACTION)
        } else if (lastActionOk) {
          await setSeenReaction(action.messageId)
        }
        return true
    }
  }

  log(`daemon up — pid ${process.pid}, bot ${ctx.botId}, offset ${offset}`)

  for (;;) {
    try {
      // Idle TTL first, so even an error-backoff loop eventually exits. A
      // newer registration file also counts as agent activity (the daemon may
      // have been retargeted while no pane was discoverable yet).
      const regMtime = fileMtimeMs(ctx.paths.registration)
      if (regMtime !== null && regMtime > lastAgentSeenMs) lastAgentSeenMs = regMtime
      discover()
      if (Date.now() - lastAgentSeenMs > ctx.cfg.idleExitMin * 60_000) {
        log(`no agent pane for ${ctx.cfg.idleExitMin} min — idle exit`)
        cleanExit(0)
      }

      const resp = await fetch(
        `${api(ctx)}/getUpdates?timeout=50&offset=${offset}&allowed_updates=${encodeURIComponent('["message","callback_query"]')}`,
        { signal: AbortSignal.timeout(60_000) },
      )
      if (resp.status === 409) {
        // Another consumer is long-polling this bot (other machine, or a
        // lingering server-side poll right after a restart) — the flock can't
        // prevent that. Back off 1,2,4…60s; warn ONCE per streak.
        consecutive409 += 1
        if (consecutive409 === 5 && !warned409) {
          warned409 = true
          log("5 consecutive 409s — another consumer is polling this bot")
          await sendMessage(ctx, "another consumer is polling this bot")
        }
        await Bun.sleep(Math.min(2 ** (consecutive409 - 1), 60) * 1000)
        continue
      }
      if (!resp.ok) {
        log(`getUpdates HTTP ${resp.status}: ${(await resp.text()).slice(0, 200)}`)
        await Bun.sleep(5000)
        continue
      }
      const json = (await resp.json()) as { ok: boolean; result?: TgUpdate[]; description?: string }
      if (!json.ok || !Array.isArray(json.result)) {
        log(`getUpdates API error: ${json.description ?? "malformed response"}`)
        await Bun.sleep(5000)
        continue
      }
      consecutive409 = 0
      warned409 = false

      const step = stepUpdates(json.result, {
        cfg: ctx.cfg,
        chatId: ctx.chatId,
        nowSec: Math.floor(Date.now() / 1000),
        currentOffset: offset,
        wrap: (name, msg) => wrapInbound(ctx.cfg.injectWrap, name, msg),
        // Local-time quote anchor for replies (item 3); pure module defaults to UTC.
        fmtTime: (s) => {
          const d = new Date(s * 1000)
          const p = (n: number): string => String(n).padStart(2, "0")
          return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`
        },
      })

      // At-most-once (spec §10): persist the offset BEFORE acting. A crash
      // mid-action loses the message (the human resends); a replay would
      // double-inject ghost prompts into a live agent session — strictly worse.
      if (step.newOffset !== offset) {
        offset = step.newOffset
        writeFileSync(ctx.paths.offset, `${offset}\n`)
      }
      if (step.skippedStale > 0) {
        await sendMessage(ctx, `skipped ${step.skippedStale} stale messages`)
      }
      for (const action of step.actions) {
        lastActionOk = await executeAction(action)
      }
    } catch (err) {
      // The daemon must survive anything — malformed updates, network
      // failures, tmux races. Log and back off.
      log(`poll loop error: ${err}`)
      await Bun.sleep(5000)
    }
  }
}

// --- CLI entrypoint (only runs when executed directly, not when imported) ---
if (import.meta.main) {
  const cmd = process.argv[2]
  if (cmd === "-h" || cmd === "--help") {
    console.log(USAGE)
    process.exit(0)
  }
  if (!cmd || !["start", "run", "stop", "status", "ask", "install-hooks"].includes(cmd)) {
    console.error(USAGE)
    process.exit(1)
  }

  const home = process.env.HOME ?? "~"
  // install-hooks edits ~/.claude/settings.json only — no bot token needed.
  if (cmd === "install-hooks") {
    installHooks(home)
    process.exit(0)
  }
  // TG_CTL_CONFIG_DIR exists so tests can point a spawned daemon at a tmpdir.
  const configDir = process.env.TG_CTL_CONFIG_DIR || join(home, ".config", "tg-cli")
  const fileEnv = loadEnv(join(configDir, ".env"))
  const env = { ...fileEnv, ...process.env }

  const token = env.TG_BOT_TOKEN ?? ""
  const botId = botIdFromToken(token)
  if (cmd === "ask" && (!botId || !env.TG_CHAT_ID)) {
    process.exit(0)
  }
  if (!botId || !env.TG_CHAT_ID) {
    console.error(`Error: TG_BOT_TOKEN and TG_CHAT_ID must be set in ${join(configDir, ".env")}`)
    process.exit(1)
  }

  const cfg = resolveControlConfig(parseControlConfig(readFileOrNull(join(configDir, "config.yaml")) ?? ""))

  const ctx: Ctx = {
    configDir,
    paths: ctlPaths(configDir, botId),
    cfg,
    token,
    chatId: Number(env.TG_CHAT_ID),
    apiBase: env.TG_API_BASE || "https://api.telegram.org",
    botId,
    home,
  }

  if (cmd === "start") {
    startLauncher(ctx, parseStartFlags(process.argv.slice(3)))
    process.exit(0)
  }
  if (cmd === "stop") {
    stopDaemon(ctx)
    process.exit(0)
  }
  if (cmd === "status") {
    console.log(composeStatus(ctx))
    process.exit(0)
  }
  if (cmd === "ask") {
    await askDaemon(ctx)
    process.exit(0)
  }
  await runDaemon(ctx)
}
