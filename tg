#!/usr/bin/env bun
import { readFileSync } from "fs"
import { join } from "path"

// --- Config loader ---
function loadEnv(filePath: string): Record<string, string> {
  const env: Record<string, string> = {}
  try {
    const lines = readFileSync(filePath, "utf8").split("\n")
    for (const line of lines) {
      const trimmed = line.trim()
      if (!trimmed || trimmed.startsWith("#")) continue
      const eq = trimmed.indexOf("=")
      if (eq === -1) continue
      const key = trimmed.slice(0, eq).trim()
      const value = trimmed.slice(eq + 1).trim()
      if (key) env[key] = value
    }
  } catch {
    // file doesn't exist — skip
  }
  return env
}

const configEnv = loadEnv(join(process.env.HOME ?? "~", ".config", "tg-cli", ".env"))
const env = { ...configEnv, ...process.env }

const BOT_TOKEN = env.TG_BOT_TOKEN
const CHAT_ID = env.TG_CHAT_ID

if (!BOT_TOKEN || !CHAT_ID) {
  console.error("Error: TG_BOT_TOKEN and TG_CHAT_ID must be set in ~/.config/tg-cli/.env")
  process.exit(1)
}

const API = `https://api.telegram.org/bot${BOT_TOKEN}`

// --- Arg parsing ---
interface Item {
  type: "photo" | "document"
  path: string
}

type Format = "plain" | "html"

const args = process.argv.slice(2)

const USAGE = `Usage:
  tg [--format plain|html] "text message"
  tg [--format plain|html] --photo screen.png
  tg [--format plain|html] --photo screen.png "caption"
  tg [--format plain|html] --file doc.pdf
  tg [--format plain|html] --file doc.pdf "caption"
  tg [--format plain|html] --photo a.png --photo b.png "caption"
  tg [--format plain|html] --file a.pdf --file b.pdf
  tg [--format plain|html] --photo a.png --file doc.pdf "caption"

Text escape handling:
  Message text and captions convert \\n, \\r, \\t, and \\\\ into real newlines,
  carriage returns, tabs, and backslashes. File paths are not decoded.

Formats:
  plain  Send text as-is. This is the default.
  html   Send with Telegram Bot API parse_mode=HTML.

HTML tags supported by Telegram Bot API:
  <b>, <strong>, <i>, <em>, <u>, <ins>, <s>, <strike>, <del>,
  <span class="tg-spoiler">, <tg-spoiler>, <a href="...">,
  <tg-emoji emoji-id="...">, <tg-time unix="..." format="...">,
  <code>, <pre>, <pre><code class="language-...">,
  <blockquote>, <blockquote expandable>

Only those HTML tags are supported. Escape raw <, >, and & outside tags as
&lt;, &gt;, and &amp;.
`

if (args.length === 0) {
  console.error(USAGE)
  process.exit(1)
}

if (args[0] === "--help" || args[0] === "-h") {
  console.log(USAGE)
  process.exit(0)
}

const items: Item[] = []
const textParts: string[] = []
let format: Format = "plain"

let i = 0
while (i < args.length) {
  const arg = args[i]
  if (arg === "--format") {
    const nextArg = args[i + 1]
    if (!nextArg || nextArg.startsWith("--")) {
      console.error("Error: --format requires plain or html")
      process.exit(1)
    }
    if (nextArg !== "plain" && nextArg !== "html") {
      console.error(`Error: unsupported format '${nextArg}'. Accepted values: plain, html`)
      process.exit(1)
    }
    format = nextArg
    i += 2
  } else if (arg === "--photo" || arg === "--file") {
    const nextArg = args[i + 1]
    if (!nextArg || nextArg.startsWith("--")) {
      console.error(`Error: ${arg} requires a file path argument`)
      process.exit(1)
    }
    items.push({ type: arg === "--photo" ? "photo" : "document", path: nextArg })
    i += 2
  } else {
    textParts.push(arg)
    i++
  }
}

function decodeTextEscapes(value: string): string {
  return value.replace(/\\([nrt\\])/g, (_match: string, escaped: string) => {
    if (escaped === "n") return "\n"
    if (escaped === "r") return "\r"
    if (escaped === "t") return "\t"
    return "\\"
  })
}

const caption = decodeTextEscapes(textParts.join(" "))

// --- AI model detection ---
function detectAiModel(): string {
  // 1. Explicit env var wins
  if (env.TG_AI_MODEL) return env.TG_AI_MODEL

  // 2. Try to extract from opencode config if available
  if (process.env.OPENCODE) {
    try {
      const result = Bun.spawnSync(["opencode", "debug", "config"], {
        stdout: "pipe",
        stderr: "pipe",
      })
      if (result.exitCode === 0) {
        const cfg = JSON.parse(new TextDecoder().decode(result.stdout))
        const providers = cfg.provider || {}
        for (const [_name, p] of Object.entries(providers)) {
          const prov = p as { models?: Record<string, unknown> }
          if (prov.models) {
            const ids = Object.keys(prov.models)
            if (ids.length === 1) return ids[0]
            // If multiple, prefer the one that looks like a router/default
            const router = ids.find((id) => id.includes("router"))
            if (router) return router
            return ids[0]
          }
        }
      }
    } catch {
      // ignore — opencode not available or config parse failed
    }
  }

  return ""
}

const MODEL = detectAiModel()

// --- AI emoji mapping ---
const MODEL_EMOJI_MAP: Record<string, string> = {
  claude: "🤖",
  gemini: "💎",
  codex: "📦",
  deepseek: "🔍",
  qwen: "🌟",
  kimi: "🌙",
  fireworks: "🎆",
  openai: "⚡",
  gpt: "⚡",
}

function detectAiEmoji(): string {
  // 1. Explicit env var wins
  if (env.TG_AI_EMOJI) return env.TG_AI_EMOJI

  // 2. Derive from detected model name
  if (MODEL) {
    const lower = MODEL.toLowerCase()
    for (const [key, emoji] of Object.entries(MODEL_EMOJI_MAP)) {
      if (lower.includes(key)) return emoji
    }
  }

  return "🗂"
}

const AI_EMOJI = detectAiEmoji()

// --- Tmux context ---
function getTmuxPrefix(): string {
  if (!process.env.TMUX) return ""
  try {
    const pane = process.env.TMUX_PANE
    const result = Bun.spawnSync(
      ["tmux", "display-message", "-p", "-t", pane, "#{window_name}"], {
      stdout: "pipe",
      stderr: "pipe",
    })
    if (result.exitCode === 0) {
      const name = new TextDecoder().decode(result.stdout).trim()
      if (name) return `[${name}]`
    }
  } catch {
    // ignore — tmux not available or not in a pane
  }
  return ""
}

const tmuxPrefix = getTmuxPrefix()

// --- Build final prefix ---
function buildPrefix(): string {
  const parts: string[] = []
  if (AI_EMOJI) parts.push(AI_EMOJI)
  if (tmuxPrefix) parts.push(tmuxPrefix)
  if (parts.length === 0) return ""
  return parts.join(" ") + "\n"
}

const prefix = buildPrefix()
const finalCaption = prefix + caption

// --- API calls ---
function parseModeFor(formatValue: Format): "HTML" | undefined {
  return formatValue === "html" ? "HTML" : undefined
}

async function checkResponse(resp: Response, method: string): Promise<void> {
  if (!resp.ok) {
    const body = await resp.text()
    console.error(`Telegram API error (${method}): ${resp.status} ${body}`)
    process.exit(1)
  }
  const json = await resp.json() as { ok: boolean; description?: string }
  if (!json.ok) {
    console.error(`Telegram API error (${method}): ${json.description ?? "unknown error"}`)
    process.exit(1)
  }
}

async function sendMessage(text: string, formatValue: Format): Promise<void> {
  const parseMode = parseModeFor(formatValue)
  const resp = await fetch(`${API}/sendMessage`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      chat_id: CHAT_ID,
      text,
      ...(parseMode ? { parse_mode: parseMode } : {}),
    }),
  })
  await checkResponse(resp, "sendMessage")
}

async function sendPhoto(filePath: string, cap: string | undefined, formatValue: Format): Promise<void> {
  const parseMode = parseModeFor(formatValue)
  const form = new FormData()
  form.append("chat_id", CHAT_ID)
  form.append("photo", Bun.file(filePath))
  if (cap) form.append("caption", cap)
  if (cap && parseMode) form.append("parse_mode", parseMode)
  const resp = await fetch(`${API}/sendPhoto`, { method: "POST", body: form })
  await checkResponse(resp, "sendPhoto")
}

async function sendDocument(filePath: string, cap: string | undefined, formatValue: Format): Promise<void> {
  const parseMode = parseModeFor(formatValue)
  const form = new FormData()
  form.append("chat_id", CHAT_ID)
  form.append("document", Bun.file(filePath))
  if (cap) form.append("caption", cap)
  if (cap && parseMode) form.append("parse_mode", parseMode)
  const resp = await fetch(`${API}/sendDocument`, { method: "POST", body: form })
  await checkResponse(resp, "sendDocument")
}

async function sendMediaGroup(mediaItems: Item[], cap: string | undefined, formatValue: Format): Promise<void> {
  const parseMode = parseModeFor(formatValue)
  const form = new FormData()
  form.append("chat_id", CHAT_ID)
  const mediaArr = mediaItems.map((item, idx) => ({
    type: item.type,
    media: `attach://file${idx}`,
    ...(idx === 0 && cap ? { caption: cap } : {}),
    ...(idx === 0 && cap && parseMode ? { parse_mode: parseMode } : {}),
  }))
  form.append("media", JSON.stringify(mediaArr))
  for (const [idx, item] of mediaItems.entries()) {
    form.append(`file${idx}`, Bun.file(item.path))
  }
  const resp = await fetch(`${API}/sendMediaGroup`, { method: "POST", body: form })
  await checkResponse(resp, "sendMediaGroup")
}

// --- Dispatch ---
if (items.length === 0) {
  if (!finalCaption) {
    console.error("Error: no message text provided")
    process.exit(1)
  }
  await sendMessage(finalCaption, format)
} else if (items.length === 1) {
  const item = items[0]
  if (item.type === "photo") {
    await sendPhoto(item.path, finalCaption || undefined, format)
  } else {
    await sendDocument(item.path, finalCaption || undefined, format)
  }
} else {
  await sendMediaGroup(items, finalCaption || undefined, format)
}
