function decodeTextEscapes(value: string): string {
  return value.replace(/\\([nrt\\])/g, (_match: string, escaped: string) => {
    if (escaped === "n") return "\n"
    if (escaped === "r") return "\r"
    if (escaped === "t") return "\t"
    return "\\"
  })
}

function isProcessRunning(name: string): boolean {
  try {
    const result = Bun.spawnSync(["pgrep", "-x", name], {
      stdout: "pipe",
      stderr: "pipe",
    })
    return result.exitCode === 0
  } catch {
    return false
  }
}

function extractBaseModel(modelName: string): string {
  const lower = modelName.toLowerCase()
  // Exact match first
  if (MODEL_EMOJI_MAP[lower]) return lower
  if (EMBEDDABLE_EMOJI_MAP[lower]) return lower
  // Try progressively shorter prefixes split by "-" or "_"
  const parts = lower.split(/[-_]/)
  for (let i = parts.length; i > 0; i--) {
    const prefix = parts.slice(0, i).join("-")
    if (MODEL_EMOJI_MAP[prefix]) return prefix
    if (EMBEDDABLE_EMOJI_MAP[prefix]) return prefix
  }
  return lower
}

// --- CLI entrypoint (only runs when executed directly, not when imported) ---
if (import.meta.main) {
  const rawArgs = process.argv.slice(2)
  const home = process.env.HOME ?? "~"

  // Resolve feature flags FIRST: pull --feature/--no-feature out of argv, load
  // ~/.config/tg-cli/config.yaml, and merge (default → config → CLI). The
  // result gates auto-attach. The transmitter safety nets (caption overflow +
  // 4096 split) are NOT a feature and always run.
  const flagResult = applyFeatureFlags(rawArgs)
  if (flagResult.error) {
    console.error(`Error: ${flagResult.error}`)
    console.error(USAGE)
    process.exit(1)
  }
  const featureConfig = (() => {
    try {
      return parseFeatureConfig(
        readFileSync(join(home, ".config", "tg-cli", "config.yaml"), "utf8"),
      )
    } catch {
      return {}
    }
  })()
  const features = resolveFeatures(featureConfig, {
    enable: flagResult.enable,
    disable: flagResult.disable,
  })
  const autoAttachOn = features["auto-attach"] !== false

  const args = flagResult.rest
  // Memoize the worktree-root enumeration: git is spawned at most once per
  // process, and only when a path-like token actually misses plain resolution
  // (parseArgs calls this thunk lazily inside the auto-attach scan).
  let worktreeRootsCache: string[] | null = null
  const getWorktreeRoots = (): string[] => {
    if (worktreeRootsCache === null) {
      worktreeRootsCache = enumerateWorktreeRoots(process.cwd(), runGitReal)
    }
    return worktreeRootsCache
  }
  const parsed = parseArgs(args, process.cwd(), home, autoAttachOn, getWorktreeRoots)

  // No-send actions resolve BEFORE the credential gate so help/version/info
  // flags work without Telegram credentials configured.
  if (parsed.action === "help") {
    console.log(USAGE)
    process.exit(0)
  }
  if (parsed.action === "version") {
    console.log(versionOutput(import.meta.dir))
    process.exit(0)
  }
  if (parsed.action === "error") {
    console.error(`Error: ${parsed.message}`)
    console.error(USAGE)
    process.exit(1)
  }

  const configEnv = loadEnv(join(home, ".config", "tg-cli", ".env"))
  const env = { ...configEnv, ...process.env }

  // Override embeddable emoji IDs with env vars if provided. Runs before any
  // info-flag handler so --ls-emoji-helpers reflects overrides + emits warnings.
  if (env.TG_EMOJI_IDS) {
    try {
      const parsedIds = JSON.parse(env.TG_EMOJI_IDS)
      if (parsedIds !== null && typeof parsedIds === "object" && !Array.isArray(parsedIds)) {
        for (const [model, id] of Object.entries(parsedIds)) {
          if (["__proto__", "constructor", "tostring", "valueof"].includes(model.toLowerCase())) {
            console.error(`Warning: Rejecting reserved key in TG_EMOJI_IDS: ${model}`)
            continue
          }
          if (typeof id === "string" && /^\d{19}$/.test(id)) {
            EMBEDDABLE_EMOJI_MAP[model] = id
          } else if (typeof id === "string") {
            console.error(`Warning: Ignoring invalid emoji ID in TG_EMOJI_IDS for ${model}: ${id} (expected 19 digits)`)
          } else {
            console.error(`Warning: Ignoring non-string emoji ID in TG_EMOJI_IDS for ${model}: ${id} (expected string)`)
          }
        }
      } else {
        console.error("Warning: TG_EMOJI_IDS must be a JSON object, not an array or primitive")
      }
    } catch {
      console.error("Warning: TG_EMOJI_IDS contains invalid JSON, using default emoji IDs")
    }
  }
  for (const [key, val] of Object.entries(env)) {
    if (key.startsWith("TG_EMOJI_ID_")) {
      const model = key.slice("TG_EMOJI_ID_".length).toLowerCase()
      if (model && !["__proto__", "constructor", "tostring", "valueof"].includes(model)) {
        if (val && /^\d{19}$/.test(val)) {
          EMBEDDABLE_EMOJI_MAP[model] = val
        } else {
          console.error(`Warning: Ignoring invalid emoji ID for ${model}: ${val} (expected 19 digits)`)
        }
      } else if (model && ["__proto__", "constructor", "tostring", "valueof"].includes(model)) {
        console.error(`Warning: Rejecting reserved key in TG_EMOJI_ID_${model}: ${val}`)
      }
    }
  }

  // --- AI model detection ---
  const detectAiModel = (): string => {
    // 1. Explicit env var wins
    if (env.TG_AI_MODEL) return env.TG_AI_MODEL

    // 1b. Claude Code sets CLAUDECODE=1 (and CLAUDE_CODE_* vars) in the agent's
    // environment. Check this BEFORE the pgrep fallbacks below: a background
    // `ollama` daemon (common on macOS) would otherwise be matched first and
    // mislabel a Claude Code session as ollama.
    if (env.CLAUDECODE || env.CLAUDE_CODE_ENTRYPOINT) return "claude"

    // 2. Opencode (current agent) — read model from config
    if (process.env.OPENCODE) {
      try {
        const result = Bun.spawnSync(["opencode", "debug", "config"], {
          stdout: "pipe",
          stderr: "pipe",
        })
        if (result.exitCode === 0) {
          const cfg = JSON.parse(new TextDecoder().decode(result.stdout))
          const providers = cfg.provider || {}
          for (const [_name, p] of Object.entries(providers)) {
            const prov = p as { models?: Record<string, unknown> }
            if (prov.models) {
              const ids = Object.keys(prov.models)
              if (ids.length === 1) {
                const fullId = ids[0]
                const shortName = fullId.includes('/') ? (fullId.split('/').pop() || fullId) : fullId
                return shortName
              }
              const router = ids.find((id) => id.includes("router"))
              if (router) {
                const shortName = router.includes('/') ? (router.split('/').pop() || router) : router
                return shortName
              }
              const first = ids[0]
              const shortName = first.includes('/') ? (first.split('/').pop() || first) : first
              return shortName
            }
          }
        }
      } catch {
        // ignore
      }
    }

    // 3. Detect Codex CLI (only via explicit env, not pgrep — codex is often background)
    if (process.env.CODEX) return "codex"
    // 3b. Detect other known CLI tools
    if (isProcessRunning("aider")) return "aider"
    if (isProcessRunning("cursor")) return "cursor"
    if (isProcessRunning("windsurf")) return "windsurf"
    if (isProcessRunning("llama")) return "llama"
    if (isProcessRunning("ollama")) return "ollama"
    if (isProcessRunning("opencode") || isProcessRunning("opencode.exe")) return "opencode"

    return ""
  }

  const MODEL = detectAiModel()

  const detectAiEmoji = (): string => {
    // 1. Explicit env var wins
    if (env.TG_AI_EMOJI) return env.TG_AI_EMOJI

    // 2. Derive from detected model name
    if (MODEL) {
      const base = extractBaseModel(MODEL)
      if (MODEL_EMOJI_MAP[base]) return MODEL_EMOJI_MAP[base]
      // Fallback to substring matching for partial matches
      for (const [key, emoji] of Object.entries(MODEL_EMOJI_MAP)) {
        if (base.includes(key)) return emoji
      }
    }

    return "🗂"
  }

  const AI_EMOJI = detectAiEmoji()

  // --- Emoji helpers listing ---
  const listEmojiHelpers = (): string => {
    const lines = [
      "Available emoji helpers:",
      "",
    ]
    for (const [key, emoji] of Object.entries(MODEL_EMOJI_MAP)) {
      const id = EMBEDDABLE_EMOJI_MAP[key]
      if (id) {
        lines.push(`  :${key}: → ${emoji} <tg-emoji emoji-id="${id}">`)
      } else {
        lines.push(`  :${key}: → ${emoji} (no emoji-id set — add TG_EMOJI_ID_${key})`)
      }
    }
    lines.push("")
    lines.push("Set emoji IDs via env vars:")
    lines.push("  TG_EMOJI_ID_claude=5274170649227600531")
    lines.push("  TG_EMOJI_IDS='{\"claude\":\"5274170649227600531\",\"codex\":\"5273797309195393626\"}'")
    return lines.join("\n")
  }

  // Info-only flags inspect local state and send nothing, so they must work
  // without Telegram credentials configured. Resolve them before the gate.
  if (parsed.action === "lsEmojiHelpers") {
    console.log(listEmojiHelpers())
    process.exit(0)
  }
  if (parsed.action === "detectModel") {
    console.log(`${MODEL || "(none)"}\t${AI_EMOJI || "(none)"}`)
    process.exit(0)
  }

  const BOT_TOKEN = env.TG_BOT_TOKEN
  const CHAT_ID = env.TG_CHAT_ID

  if (!BOT_TOKEN || !CHAT_ID) {
    console.error("Error: TG_BOT_TOKEN and TG_CHAT_ID must be set in ~/.config/tg-cli/.env")
    process.exit(1)
  }

  const API = `https://api.telegram.org/bot${BOT_TOKEN}`

  const parseEmojiHelpers = (text: string): ParsedText => {
    const entities: EmojiEntity[] = []
    let result = ""

    const regex = /:([a-zA-Z0-9_-]+):/g
    let match
    let lastIndex = 0

    while ((match = regex.exec(text)) !== null) {
      const [fullMatch, name] = match
      const lower = name.toLowerCase()
      const emojiId = EMBEDDABLE_EMOJI_MAP[lower]
      const unicodeEmoji = UNICODE_EMOJI_MAP[lower]

      // Append text before match
      result += text.slice(lastIndex, match.index)

      if (emojiId) {
        // Use placeholder emoji for entity
        const placeholder = unicodeEmoji || "🤖"
        entities.push({
          type: "custom_emoji",
          offset: result.length,
          length: placeholder.length,
          custom_emoji_id: emojiId,
        })
        result += placeholder
      } else if (unicodeEmoji) {
        result += unicodeEmoji
      } else {
        result += fullMatch
      }

      lastIndex = regex.lastIndex
    }

    // Append remaining text
    result += text.slice(lastIndex)

    return { text: result, entities }
  }

  // --- Tmux context ---
  const getTmuxPrefix = (): string => {
    if (!process.env.TMUX) return ""
    try {
      const pane = process.env.TMUX_PANE
      const result = Bun.spawnSync(
        ["tmux", "display-message", "-p", "-t", pane, "#{window_name}"], {
        stdout: "pipe",
        stderr: "pipe",
      })
      if (result.exitCode === 0) {
        const name = new TextDecoder().decode(result.stdout).trim()
        if (name) return `[${name}]`
      }
    } catch {
      // ignore — tmux not available or not in a pane
    }
    return ""
  }

  const tmuxPrefix = getTmuxPrefix()

  // --- Build prefix with custom emoji ---
  const buildPrefix = (): ParsedText => {
    const parts: string[] = []
    const entities: EmojiEntity[] = []
    let offset = 0

    if (AI_EMOJI) {
      // Convert AI_EMOJI (Unicode) to custom emoji if available
      const base = extractBaseModel(MODEL)
      let emojiId = EMBEDDABLE_EMOJI_MAP[base]
      // If not found by exact key, try substring matching
      if (!emojiId) {
        for (const [key, id] of Object.entries(EMBEDDABLE_EMOJI_MAP)) {
          if (base.includes(key)) {
            emojiId = id
            break
          }
        }
      }
      if (emojiId) {
        entities.push({
          type: "custom_emoji",
          offset: offset,
          length: AI_EMOJI.length,
          custom_emoji_id: emojiId,
        })
      }
      parts.push(AI_EMOJI)
      offset += AI_EMOJI.length
    }

    if (tmuxPrefix) {
      if (parts.length > 0) {
        parts.push(" ")
        offset += 1
      }
      parts.push(tmuxPrefix)
      offset += tmuxPrefix.length
    }

    if (parts.length === 0) return { text: "", entities: [] }
    parts.push("\n")
    return { text: parts.join(""), entities }
  }

  const { items, caption: rawCaption, format } = parsed
  const caption = decodeTextEscapes(rawCaption)

  // --- API calls ---
  const detectHtmlTags = (text: string): boolean => {
    const htmlPattern = /<(b|strong|i|em|u|ins|s|strike|del|span|tg-spoiler|a|tg-emoji|tg-time|code|pre|blockquote)\b/i
    return htmlPattern.test(text)
  }

  const parseModeFor = (formatValue: Format, text?: string): "HTML" | undefined => {
    if (formatValue === "html") return "HTML"
    if (text && detectHtmlTags(text)) return "HTML"
    return undefined
  }

  const escapeHtml = (s: string): string =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")

  // Render custom-emoji entities to inline <tg-emoji> tags.
  //   escape=false → the surrounding text is intentional HTML (user asked for
  //     --format html or wrote real tags); leave it verbatim.
  //   escape=true  → we are forcing HTML ONLY to carry the emoji; the
  //     surrounding text is plain, so escape &<> in the non-entity segments so
  //     literal characters can't break HTML parsing (regression guard).
  const convertEntitiesToHtml = (
    text: string,
    entities: EmojiEntity[],
    escape = false,
  ): string => {
    // Walk entities left-to-right, copying the gaps between them verbatim (or
    // HTML-escaped when `escape`) and inserting a <tg-emoji> tag for each.
    const asc = [...entities].sort((a, b) => a.offset - b.offset)
    let out = ""
    let cursor = 0
    for (const e of asc) {
      const gap = text.slice(cursor, e.offset)
      out += escape ? escapeHtml(gap) : gap
      const emoji = text.slice(e.offset, e.offset + e.length)
      out += `<tg-emoji emoji-id="${e.custom_emoji_id}">${emoji}</tg-emoji>`
      cursor = e.offset + e.length
    }
    const tail = text.slice(cursor)
    out += escape ? escapeHtml(tail) : tail
    return out
  }

  const checkResponse = async (resp: Response, method: string): Promise<void> => {
    if (!resp.ok) {
      const body = await resp.text()
      console.error(`Telegram API error (${method}): ${resp.status} ${body}`)
      process.exit(1)
    }
    const json = await resp.json() as { ok: boolean; description?: string }
    if (!json.ok) {
      console.error(`Telegram API error (${method}): ${json.description ?? "unknown error"}`)
      process.exit(1)
    }
  }

  const sendMessage = async (text: string, formatValue: Format, entities: EmojiEntity[]): Promise<void> => {
    const parseMode = parseModeFor(formatValue, text)
    let outText = text
    if (parseMode && entities.length > 0) {
      outText = convertEntitiesToHtml(text, entities)
    }
    const body: Record<string, unknown> = {
      chat_id: CHAT_ID,
      text: outText,
    }
    if (parseMode) {
      body.parse_mode = parseMode
    } else if (entities.length > 0) {
      body.entities = entities
    }
    const resp = await fetch(`${API}/sendMessage`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    })
    await checkResponse(resp, "sendMessage")
  }

  // Per-item photo/document sending now lives in the Transport below (the
  // transmitter calls those primitives). Custom-emoji entities are pre-rendered
  // to inline HTML before reaching the transmitter, so the send primitives deal
  // only in (string, format) — no entity arrays at this layer.

  // --- renderText hook: prefix + emoji → inline <tg-emoji> HTML ---
  // Pipeline order (forced, see normalize.ts): decode → extract(R2/R4) → THIS
  // hook on the surviving prose → assemble. Rendering AFTER extraction keeps
  // emoji-entity offsets valid (a strip would otherwise shift them) and avoids
  // substituting :helper: markers inside text we're about to remove.
  // --- Line-spec quotes + marker-injected copies (in-memory) ---
  // For each text-readable item that carried a trailing line-spec, build:
  //   - a TG quote of the referenced range ±2 (AST-aware) to insert directly
  //     below the path mention in the caption, and
  //   - an in-memory copy of the whole file with marker comments around the
  //     range, which REPLACES the disk source (never touches the original).
  // Images with a line-spec are attached as-is (no snippet/markers).
  const extOf = (p: string): string => {
    const dot = p.lastIndexOf(".")
    return dot === -1 ? "txt" : p.slice(dot + 1).toLowerCase()
  }
  const baseName = (p: string): string => p.slice(p.lastIndexOf("/") + 1)
  interface LineSpecRender {
    token: string
    quote: string
    injectedFor: string // disk path whose source should become the marked copy
    markedContent: string
    filename: string
  }
  const lineSpecRenders: LineSpecRender[] = []
  // Only treat KNOWN text extensions as snippet-able. A binary document with a
  // line-spec (e.g. report.pdf:12) would otherwise be read as UTF-8 — which
  // usually doesn't throw — and uploaded as a corrupted in-memory copy. For an
  // unlisted ext we skip the quote+marker entirely; the file still attaches
  // normally as its disk source and the token stays in the caption.
  const TEXT_EXTS = new Set([
    "ts", "tsx", "js", "jsx", "mjs", "cjs",
    "py", "json", "jsonc", "md", "markdown",
    "sh", "bash", "zsh", "html", "css", "scss",
    "yaml", "yml", "go", "rs", "txt", "csv",
    "log", "toml", "ini", "xml", "sql", "rb",
    "java", "c", "h", "cpp", "hpp", "swift", "kt",
  ])
  for (const it of items) {
    if (!it.lineSpec || it.type !== "document") continue
    const ext = extOf(it.path)
    if (!TEXT_EXTS.has(ext)) continue // binary/unknown → attach as-is, no snippet
    let source: string
    try {
      source = readFileSync(it.path, "utf8")
    } catch {
      continue // unreadable → skip the snippet, the file still attaches as-is
    }
    const ctx = extractContextRange(source, it.lineSpec.startLine, it.lineSpec.endLine, ext)
    lineSpecRenders.push({
      token: it.lineSpec.token,
      quote: renderQuote(ctx.text, ext),
      injectedFor: it.path,
      markedContent: injectMarkers(source, it.lineSpec.startLine, it.lineSpec.endLine, ext),
      filename: baseName(it.path),
    })
  }
  const hasQuotes = lineSpecRenders.length > 0

  // --- renderText hook: prefix + emoji → inline <tg-emoji> HTML ---
  // Pipeline order (forced, see normalize.ts): decode → extract(R2/R4) → THIS
  // hook on the surviving prose → assemble. Rendering AFTER extraction keeps
  // emoji-entity offsets valid (a strip would otherwise shift them) and avoids
  // substituting :helper: markers inside text we're about to remove. Line-spec
  // quotes are inserted AFTER this hook (anchored on the token) so the injected
  // <pre> can't flip the userHtml/escape decision below.
  const prefix = buildPrefix()
  const renderText = (stripped: string, fmt: Format): { text: string; format: Format } => {
    const parsedCaption = parseEmojiHelpers(stripped)
    const finalText = prefix.text + parsedCaption.text
    const finalEntities: EmojiEntity[] = [
      ...prefix.entities,
      ...parsedCaption.entities.map((e) => ({ ...e, offset: e.offset + prefix.text.length })),
    ]
    // The transmitter only deals in (string, format). Custom-emoji entities are
    // offset-based and would be invalidated by the >4096 splitter, so we render
    // them to inline <tg-emoji> HTML now. Emoji always live in the prefix
    // (message start), so they never straddle a split boundary.
    // "User HTML" = user asked for it or wrote real tags → leave verbatim.
    // "Forced HTML" = emoji present, OR we will inject line-spec quotes, but no
    // user HTML → escape the surrounding plain text (&<>) so literal characters
    // can't break parsing.
    const userHtml = fmt === "html" || detectHtmlTags(finalText)
    const renderToHtml = userHtml || finalEntities.length > 0 || hasQuotes
    if (!renderToHtml) return { text: finalText, format: "plain" }
    return {
      text: convertEntitiesToHtml(finalText, finalEntities, !userHtml),
      format: "html",
    }
  }

  // --- File contents for R2 (duplicated-paste detection) ---
  // Only DOCUMENT items, read from disk, size-capped — string-matching a binary
  // photo against pasted text is pointless and potentially huge.
  const R2_MAX_BYTES = 256 * 1024
  const fileContents = items
    .filter((it) => it.type === "document")
    .map((it) => {
      try {
        if (statSync(it.path).size > R2_MAX_BYTES) return null
        return { path: it.path, content: readFileSync(it.path, "utf8") }
      } catch {
        return null
      }
    })
    .filter((f): f is { path: string; content: string } => f !== null)

  // --- Build the SendPlan (normalization layer: R2/R3/R4 + render) ---
  const plan = buildSendPlan(items, caption, format, { fileContents, renderText })

  // --- Insert line-spec quotes (post-render) + swap in marker-injected copies.
  if (hasQuotes) {
    // Anchor each quote on the line that contains its (kept) path token, then
    // splice the quote in on the line directly below. Token-anchored, so it is
    // robust to length changes from emoji/HTML rendering above.
    if (plan.textMessages.length > 0) {
      let body = plan.textMessages[0].text
      for (const r of lineSpecRenders) {
        const lines = body.split("\n")
        // The render may have HTML-escaped the prose (forced HTML for the
        // quote), which also escapes &<> inside the token — so match both the
        // raw token and its escaped form.
        const escapedToken = escapeHtml(r.token)
        const idx = lines.findIndex((l) => l.includes(r.token) || l.includes(escapedToken))
        if (idx === -1) {
          // Token not found in the rendered text (shouldn't happen) → append.
          lines.push(r.quote)
        } else {
          lines.splice(idx + 1, 0, r.quote)
        }
        body = lines.join("\n")
      }
      // A quote is HTML, so the message must be sent as HTML.
      plan.textMessages[0] = { text: body, format: "html" }
    } else {
      // No prose survived but quotes exist → send the quotes as the message.
      plan.textMessages.push({
        text: lineSpecRenders.map((r) => r.quote).join("\n"),
        format: "html",
      })
    }
    // Replace each line-spec document's disk source with the in-memory
    // marker-injected copy (never modifies the original file on disk).
    for (const r of lineSpecRenders) {
      const doc = plan.documents.find(
        (d) => d.source.kind === "disk" && d.source.path === r.injectedFor,
      )
      if (doc) doc.source = { kind: "memory", filename: r.filename, content: r.markedContent }
    }
  }

  if (
    plan.photos.length === 0 &&
    plan.documents.length === 0 &&
    plan.textMessages.length === 0
  ) {
    console.error("Error: no message text provided")
    process.exit(1)
  }

  // --- Transport: the only place that talks to the Telegram API. ---
  // A SendItem source is either a real path (Bun.file) or in-memory content
  // (Blob), so R4 fragment files and marker-injected copies never touch disk.
  const blobFor = (item: SendItem): { body: Blob | ReturnType<typeof Bun.file>; name?: string } => {
    if (item.source.kind === "memory") {
      return { body: new Blob([item.source.content]), name: item.source.filename }
    }
    return { body: Bun.file(item.source.path) }
  }
  const transport: Transport = {
    sendMessage: (text, fmt) => sendMessage(text, fmt, []),
    sendPhoto: async (item, cap, fmt) => {
      const { body, name } = blobFor(item)
      const form = new FormData()
      form.append("chat_id", CHAT_ID)
      if (name) form.append("photo", body, name)
      else form.append("photo", body)
      const parseMode = parseModeFor(fmt, cap)
      if (cap) form.append("caption", cap)
      if (parseMode) form.append("parse_mode", parseMode)
      const resp = await fetch(`${API}/sendPhoto`, { method: "POST", body: form })
      await checkResponse(resp, "sendPhoto")
    },
    sendDocument: async (item, cap, fmt) => {
      const { body, name } = blobFor(item)
      const form = new FormData()
      form.append("chat_id", CHAT_ID)
      if (name) form.append("document", body, name)
      else form.append("document", body)
      const parseMode = parseModeFor(fmt, cap)
      if (cap) form.append("caption", cap)
      if (parseMode) form.append("parse_mode", parseMode)
      const resp = await fetch(`${API}/sendDocument`, { method: "POST", body: form })
      await checkResponse(resp, "sendDocument")
    },
    // Album send (FIX 2): 2..10 same-type items as a single Telegram media
    // group. Each item is uploaded as a multipart field and referenced from the
    // `media` JSON via `attach://<field>`. The caption (if any) rides the FIRST
    // InputMedia item — Telegram shows it as the album caption.
    sendMediaGroup: async (kind, mediaItems, cap, fmt) => {
      const form = new FormData()
      form.append("chat_id", CHAT_ID)
      const parseMode = parseModeFor(fmt, cap)
      const media = mediaItems.map((item, i) => {
        const { body, name } = blobFor(item)
        const field = `file${i}`
        // A memory item needs an explicit filename so Telegram keeps the ext;
        // a disk item is uploaded under a stable field name (its own name is
        // carried by Bun.file). attach:// binds the JSON entry to the field.
        if (name) form.append(field, body, name)
        else form.append(field, body)
        const entry: Record<string, string> = { type: kind, media: `attach://${field}` }
        if (i === 0 && cap) {
          entry.caption = cap
          if (parseMode) entry.parse_mode = parseMode
        }
        return entry
      })
      form.append("media", JSON.stringify(media))
      const resp = await fetch(`${API}/sendMediaGroup`, { method: "POST", body: form })
      await checkResponse(resp, "sendMediaGroup")
    },
  }

  // The transmitter applies caption-overflow + the >4096 split + the
  // photos→text→documents ordering, then calls the transport primitives.
  await transmit(plan, transport)

  // Reaching here means every send actually went through (checkResponse exits
  // the process on any API failure).
  console.log("OK")
}
