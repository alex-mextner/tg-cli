function decodeTextEscapes(value: string): string {
  return value.replace(/\\([nrt\\])/g, (_match: string, escaped: string) => {
    if (escaped === "n") return "\n"
    if (escaped === "r") return "\r"
    if (escaped === "t") return "\t"
    return "\\"
  })
}

function isProcessRunning(name: string): boolean {
  try {
    const result = Bun.spawnSync(["pgrep", "-x", name], {
      stdout: "pipe",
      stderr: "pipe",
    })
    return result.exitCode === 0
  } catch {
    return false
  }
}

function extractBaseModel(modelName: string): string {
  const lower = modelName.toLowerCase()
  // Exact match first
  if (MODEL_EMOJI_MAP[lower]) return lower
  if (EMBEDDABLE_EMOJI_MAP[lower]) return lower
  // Try progressively shorter prefixes split by "-" or "_"
  const parts = lower.split(/[-_]/)
  for (let i = parts.length; i > 0; i--) {
    const prefix = parts.slice(0, i).join("-")
    if (MODEL_EMOJI_MAP[prefix]) return prefix
    if (EMBEDDABLE_EMOJI_MAP[prefix]) return prefix
  }
  return lower
}

// --- CLI entrypoint (only runs when executed directly, not when imported) ---
if (import.meta.main) {
  const args = process.argv.slice(2)
  const home = process.env.HOME ?? "~"
  const parsed = parseArgs(args, process.cwd(), home)

  // No-send actions resolve BEFORE the credential gate so help/version/info
  // flags work without Telegram credentials configured.
  if (parsed.action === "help") {
    console.log(USAGE)
    process.exit(0)
  }
  if (parsed.action === "version") {
    console.log(versionOutput(import.meta.dir))
    process.exit(0)
  }
  if (parsed.action === "error") {
    console.error(`Error: ${parsed.message}`)
    console.error(USAGE)
    process.exit(1)
  }

  const configEnv = loadEnv(join(home, ".config", "tg-cli", ".env"))
  const env = { ...configEnv, ...process.env }

  // Override embeddable emoji IDs with env vars if provided. Runs before any
  // info-flag handler so --ls-emoji-helpers reflects overrides + emits warnings.
  if (env.TG_EMOJI_IDS) {
    try {
      const parsedIds = JSON.parse(env.TG_EMOJI_IDS)
      if (parsedIds !== null && typeof parsedIds === "object" && !Array.isArray(parsedIds)) {
        for (const [model, id] of Object.entries(parsedIds)) {
          if (["__proto__", "constructor", "tostring", "valueof"].includes(model.toLowerCase())) {
            console.error(`Warning: Rejecting reserved key in TG_EMOJI_IDS: ${model}`)
            continue
          }
          if (typeof id === "string" && /^\d{19}$/.test(id)) {
            EMBEDDABLE_EMOJI_MAP[model] = id
          } else if (typeof id === "string") {
            console.error(`Warning: Ignoring invalid emoji ID in TG_EMOJI_IDS for ${model}: ${id} (expected 19 digits)`)
          } else {
            console.error(`Warning: Ignoring non-string emoji ID in TG_EMOJI_IDS for ${model}: ${id} (expected string)`)
          }
        }
      } else {
        console.error("Warning: TG_EMOJI_IDS must be a JSON object, not an array or primitive")
      }
    } catch {
      console.error("Warning: TG_EMOJI_IDS contains invalid JSON, using default emoji IDs")
    }
  }
  for (const [key, val] of Object.entries(env)) {
    if (key.startsWith("TG_EMOJI_ID_")) {
      const model = key.slice("TG_EMOJI_ID_".length).toLowerCase()
      if (model && !["__proto__", "constructor", "tostring", "valueof"].includes(model)) {
        if (val && /^\d{19}$/.test(val)) {
          EMBEDDABLE_EMOJI_MAP[model] = val
        } else {
          console.error(`Warning: Ignoring invalid emoji ID for ${model}: ${val} (expected 19 digits)`)
        }
      } else if (model && ["__proto__", "constructor", "tostring", "valueof"].includes(model)) {
        console.error(`Warning: Rejecting reserved key in TG_EMOJI_ID_${model}: ${val}`)
      }
    }
  }

  // --- AI model detection ---
  const detectAiModel = (): string => {
    // 1. Explicit env var wins
    if (env.TG_AI_MODEL) return env.TG_AI_MODEL

    // 1b. Claude Code sets CLAUDECODE=1 (and CLAUDE_CODE_* vars) in the agent's
    // environment. Check this BEFORE the pgrep fallbacks below: a background
    // `ollama` daemon (common on macOS) would otherwise be matched first and
    // mislabel a Claude Code session as ollama.
    if (env.CLAUDECODE || env.CLAUDE_CODE_ENTRYPOINT) return "claude"

    // 2. Opencode (current agent) — read model from config
    if (process.env.OPENCODE) {
      try {
        const result = Bun.spawnSync(["opencode", "debug", "config"], {
          stdout: "pipe",
          stderr: "pipe",
        })
        if (result.exitCode === 0) {
          const cfg = JSON.parse(new TextDecoder().decode(result.stdout))
          const providers = cfg.provider || {}
          for (const [_name, p] of Object.entries(providers)) {
            const prov = p as { models?: Record<string, unknown> }
            if (prov.models) {
              const ids = Object.keys(prov.models)
              if (ids.length === 1) {
                const fullId = ids[0]
                const shortName = fullId.includes('/') ? (fullId.split('/').pop() || fullId) : fullId
                return shortName
              }
              const router = ids.find((id) => id.includes("router"))
              if (router) {
                const shortName = router.includes('/') ? (router.split('/').pop() || router) : router
                return shortName
              }
              const first = ids[0]
              const shortName = first.includes('/') ? (first.split('/').pop() || first) : first
              return shortName
            }
          }
        }
      } catch {
        // ignore
      }
    }

    // 3. Detect Codex CLI (only via explicit env, not pgrep — codex is often background)
    if (process.env.CODEX) return "codex"
    // 3b. Detect other known CLI tools
    if (isProcessRunning("aider")) return "aider"
    if (isProcessRunning("cursor")) return "cursor"
    if (isProcessRunning("windsurf")) return "windsurf"
    if (isProcessRunning("llama")) return "llama"
    if (isProcessRunning("ollama")) return "ollama"
    if (isProcessRunning("opencode") || isProcessRunning("opencode.exe")) return "opencode"

    return ""
  }

  const MODEL = detectAiModel()

  const detectAiEmoji = (): string => {
    // 1. Explicit env var wins
    if (env.TG_AI_EMOJI) return env.TG_AI_EMOJI

    // 2. Derive from detected model name
    if (MODEL) {
      const base = extractBaseModel(MODEL)
      if (MODEL_EMOJI_MAP[base]) return MODEL_EMOJI_MAP[base]
      // Fallback to substring matching for partial matches
      for (const [key, emoji] of Object.entries(MODEL_EMOJI_MAP)) {
        if (base.includes(key)) return emoji
      }
    }

    return "🗂"
  }

  const AI_EMOJI = detectAiEmoji()

  // --- Emoji helpers listing ---
  const listEmojiHelpers = (): string => {
    const lines = [
      "Available emoji helpers:",
      "",
    ]
    for (const [key, emoji] of Object.entries(MODEL_EMOJI_MAP)) {
      const id = EMBEDDABLE_EMOJI_MAP[key]
      if (id) {
        lines.push(`  :${key}: → ${emoji} <tg-emoji emoji-id="${id}">`)
      } else {
        lines.push(`  :${key}: → ${emoji} (no emoji-id set — add TG_EMOJI_ID_${key})`)
      }
    }
    lines.push("")
    lines.push("Set emoji IDs via env vars:")
    lines.push("  TG_EMOJI_ID_claude=5274170649227600531")
    lines.push("  TG_EMOJI_IDS='{\"claude\":\"5274170649227600531\",\"codex\":\"5273797309195393626\"}'")
    return lines.join("\n")
  }

  // Info-only flags inspect local state and send nothing, so they must work
  // without Telegram credentials configured. Resolve them before the gate.
  if (parsed.action === "lsEmojiHelpers") {
    console.log(listEmojiHelpers())
    process.exit(0)
  }
  if (parsed.action === "detectModel") {
    console.log(`${MODEL || "(none)"}\t${AI_EMOJI || "(none)"}`)
    process.exit(0)
  }

  const BOT_TOKEN = env.TG_BOT_TOKEN
  const CHAT_ID = env.TG_CHAT_ID

  if (!BOT_TOKEN || !CHAT_ID) {
    console.error("Error: TG_BOT_TOKEN and TG_CHAT_ID must be set in ~/.config/tg-cli/.env")
    process.exit(1)
  }

  const API = `https://api.telegram.org/bot${BOT_TOKEN}`

  const parseEmojiHelpers = (text: string): ParsedText => {
    const entities: EmojiEntity[] = []
    let result = ""

    const regex = /:([a-zA-Z0-9_-]+):/g
    let match
    let lastIndex = 0

    while ((match = regex.exec(text)) !== null) {
      const [fullMatch, name] = match
      const lower = name.toLowerCase()
      const emojiId = EMBEDDABLE_EMOJI_MAP[lower]
      const unicodeEmoji = UNICODE_EMOJI_MAP[lower]

      // Append text before match
      result += text.slice(lastIndex, match.index)

      if (emojiId) {
        // Use placeholder emoji for entity
        const placeholder = unicodeEmoji || "🤖"
        entities.push({
          type: "custom_emoji",
          offset: result.length,
          length: placeholder.length,
          custom_emoji_id: emojiId,
        })
        result += placeholder
      } else if (unicodeEmoji) {
        result += unicodeEmoji
      } else {
        result += fullMatch
      }

      lastIndex = regex.lastIndex
    }

    // Append remaining text
    result += text.slice(lastIndex)

    return { text: result, entities }
  }

  // --- Tmux context ---
  const getTmuxPrefix = (): string => {
    if (!process.env.TMUX) return ""
    try {
      const pane = process.env.TMUX_PANE
      const result = Bun.spawnSync(
        ["tmux", "display-message", "-p", "-t", pane, "#{window_name}"], {
        stdout: "pipe",
        stderr: "pipe",
      })
      if (result.exitCode === 0) {
        const name = new TextDecoder().decode(result.stdout).trim()
        if (name) return `[${name}]`
      }
    } catch {
      // ignore — tmux not available or not in a pane
    }
    return ""
  }

  const tmuxPrefix = getTmuxPrefix()

  // --- Build prefix with custom emoji ---
  const buildPrefix = (): ParsedText => {
    const parts: string[] = []
    const entities: EmojiEntity[] = []
    let offset = 0

    if (AI_EMOJI) {
      // Convert AI_EMOJI (Unicode) to custom emoji if available
      const base = extractBaseModel(MODEL)
      let emojiId = EMBEDDABLE_EMOJI_MAP[base]
      // If not found by exact key, try substring matching
      if (!emojiId) {
        for (const [key, id] of Object.entries(EMBEDDABLE_EMOJI_MAP)) {
          if (base.includes(key)) {
            emojiId = id
            break
          }
        }
      }
      if (emojiId) {
        entities.push({
          type: "custom_emoji",
          offset: offset,
          length: AI_EMOJI.length,
          custom_emoji_id: emojiId,
        })
      }
      parts.push(AI_EMOJI)
      offset += AI_EMOJI.length
    }

    if (tmuxPrefix) {
      if (parts.length > 0) {
        parts.push(" ")
        offset += 1
      }
      parts.push(tmuxPrefix)
      offset += tmuxPrefix.length
    }

    if (parts.length === 0) return { text: "", entities: [] }
    parts.push("\n")
    return { text: parts.join(""), entities }
  }

  const { items, caption: rawCaption, format } = parsed
  const caption = decodeTextEscapes(rawCaption)

  const prefix = buildPrefix()

  // Combine prefix + caption with correct offsets
  const parsedCaption = parseEmojiHelpers(caption)
  const finalText = prefix.text + parsedCaption.text
  const finalEntities: EmojiEntity[] = [
    ...prefix.entities,
    ...parsedCaption.entities.map((e) => ({
      ...e,
      offset: e.offset + prefix.text.length,
    })),
  ]

  // --- API calls ---
  const detectHtmlTags = (text: string): boolean => {
    const htmlPattern = /<(b|strong|i|em|u|ins|s|strike|del|span|tg-spoiler|a|tg-emoji|tg-time|code|pre|blockquote)\b/i
    return htmlPattern.test(text)
  }

  const parseModeFor = (formatValue: Format, text?: string): "HTML" | undefined => {
    if (formatValue === "html") return "HTML"
    if (text && detectHtmlTags(text)) return "HTML"
    return undefined
  }

  const convertEntitiesToHtml = (text: string, entities: EmojiEntity[]): string => {
    // Sort by offset descending to replace from end to start without invalidating offsets
    const sorted = [...entities].sort((a, b) => b.offset - a.offset)
    let result = text
    for (const entity of sorted) {
      const emoji = result.slice(entity.offset, entity.offset + entity.length)
      const replacement = `<tg-emoji emoji-id="${entity.custom_emoji_id}">${emoji}</tg-emoji>`
      result = result.slice(0, entity.offset) + replacement + result.slice(entity.offset + entity.length)
    }
    return result
  }

  const checkResponse = async (resp: Response, method: string): Promise<void> => {
    if (!resp.ok) {
      const body = await resp.text()
      console.error(`Telegram API error (${method}): ${resp.status} ${body}`)
      process.exit(1)
    }
    const json = await resp.json() as { ok: boolean; description?: string }
    if (!json.ok) {
      console.error(`Telegram API error (${method}): ${json.description ?? "unknown error"}`)
      process.exit(1)
    }
  }

  const sendMessage = async (text: string, formatValue: Format, entities: EmojiEntity[]): Promise<void> => {
    const parseMode = parseModeFor(formatValue, text)
    let outText = text
    if (parseMode && entities.length > 0) {
      outText = convertEntitiesToHtml(text, entities)
    }
    const body: Record<string, unknown> = {
      chat_id: CHAT_ID,
      text: outText,
    }
    if (parseMode) {
      body.parse_mode = parseMode
    } else if (entities.length > 0) {
      body.entities = entities
    }
    const resp = await fetch(`${API}/sendMessage`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(body),
    })
    await checkResponse(resp, "sendMessage")
  }

  const sendPhoto = async (filePath: string, cap: string | undefined, formatValue: Format, entities: EmojiEntity[]): Promise<void> => {
    const parseMode = parseModeFor(formatValue, cap)
    let finalCap = cap
    if (parseMode && cap && entities.length > 0) {
      finalCap = convertEntitiesToHtml(cap, entities)
    }
    const form = new FormData()
    form.append("chat_id", CHAT_ID)
    form.append("photo", Bun.file(filePath))
    if (finalCap) form.append("caption", finalCap)
    if (parseMode) {
      form.append("parse_mode", parseMode)
    } else if (entities.length > 0) {
      form.append("caption_entities", JSON.stringify(entities))
    }
    const resp = await fetch(`${API}/sendPhoto`, { method: "POST", body: form })
    await checkResponse(resp, "sendPhoto")
  }

  const sendDocument = async (filePath: string, cap: string | undefined, formatValue: Format, entities: EmojiEntity[]): Promise<void> => {
    const parseMode = parseModeFor(formatValue, cap)
    let finalCap = cap
    if (parseMode && cap && entities.length > 0) {
      finalCap = convertEntitiesToHtml(cap, entities)
    }
    const form = new FormData()
    form.append("chat_id", CHAT_ID)
    form.append("document", Bun.file(filePath))
    if (finalCap) form.append("caption", finalCap)
    if (parseMode) {
      form.append("parse_mode", parseMode)
    } else if (entities.length > 0) {
      form.append("caption_entities", JSON.stringify(entities))
    }
    const resp = await fetch(`${API}/sendDocument`, { method: "POST", body: form })
    await checkResponse(resp, "sendDocument")
  }

  const sendMediaGroup = async (mediaItems: Item[], cap: string | undefined, formatValue: Format, entities: EmojiEntity[]): Promise<void> => {
    const parseMode = parseModeFor(formatValue, cap)
    let finalCap = cap
    if (parseMode && cap && entities.length > 0) {
      finalCap = convertEntitiesToHtml(cap, entities)
    }
    const form = new FormData()
    form.append("chat_id", CHAT_ID)
    const mediaArr = mediaItems.map((item, idx) => ({
      type: item.type,
      media: `attach://file${idx}`,
      ...(idx === 0 && finalCap ? { caption: finalCap } : {}),
      ...(idx === 0 && parseMode ? { parse_mode: parseMode } : {}),
      ...(idx === 0 && !parseMode && entities.length > 0 ? { caption_entities: entities } : {}),
    }))
    form.append("media", JSON.stringify(mediaArr))
    for (const [idx, item] of mediaItems.entries()) {
      form.append(`file${idx}`, Bun.file(item.path))
    }
    const resp = await fetch(`${API}/sendMediaGroup`, { method: "POST", body: form })
    await checkResponse(resp, "sendMediaGroup")
  }

  // --- Dispatch ---
  if (items.length === 0) {
    if (!finalText) {
      console.error("Error: no message text provided")
      process.exit(1)
    }
    await sendMessage(finalText, format, finalEntities)
  } else if (items.length === 1) {
    const item = items[0]
    if (item.type === "photo") {
      await sendPhoto(item.path, finalText || undefined, format, finalEntities)
    } else {
      await sendDocument(item.path, finalText || undefined, format, finalEntities)
    }
  } else {
    await sendMediaGroup(items, finalText || undefined, format, finalEntities)
  }

  // Every send path above either succeeded or already exited(1) via
  // checkResponse, so reaching here means the send actually went through.
  console.log("OK")
}
